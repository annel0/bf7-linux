+/*
+ * BF7: zwp_idle_inhibit_manager_v1. phoc 0.24 его не объявлял, и программы,
+ * которые держат экран только им (RetroArch, mpv, SDL-игры), гасли посреди
+ * игры или фильма. Запрет действует, пока окно, попросившее его, видно:
+ * фоновая программа не должна держать экран включённым. Видимость меняется
+ * и без сигналов, на которые мы подписаны (переключение окон), поэтому, пока
+ * запреты есть, раз в 5 с перепроверяем.
+ */
+typedef struct {
+  PhocDesktop *desktop;
+  struct wlr_idle_inhibitor_v1 *wlr_inhibitor;
+  struct wl_listener destroy;
+  struct wl_list link;
+} PhocIdleInhibitor;
+
+static gboolean
+idle_inhibitor_is_active (PhocIdleInhibitor *inhibitor)
+{
+  struct wlr_surface *root = wlr_surface_get_root_surface (inhibitor->wlr_inhibitor->surface);
+  PhocView *view = phoc_view_from_wlr_surface (root);
+
+  if (view)
+    return phoc_desktop_view_is_visible (inhibitor->desktop, view);
+
+  /* Не окно (например, слой оболочки): пока у поверхности есть кадр. */
+  return wlr_surface_has_buffer (root);
+}
+
+static gboolean idle_inhibit_check (gpointer data);
+
+static void
+idle_inhibit_update (PhocDesktop *self)
+{
+  PhocIdleInhibitor *inhibitor;
+  gboolean inhibited = FALSE;
+
+  wl_list_for_each (inhibitor, &self->idle_inhibitors, link) {
+    if (idle_inhibitor_is_active (inhibitor)) {
+      inhibited = TRUE;
+      break;
+    }
+  }
+
+  if (inhibited != self->idle_inhibited) {
+    self->idle_inhibited = inhibited;
+    wlr_idle_set_enabled (self->idle, NULL, !inhibited);
+    g_message ("Idle %s", inhibited ? "inhibited" : "no longer inhibited");
+  }
+
+  if (!wl_list_empty (&self->idle_inhibitors) && !self->idle_inhibit_check_id)
+    self->idle_inhibit_check_id = g_timeout_add_seconds (5, idle_inhibit_check, self);
+}
+
+static gboolean
+idle_inhibit_check (gpointer data)
+{
+  PhocDesktop *self = PHOC_DESKTOP (data);
+
+  if (wl_list_empty (&self->idle_inhibitors)) {
+    self->idle_inhibit_check_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+  idle_inhibit_update (self);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+handle_idle_inhibitor_destroy (struct wl_listener *listener, void *data)
+{
+  PhocIdleInhibitor *inhibitor = wl_container_of (listener, inhibitor, destroy);
+  PhocDesktop *self = inhibitor->desktop;
+
+  wl_list_remove (&inhibitor->link);
+  wl_list_remove (&inhibitor->destroy.link);
+  g_free (inhibitor);
+  idle_inhibit_update (self);
+}
+
+static void
+handle_idle_inhibitor_new (struct wl_listener *listener, void *data)
+{
+  PhocDesktop *self = wl_container_of (listener, self, idle_inhibit_new);
+  struct wlr_idle_inhibitor_v1 *wlr_inhibitor = data;
+  PhocIdleInhibitor *inhibitor = g_new0 (PhocIdleInhibitor, 1);
+
+  inhibitor->desktop = self;
+  inhibitor->wlr_inhibitor = wlr_inhibitor;
+  inhibitor->destroy.notify = handle_idle_inhibitor_destroy;
+  wl_signal_add (&wlr_inhibitor->events.destroy, &inhibitor->destroy);
+  wl_list_insert (&self->idle_inhibitors, &inhibitor->link);
+  idle_inhibit_update (self);
+}
+
