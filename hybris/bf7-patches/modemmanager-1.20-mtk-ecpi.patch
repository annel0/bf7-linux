+/* BF7: MTK has no +CLCC; the real progress of an outgoing call comes in
+ * +ECPI: <id>,<type>,... (type 2 = alerting, the remote party rings; type 6 =
+ * connected). Without this the call went ACTIVE right after the OK to ATD,
+ * before the first ring: calls apps showed a running call and a voice
+ * greeting was played into the ringback. Only outgoing calls in
+ * DIALING/RINGING_OUT are touched; incoming ones are driven by ATA as before.
+ * The regex leaves the trailing CRLF in place (lookahead): +CIEV often comes
+ * right after +ECPI and its own handler needs that CRLF as its prefix, else
+ * it lands in the ATD response and the call start fails. */
+typedef struct {
+    MMCallState state;
+    guint       index;
+    gboolean    done;
+} Bf7EcpiContext;
+
+static void
+bf7_ecpi_foreach (MMBaseCall     *call,
+                  Bf7EcpiContext *ctx)
+{
+    MMCallState current;
+
+    if (ctx->done || mm_base_call_get_direction (call) != MM_CALL_DIRECTION_OUTGOING)
+        return;
+    current = mm_base_call_get_state (call);
+    if (current != MM_CALL_STATE_DIALING && current != MM_CALL_STATE_RINGING_OUT)
+        return;
+    ctx->done = TRUE;
+    if (ctx->index && !mm_base_call_get_index (call))
+        mm_base_call_set_index (call, ctx->index);
+    if (current != ctx->state)
+        mm_base_call_change_state (call, ctx->state,
+                                   ctx->state == MM_CALL_STATE_ACTIVE ?
+                                   MM_CALL_STATE_REASON_ACCEPTED :
+                                   MM_CALL_STATE_REASON_OUTGOING_STARTED);
+}
+
+static void
+bf7_ecpi_received (MMPortSerialAt   *port,
+                   GMatchInfo       *info,
+                   MMBroadbandModem *self)
+{
+    g_autoptr(MMCallList) list = NULL;
+    Bf7EcpiContext        ctx = { 0 };
+    guint                 id = 0;
+    guint                 type = 0;
+
+    if (!mm_get_uint_from_match_info (info, 1, &id) ||
+        !mm_get_uint_from_match_info (info, 2, &type))
+        return;
+    if (type == 2)
+        ctx.state = MM_CALL_STATE_RINGING_OUT;
+    else if (type == 6)
+        ctx.state = MM_CALL_STATE_ACTIVE;
+    else
+        return;
+    ctx.index = id;
+
+    g_object_get (self, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+    if (!list)
+        return;
+    mm_call_list_foreach (list, (MMCallListForeachFunc) bf7_ecpi_foreach, &ctx);
+    mm_obj_dbg (self, "+ECPI %u,%u: %s", id, type,
+                ctx.done ? "outgoing call updated" : "no outgoing call to update");
+}
