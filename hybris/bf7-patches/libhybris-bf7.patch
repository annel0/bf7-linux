+			EGLClientBuffer buffer, const EGLAttrib *attrib_list)
+{
+	EGLint ints[65];
+	unsigned n = 0;
+
+	if (attrib_list) {
+		while (attrib_list[n] != EGL_NONE && n + 2 < sizeof(ints) / sizeof(ints[0])) {
+			ints[n] = (EGLint) attrib_list[n];
+			ints[n + 1] = (EGLint) attrib_list[n + 1];
+			n += 2;
+		}
+	}
+	ints[n] = EGL_NONE;
+
+	return _my_eglCreateImageKHR(dpy, ctx, target, buffer,
+				     attrib_list ? ints : NULL);
+}
+
+EGLBoolean eglDestroyImage(EGLDisplay dpy, EGLImage image)
+{
+	return _my_eglDestroyImageKHR(dpy, image);
