+++ b/hybris/egl/platforms/x11/build.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Сборка платформы EGL x11 вручную: добавлена вне autotools-дерева,
+# как и mtkfb.
+set -e
+SRC=${SRC:-/root/hybris/libhybris/hybris}
+AH=${AH:-/root/hybris/android-headers}
+OUT=${OUT:-/usr/local/lib/libhybris/eglplatform_x11.so}
+
+g++ -O2 -fPIC -shared -o "$OUT" \
+	eglplatform_x11.cpp x11_window.cpp \
+	-I"$SRC/include" -I"$SRC/common" -I"$SRC/platforms/common" \
+	-I"$SRC/egl" -I"$SRC/egl/platforms/common" -I"$AH" \
+	-include "${COMPAT:-/root/hybris/android-compat.h}" \
+	-DANDROID_VERSION_MAJOR=12 -DANDROID_VERSION_MINOR=0 -DANDROID_VERSION_PATCH=0 \
+	$(pkg-config --cflags xcb xcb-dri3 xcb-present x11-xcb) \
+	-Wall -Wno-unused-parameter \
+	-L/usr/local/lib \
+	-lhybris-platformcommon -lhybris-eglplatformcommon -lgralloc -lhybris-common -lsync \
+	$(pkg-config --libs xcb xcb-dri3 xcb-present x11-xcb) \
+	-Wl,-rpath,/usr/local/lib
+echo "собрано: $OUT"
diff --git a/hybris/egl/platforms/x11/eglplatform_x11.cpp b/hybris/egl/platforms/x11/eglplatform_x11.cpp
new file mode 100644
index 0000000..222b89d
--- /dev/null
+++ b/hybris/egl/platforms/x11/eglplatform_x11.cpp
@@ -0,0 +1,205 @@
+/*
+ * Платформа EGL «x11» для BF7: окна X11 получают аппаратный GL.
+ *
+ * Что это даёт. Рабочий стол у нас — Xfce поверх Xwayland, и все его
+ * программы до сих пор сидели на программной Mesa: платформы X11 у libhybris
+ * нет, а драйвер PowerVR умеет только буферы gralloc. Здесь недостающее звено
+ * и появляется. Показ идёт через DRI3 и Present — см. x11_window.h.
+ *
+ * Про подключение к серверу. Запросы DRI3 и Present мы шлём **по своему**
+ * подключению, даже когда приложение дало указатель на своё. Причина в том,
+ * что в связке Xlib и xcb очередью событий по умолчанию владеет Xlib: наши
+ * ответы она забирает себе, и xcb_get_geometry_reply возвращает пустоту —
+ * окно выглядит несуществующим, а буферы получаются размером 1x1.
+ *
+ * Идентификаторы окон у сервера общие для всех подключений, так что рисовать
+ * в чужое окно со своего подключения можно. Указатель приложения всё же
+ * запоминаем — но ровно для одного: вытолкнуть буфер его Xlib, иначе окно
+ * ещё не доехало до сервера, когда мы к нему обращаемся.
+ */
+#include "x11_window.h"
+
+#include <ws.h>
+
+/* Заголовок без своей обёртки, а символы в библиотеке — с привязкой C. */
+extern "C" {
+#include <eglplatformcommon.h>
+}
+
+#include <hybris/gralloc/gralloc.h>
+
+#include <X11/Xlib-xcb.h>
+#include <xcb/xcb.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct X11Display {
+	struct _EGLDisplay	base;
+	xcb_connection_t	*conn;
+	Display			*xdpy;	/* подключение приложения, если дали */
+	bool			owns_connection;
+};
+
+/*
+ * Настоящий номер визуала X для конфигурации EGL.
+ *
+ * Программы (mpv, SDL, Qt) спрашивают у EGL_NATIVE_VISUAL_ID номер визуала и
+ * ищут его у сервера X, чтобы создать окно с подходящей раскладкой пикселей.
+ * Драйвер PowerVR про X ничего не знает и отдаёт свои внутренние значения —
+ * поиск не находит ничего, и всё кончается «Getting X visual failed!».
+ * Поэтому номер подставляем мы: обычный TrueColor нужной глубины.
+ *
+ * Достаётся эта функция через eglGetProcAddress по особому имени — так
+ * обходимся без правки общего интерфейса ws_module, которым пользуются и
+ * другие платформы.
+ */
+static xcb_connection_t *bf7_x11_conn;
+
+extern "C" uint32_t bf7_x11_visual_id(int want_alpha)
+{
+	if (!bf7_x11_conn)
+		return 0;
+
+	const xcb_setup_t *setup = xcb_get_setup(bf7_x11_conn);
+	xcb_screen_iterator_t si = xcb_setup_roots_iterator(setup);
+
+	if (!si.rem)
+		return 0;
+
+	xcb_screen_t *screen = si.data;
+	unsigned want_depth = want_alpha ? 32 : 24;
+	uint32_t fallback = screen->root_visual;
+
+	for (xcb_depth_iterator_t di = xcb_screen_allowed_depths_iterator(screen);
+	     di.rem; xcb_depth_next(&di)) {
+		if (di.data->depth != want_depth)
+			continue;
+		for (xcb_visualtype_iterator_t vi =
+			     xcb_depth_visuals_iterator(di.data);
+		     vi.rem; xcb_visualtype_next(&vi)) {
+			if (vi.data->_class == XCB_VISUAL_CLASS_TRUE_COLOR)
+				return vi.data->visual_id;
+		}
+	}
+	/*
+	 * Глубины с прозрачностью может не быть вовсе. Отдать корневой визуал
+	 * честнее, чем ноль: окно получится без альфы, но получится.
+	 */
+	return fallback;
+}
+
+extern "C" void x11ws_init_module(struct ws_egl_interface *egl_iface)
+{
+	eglplatformcommon_init(egl_iface);
+	hybris_gralloc_initialize(0);
+}
+
+extern "C" struct _EGLDisplay *x11ws_GetDisplay(EGLNativeDisplayType native)
+{
+	X11Display *dpy = new X11Display;
+
+	memset(dpy, 0, sizeof *dpy);
+
+	if (native && native != EGL_DEFAULT_DISPLAY)
+		dpy->xdpy = (Display *)native;
+
+	dpy->conn = xcb_connect(NULL, NULL);
+	dpy->owns_connection = true;
+	bf7_x11_conn = dpy->conn;
+	if (!dpy->conn || xcb_connection_has_error(dpy->conn)) {
+		/*
+		 * Молча возвращать пустой дисплей нельзя: приложение решит,
+		 * что EGL сломан, и уйдёт на программную отрисовку без
+		 * единого слова в журнале.
+		 */
+		fprintf(stderr, "x11ws: нет подключения к серверу X "
+			"(DISPLAY=%s)\n", getenv("DISPLAY") ?: "не задан");
+		if (dpy->conn && dpy->owns_connection)
+			xcb_disconnect(dpy->conn);
+		delete dpy;
+		return NULL;
+	}
+	return &dpy->base;
+}
+
+extern "C" void x11ws_releaseDisplay(struct _EGLDisplay *display)
+{
+	X11Display *dpy = (X11Display *)display;
+
+	if (!dpy)
+		return;
+	if (dpy->conn && dpy->owns_connection)
+		xcb_disconnect(dpy->conn);
+	delete dpy;
+}
+
+extern "C" EGLNativeWindowType x11ws_CreateWindow(EGLNativeWindowType win,
+						  struct _EGLDisplay *display)
+{
+	X11Display *dpy = (X11Display *)display;
+
+	if (!dpy || !dpy->conn) {
+		fprintf(stderr, "x11ws: окно просят без дисплея\n");
+		return 0;
+	}
+
+	X11NativeWindow *window =
+		new X11NativeWindow(dpy->conn, dpy->xdpy,
+				    (xcb_window_t)(uintptr_t)win);
+
+	return (EGLNativeWindowType) static_cast<struct ANativeWindow *>(window);
+}
+
+extern "C" void x11ws_DestroyWindow(EGLNativeWindowType win)
+{
+	X11NativeWindow *window =
+		static_cast<X11NativeWindow *>((struct ANativeWindow *)win);
+
+	window->common.decRef(&window->common);
+}
+
+extern "C" __eglMustCastToProperFunctionPointerType
+x11ws_eglGetProcAddress(const char *procname)
+{
+	/* Наш внутренний ход: так egl.c добирается до визуала, не зная про X. */
+	if (procname && !strcmp(procname, "bf7_x11_visual_id"))
+		return (__eglMustCastToProperFunctionPointerType)bf7_x11_visual_id;
+
+	return eglplatformcommon_eglGetProcAddress(procname);
+}
+
+extern "C" void x11ws_passthroughImageKHR(EGLContext *ctx, EGLenum *target,
+					  EGLClientBuffer *buffer,
+					  const EGLint **attrib_list)
+{
+	eglplatformcommon_passthroughImageKHR(ctx, target, buffer, attrib_list);
+}
+
+extern "C" void x11ws_setSwapInterval(EGLDisplay dpy, EGLNativeWindowType win,
+				      EGLint interval)
+{
+	(void)dpy;
+
+	X11NativeWindow *window =
+		static_cast<X11NativeWindow *>((struct ANativeWindow *)win);
+
+	window->setSwapInterval(interval);
+}
+
+struct ws_module ws_module_info = {
+	x11ws_init_module,
+	x11ws_GetDisplay,
+	NULL,				/* Terminate */
+	x11ws_CreateWindow,
+	x11ws_DestroyWindow,
+	x11ws_eglGetProcAddress,
+	x11ws_passthroughImageKHR,
+	eglplatformcommon_eglQueryString,
+	NULL,				/* prepareSwap */
+	NULL,				/* finishSwap */
+	x11ws_setSwapInterval,
+	x11ws_releaseDisplay,
+	NULL,				/* eglInitialized */
+};
diff --git a/hybris/egl/platforms/x11/x11_window.cpp b/hybris/egl/platforms/x11/x11_window.cpp
new file mode 100644
index 0000000..142e872
--- /dev/null
+++ b/hybris/egl/platforms/x11/x11_window.cpp
@@ -0,0 +1,555 @@
+/*
+ * Окно ANativeWindow поверх окна X11. Описание замысла — в x11_window.h.
+ */
+#include "x11_window.h"
+
+#include <cutils/native_handle.h>
+#include <hybris/gralloc/gralloc.h>
+
+#include <sync/sync.h>
+
+#include <xcb/dri3.h>
+#include <xcb/xcb.h>
+#include <xcb/present.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define X11_BUFFER_COUNT	3
+
+static int x11_trace_on(void)
+{
+	static int on = -1;
+
+	if (on < 0)
+		on = getenv("BF7_X11_TRACE") ? 1 : 0;
+	return on;
+}
+
+#define X11T(...) do { if (x11_trace_on()) { \
+	fprintf(stderr, "x11ws: "); fprintf(stderr, __VA_ARGS__); \
+	fprintf(stderr, "\n"); } } while (0)
+
+#define X11E(...) do { \
+	fprintf(stderr, "x11ws: "); fprintf(stderr, __VA_ARGS__); \
+	fprintf(stderr, "\n"); } while (0)
+
+/* ------------------------------------------------------------------ */
+
+X11NativeWindowBuffer::X11NativeWindowBuffer(unsigned int width,
+					     unsigned int height,
+					     unsigned int format,
+					     uint64_t usage)
+{
+	ANativeWindowBuffer::width  = width;
+	ANativeWindowBuffer::height = height;
+	ANativeWindowBuffer::format = format;
+	ANativeWindowBuffer::usage  = usage;
+	busy = 0;
+	dmaFd = -1;
+	pixmap = 0;
+	serial = 0;
+	status = hybris_gralloc_allocate(width, height, format, usage,
+					 (buffer_handle_t *)&handle,
+					 (uint32_t *)&stride);
+}
+
+X11NativeWindowBuffer::~X11NativeWindowBuffer()
+{
+	if (handle)
+		hybris_gralloc_release(handle, 1);
+}
+
+/* ------------------------------------------------------------------ */
+
+X11NativeWindow::X11NativeWindow(xcb_connection_t *conn, Display *xdpy,
+				 xcb_window_t win)
+{
+	m_conn = conn;
+	m_xdpy = xdpy;
+	m_win = win;
+	m_special = NULL;
+	m_eid = 0;
+	m_present = false;
+
+	/*
+	 * Никаких SW_*: драйвер PowerVR отказывается делать буфер с доступом
+	 * для процессора целью отрисовки. Читать этот буфер нам и не нужно —
+	 * он уходит серверу дескриптором.
+	 */
+	m_usage = GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE;
+	/*
+	 * Порядок байтов задаёт X, а не драйвер. Визуал TrueColor глубины 24
+	 * на этой машине хранит пиксель как B, G, R, X — это и есть BGRA в
+	 * андроидных именах. Если отдать RGBA, картинка приезжает с
+	 * переставленными красным и синим.
+	 */
+	m_bufFormat = HAL_PIXEL_FORMAT_BGRA_8888;
+	m_bufferCount = X11_BUFFER_COUNT;
+	m_swapInterval = 1;
+	m_width = 0;
+	m_height = 0;
+	m_depth = 24;
+	m_bpp = 32;
+	m_serial = 0;
+
+	/*
+	 * Размеры окна спрашиваем не сразу. Приложение только что создало
+	 * окно своей Xlib, а та складывает запросы в буфер и отправляет их
+	 * когда сочтёт нужным: на сервере окна может ещё не быть, и тогда
+	 * наши запросы к нему отлетают с BadWindow. Выталкиваем буфер и, если
+	 * надо, ждём — считанные миллисекунды.
+	 */
+	{
+		int tries;
+
+		for (tries = 0; tries < 50; tries++) {
+			flushClient();
+			if (refreshGeometry())
+				break;
+			usleep(2000);
+		}
+		if (tries >= 50) {
+			X11E("окно 0x%x не отвечает на запрос размеров "
+			     "(подключение %s)", win,
+			     m_xdpy ? "приложения" : "своё");
+			m_width = 1;
+			m_height = 1;
+		}
+	}
+
+	/*
+	 * Подписка на события Present. Нас интересует idle-notify: по нему
+	 * видно, что сервер отпустил буфер и его можно рисовать заново.
+	 */
+	const xcb_query_extension_reply_t *ext =
+		xcb_get_extension_data(m_conn, &xcb_present_id);
+
+	if (ext && ext->present) {
+		xcb_present_query_version_cookie_t vc =
+			xcb_present_query_version(m_conn, 1, 2);
+		xcb_present_query_version_reply_t *vr =
+			xcb_present_query_version_reply(m_conn, vc, NULL);
+
+		if (vr) {
+			free(vr);
+			m_eid = xcb_generate_id(m_conn);
+			m_special = xcb_register_for_special_xge(m_conn,
+								 &xcb_present_id,
+								 m_eid, NULL);
+			xcb_present_select_input(m_conn, m_eid, m_win,
+				XCB_PRESENT_EVENT_MASK_IDLE_NOTIFY |
+				XCB_PRESENT_EVENT_MASK_COMPLETE_NOTIFY);
+			m_present = true;
+		}
+	}
+	if (!m_present)
+		X11E("сервер не поддерживает Present — показывать нечем");
+
+	X11T("окно 0x%x: %ux%u, глубина %u, подключение %s", win, m_width,
+	     m_height, m_depth, m_xdpy ? "приложения" : "своё");
+}
+
+X11NativeWindow::~X11NativeWindow()
+{
+	destroyBuffers();
+	if (m_special)
+		xcb_unregister_for_special_event(m_conn, m_special);
+}
+
+/* ------------------------------------------------------------------ */
+
+/*
+ * Вытолкнуть буфер Xlib приложения.
+ *
+ * Мы пользуемся тем же подключением, что и приложение, но через xcb. Запросы
+ * Xlib до отправки лежат в её собственном буфере, и xcb о них не знает.
+ * Без этого наши обращения обгоняют создание окна.
+ */
+void X11NativeWindow::flushClient()
+{
+	if (m_xdpy)
+		XFlush(m_xdpy);
+}
+
+bool X11NativeWindow::refreshGeometry()
+{
+	/*
+	 * Если приложение дало нам своё подключение, спрашиваем размеры именно
+	 * через него, средствами Xlib. Она сама вытолкнет накопленные запросы
+	 * и увидит окно, которое только что создала, — по своему подключению
+	 * мы в этот момент получаем «нет такого объекта» (BadDrawable).
+	 * Обращение идёт из того же потока, который зовёт EGL, так что
+	 * блокировка Display не нужна.
+	 */
+	if (m_xdpy) {
+		Window root;
+		int x, y;
+		unsigned w, h, border, depth;
+
+		if (XGetGeometry(m_xdpy, m_win, &root, &x, &y, &w, &h,
+				 &border, &depth) && w && h) {
+			bool changed = (m_width != w || m_height != h);
+
+			m_width = w;
+			m_height = h;
+			m_depth = depth;
+			m_bpp = depth > 16 ? 32 : 16;
+			return changed || m_width != 0;
+		}
+		return false;
+	}
+
+	xcb_generic_error_t *err = NULL;
+	xcb_get_geometry_cookie_t c = xcb_get_geometry(m_conn, m_win);
+	xcb_get_geometry_reply_t *r = xcb_get_geometry_reply(m_conn, c, &err);
+
+	if (!r) {
+		X11T("размеры окна 0x%x: %s", m_win,
+		     err ? "сервер отказал" : "ответа нет");
+		if (err) {
+			X11T("  код ошибки %u, запрос %u", err->error_code,
+			     err->major_code);
+			free(err);
+		}
+		return false;
+	}
+	if (!r->width || !r->height) {
+		free(r);
+		return false;
+	}
+
+	bool changed = (m_width != r->width || m_height != r->height);
+
+	m_width = r->width;
+	m_height = r->height;
+	m_depth = r->depth;
+	m_bpp = m_depth > 24 ? 32 : (m_depth > 16 ? 32 : 16);
+	free(r);
+	return changed || m_width != 0;
+}
+
+/*
+ * Дескриптор dma-buf лежит в native_handle. Их там может быть несколько
+ * (у MediaTek рядом идут служебные), поэтому берём первый, у которого размер
+ * не меньше нужного под кадр: остальные заведомо мельче.
+ */
+int X11NativeWindow::findDmaFd(X11NativeWindowBuffer *b)
+{
+	const native_handle_t *h = (const native_handle_t *)b->handle;
+
+	if (b->dmaFd >= 0)
+		return b->dmaFd;
+	if (!h)
+		return -1;
+
+	size_t need = (size_t)b->stride * b->height * 4;
+
+	for (int i = 0; i < h->numFds; i++) {
+		off_t size = lseek(h->data[i], 0, SEEK_END);
+
+		if (size > 0 && (size_t)size >= need) {
+			b->dmaFd = h->data[i];
+			return b->dmaFd;
+		}
+	}
+	/* Не нашли по размеру — берём первый, это лучше, чем ничего. */
+	if (h->numFds > 0) {
+		b->dmaFd = h->data[0];
+		return b->dmaFd;
+	}
+	return -1;
+}
+
+/*
+ * Отдать буфер серверу как Pixmap.
+ *
+ * DRI3 забирает дескриптор себе, поэтому отдаём копию: сам буфер нам ещё
+ * нужен, и закрывать его дескриптор нельзя.
+ */
+int X11NativeWindow::makePixmap(X11NativeWindowBuffer *b)
+{
+	if (b->pixmap)
+		return 0;
+
+	int fd = findDmaFd(b);
+
+	if (fd < 0) {
+		X11E("у буфера нет дескриптора dma-buf");
+		return -1;
+	}
+
+	int dup_fd = dup(fd);
+
+	if (dup_fd < 0) {
+		X11E("dup дескриптора: %s", strerror(errno));
+		return -1;
+	}
+
+	uint32_t stride_bytes = (uint32_t)b->stride * 4;
+	uint32_t size = stride_bytes * b->height;
+
+	b->pixmap = xcb_generate_id(m_conn);
+	xcb_dri3_pixmap_from_buffer(m_conn, b->pixmap, m_win, size,
+				    b->width, b->height, stride_bytes,
+				    (uint8_t)m_depth, (uint8_t)m_bpp, dup_fd);
+	X11T("буфер %ux%u шаг %u -> pixmap 0x%x", b->width, b->height,
+	     stride_bytes, b->pixmap);
+	return 0;
+}
+
+/*
+ * Разобрать пришедшие события Present.
+ *
+ * blocking=true означает «нам некуда рисовать, подожди освобождения».
+ */
+void X11NativeWindow::readEvents(bool blocking)
+{
+	if (!m_special)
+		return;
+
+	for (;;) {
+		xcb_generic_event_t *ev;
+
+		if (blocking)
+			ev = xcb_wait_for_special_event(m_conn, m_special);
+		else
+			ev = xcb_poll_for_special_event(m_conn, m_special);
+		if (!ev)
+			return;
+
+		xcb_present_generic_event_t *pe =
+			(xcb_present_generic_event_t *)ev;
+
+		if (pe->evtype == XCB_PRESENT_EVENT_IDLE_NOTIFY) {
+			xcb_present_idle_notify_event_t *ie =
+				(xcb_present_idle_notify_event_t *)ev;
+
+			for (std::list<X11NativeWindowBuffer *>::iterator it =
+				     m_bufList.begin();
+			     it != m_bufList.end(); ++it) {
+				if ((*it)->pixmap == ie->pixmap) {
+					(*it)->busy = 0;
+					blocking = false;
+					break;
+				}
+			}
+		}
+		free(ev);
+		if (!blocking)
+			return;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+
+int X11NativeWindow::dequeueBuffer(BaseNativeWindowBuffer **buffer, int *fenceFd)
+{
+	/*
+	 * Размер окна мог поменяться. Старые буферы тогда не годятся: сервер
+	 * растянул бы их или обрезал. Проще выбросить и завести заново.
+	 */
+	unsigned int old_w = m_width, old_h = m_height;
+
+	flushClient();
+	refreshGeometry();
+	if (m_width != old_w || m_height != old_h) {
+		X11T("окно стало %ux%u, буферы заново", m_width, m_height);
+		destroyBuffers();
+	}
+
+	readEvents(false);
+
+	X11NativeWindowBuffer *found = NULL;
+
+	for (std::list<X11NativeWindowBuffer *>::iterator it = m_bufList.begin();
+	     it != m_bufList.end(); ++it) {
+		if (!(*it)->busy) {
+			found = *it;
+			break;
+		}
+	}
+
+	if (!found && (int)m_bufList.size() < m_bufferCount) {
+		X11NativeWindowBuffer *b =
+			new X11NativeWindowBuffer(m_width, m_height,
+						  m_bufFormat, m_usage);
+
+		if (b->status != 0 || !b->handle) {
+			X11E("gralloc не дал буфер %ux%u формата 0x%x: %d",
+			     m_width, m_height, m_bufFormat, b->status);
+			delete b;
+			return -ENOMEM;
+		}
+		b->common.incRef(&b->common);
+		m_bufList.push_back(b);
+		found = b;
+	}
+
+	/* Все заняты — ждём, пока сервер отпустит хоть один. */
+	if (!found) {
+		readEvents(true);
+		for (std::list<X11NativeWindowBuffer *>::iterator it =
+			     m_bufList.begin();
+		     it != m_bufList.end(); ++it) {
+			if (!(*it)->busy) {
+				found = *it;
+				break;
+			}
+		}
+	}
+	if (!found)
+		return -EBUSY;
+
+	*buffer = found;
+	if (fenceFd)
+		*fenceFd = -1;
+	return 0;
+}
+
+int X11NativeWindow::queueBuffer(BaseNativeWindowBuffer *buffer, int fenceFd)
+{
+	X11NativeWindowBuffer *b = static_cast<X11NativeWindowBuffer *>(buffer);
+
+	/*
+	 * Дождаться GPU, прежде чем показывать.
+	 *
+	 * Драйвер отдаёт вместе с буфером метку готовности: пока она не
+	 * сработала, отрисовка в буфер ещё идёт. Если показать его сразу,
+	 * сервер возьмёт наполовину старое содержимое — на экране это
+	 * выглядит как возврат к предыдущему кадру и дрожание.
+	 *
+	 * Отдать метку серверу нельзя: Present умеет ждать только свои
+	 * объекты синхронизации X, а у нас метка ядра. Поэтому ждём сами.
+	 * Ожидание короткое — GPU к этому времени обычно уже закончил.
+	 */
+	if (fenceFd >= 0) {
+		/* BF7_X11_NO_FENCE=1 возвращает прежнее поведение — для опытов. */
+		static const int skip = getenv("BF7_X11_NO_FENCE") ? 1 : 0;
+
+		if (!skip && sync_wait(fenceFd, 1000) < 0)
+			X11E("GPU не отчитался о готовности буфера: %s",
+			     strerror(errno));
+		close(fenceFd);
+	}
+
+	if (!m_present)
+		return 0;
+	if (makePixmap(b) != 0)
+		return -EINVAL;
+
+	/*
+	 * options=0 — показывать по вертикальной синхронизации. При нулевом
+	 * интервале обмена просим ASYNC: кадр уходит немедленно.
+	 */
+	uint32_t options = m_swapInterval == 0 ?
+		XCB_PRESENT_OPTION_ASYNC : XCB_PRESENT_OPTION_NONE;
+
+	b->serial = ++m_serial;
+	b->busy = 1;
+	xcb_present_pixmap(m_conn, m_win, b->pixmap, b->serial,
+			   0,		/* valid-area: всё окно */
+			   0,		/* update-area: всё окно */
+			   0, 0,	/* смещение */
+			   XCB_NONE,	/* target crtc */
+			   XCB_NONE,	/* wait fence */
+			   XCB_NONE,	/* idle fence */
+			   options,
+			   0, 0, 0,	/* target msc, divisor, remainder */
+			   0, NULL);	/* уведомления */
+	xcb_flush(m_conn);
+	return 0;
+}
+
+int X11NativeWindow::cancelBuffer(BaseNativeWindowBuffer *buffer, int fenceFd)
+{
+	X11NativeWindowBuffer *b = static_cast<X11NativeWindowBuffer *>(buffer);
+
+	if (fenceFd >= 0)
+		close(fenceFd);
+	b->busy = 0;
+	return 0;
+}
+
+int X11NativeWindow::lockBuffer(BaseNativeWindowBuffer *buffer)
+{
+	(void)buffer;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+
+void X11NativeWindow::destroyBuffers()
+{
+	for (std::list<X11NativeWindowBuffer *>::iterator it = m_bufList.begin();
+	     it != m_bufList.end(); ++it) {
+		X11NativeWindowBuffer *b = *it;
+
+		if (b->pixmap)
+			xcb_free_pixmap(m_conn, b->pixmap);
+		b->common.decRef(&b->common);
+	}
+	m_bufList.clear();
+	xcb_flush(m_conn);
+}
+
+int X11NativeWindow::setSwapInterval(int interval)
+{
+	m_swapInterval = interval;
+	return 0;
+}
+
+unsigned int X11NativeWindow::type() const	{ return NATIVE_WINDOW_SURFACE; }
+unsigned int X11NativeWindow::width() const	{ return m_width; }
+unsigned int X11NativeWindow::height() const	{ return m_height; }
+unsigned int X11NativeWindow::format() const	{ return m_bufFormat; }
+unsigned int X11NativeWindow::defaultWidth() const	{ return m_width; }
+unsigned int X11NativeWindow::defaultHeight() const	{ return m_height; }
+unsigned int X11NativeWindow::queueLength() const	{ return 1; }
+unsigned int X11NativeWindow::transformHint() const	{ return 0; }
+unsigned int X11NativeWindow::getUsage() const		{ return m_usage; }
+
+int X11NativeWindow::setUsage(uint64_t usage)
+{
+	uint64_t want = usage | GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE;
+
+	if (want != m_usage) {
+		m_usage = want;
+		destroyBuffers();
+	}
+	return 0;
+}
+
+/*
+ * Формат буфера выбираем мы, а не драйвер: он исходит из конфигурации EGL и
+ * про раскладку пикселей у сервера X ничего не знает. Просьбу принимаем, но
+ * следуем визуалу окна — иначе красный и синий меняются местами.
+ */
+int X11NativeWindow::setBuffersFormat(int format)
+{
+	(void)format;
+	return 0;
+}
+
+/*
+ * Размер буфера задаёт окно, а не клиент: показывать кадр другого размера
+ * всё равно некуда. Запрос принимаем, но следуем за геометрией окна.
+ */
+int X11NativeWindow::setBuffersDimensions(int width, int height)
+{
+	(void)width;
+	(void)height;
+	return 0;
+}
+
+int X11NativeWindow::setBufferCount(int cnt)
+{
+	if (cnt >= 2 && cnt != m_bufferCount) {
+		m_bufferCount = cnt;
+		destroyBuffers();
+	}
+	return 0;
+}
diff --git a/hybris/egl/platforms/x11/x11_window.h b/hybris/egl/platforms/x11/x11_window.h
new file mode 100644
index 0000000..25d9458
--- /dev/null
+++ b/hybris/egl/platforms/x11/x11_window.h
@@ -0,0 +1,102 @@
+/*
+ * Окно ANativeWindow поверх окна X11 для BF7.
+ *
+ * Зачем. Драйвер PowerVR умеет рисовать только в буфер gralloc, а рабочий
+ * стол у нас — обычный X (Xfce поверх Xwayland). Штатного пути между ними
+ * нет: платформы X11 у libhybris не существует, поэтому всякая программа X11
+ * скатывается на программную Mesa. Здесь этот путь и строится.
+ *
+ * Как. Буфер выделяется обычным gralloc, из него достаётся дескриптор
+ * dma-buf, тот отдаётся серверу X по DRI3 как Pixmap, и показывается в окне
+ * расширением Present. Копирования нет ни одного: сервер (а у нас это
+ * Xwayland с glamor поверх нашего же бэкенда GBM) берёт тот самый буфер.
+ *
+ * Про освобождение буферов. Present присылает событие idle-notify, когда
+ * буфер больше не нужен серверу. До этого переиспользовать его нельзя —
+ * иначе на экране окажется кадр, который ещё рисуется.
+ */
+#ifndef BF7_X11_WINDOW_H
+#define BF7_X11_WINDOW_H
+
+#include "eglnativewindowbase.h"
+
+#include <hardware/gralloc.h>
+#include <X11/Xlib.h>
