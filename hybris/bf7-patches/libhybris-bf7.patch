+#!/bin/sh
+# Сборка платформы EGL mtkfb вручную: она добавлена вне autotools-дерева.
+set -e
+SRC=${SRC:-/root/hybris/libhybris/hybris}
+AH=${AH:-/root/hybris/android-headers}
+OUT=${OUT:-/usr/local/lib/libhybris/eglplatform_mtkfb.so}
+
+g++ -O2 -fPIC -shared -o "$OUT" \
+	eglplatform_mtkfb.cpp mtkfb_window.cpp \
+	-I"$SRC/include" -I"$SRC/common" -I"$SRC/platforms/common" \
+	-I"$SRC/egl" -I"$SRC/egl/platforms/common" -I"$AH" -include "${COMPAT:-/root/hybris/android-compat.h}" \
+	-DANDROID_VERSION_MAJOR=12 -DANDROID_VERSION_MINOR=0 -DANDROID_VERSION_PATCH=0 \
+	-Wall -Wno-unused-parameter \
+	-L/usr/local/lib \
+	-lhybris-platformcommon -lhybris-eglplatformcommon -lgralloc -lhybris-common -lsync \
+	-Wl,-rpath,/usr/local/lib
+echo "собрано: $OUT"
