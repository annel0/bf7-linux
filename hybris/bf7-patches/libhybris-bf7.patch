+static struct bf7_blob *blob_tab[BLOB_BUCKETS];
+static pthread_mutex_t blob_mu = PTHREAD_MUTEX_INITIALIZER;
+static FILE *blob_log;
+static int blob_seed_fd = -1;
+static unsigned long blob_hits, blob_miss, blob_sets;
+
+static uint32_t blob_hash(const void *k, uint32_t n)
+{
+	const unsigned char *p = k;
+	uint32_t h = 2166136261u;
+
+	while (n--)
+		h = (h ^ *p++) * 16777619u;
+	return h;
+}
+
+static struct bf7_blob *blob_find(uint32_t h, const void *k, uint32_t kl)
+{
+	for (struct bf7_blob *b = blob_tab[h % BLOB_BUCKETS]; b; b = b->next)
+		if (b->hash == h && b->klen == kl && !memcmp(b->key, k, kl))
+			return b;
+	return NULL;
+}
+
+/* под blob_mu */
+static void blob_put(const void *k, uint32_t kl, const void *v, uint32_t vl)
+{
+	uint32_t h = blob_hash(k, kl);
+	struct bf7_blob *b = blob_find(h, k, kl);
+	unsigned char *nv = malloc(vl ? vl : 1);
+
+	if (!nv)
+		return;
+	memcpy(nv, v, vl);
+	if (b) {
+		free(b->val);
+		b->val = nv;
+		b->vlen = vl;
+		return;
+	}
+	b = calloc(1, sizeof(*b));
+	if (!b || !(b->key = malloc(kl ? kl : 1))) {
+		free(b);
+		free(nv);
+		return;
+	}
+	memcpy(b->key, k, kl);
+	b->hash = h;
+	b->klen = kl;
+	b->val = nv;
+	b->vlen = vl;
+	b->next = blob_tab[h % BLOB_BUCKETS];
+	blob_tab[h % BLOB_BUCKETS] = b;
+}
+
+static void blob_set(const void *key, EGLsizeiANDROID klen,
+		     const void *val, EGLsizeiANDROID vlen)
+{
+	uint32_t kl = (uint32_t)klen, vl = (uint32_t)vlen;
+
+	if (klen <= 0 || vlen < 0 || kl > BLOB_MAX_ITEM || vl > BLOB_MAX_ITEM)
+		return;
+	pthread_mutex_lock(&blob_mu);
+	blob_put(key, kl, val, vl);
+	blob_sets++;
+	if (blob_log) {
+		fwrite(&kl, 4, 1, blob_log);
+		fwrite(&vl, 4, 1, blob_log);
+		fwrite(key, 1, kl, blob_log);
+		fwrite(val, 1, vl, blob_log);
+		fflush(blob_log);
+	}
+	if (blob_seed_fd >= 0) {
+		size_t n = 8 + (size_t)kl + vl;
+		unsigned char *buf = malloc(n);
+		struct stat st;
+
+		if (buf) {
+			memcpy(buf, &kl, 4);
+			memcpy(buf + 4, &vl, 4);
+			memcpy(buf + 8, key, kl);
+			memcpy(buf + 8 + kl, val, vl);
+			if (flock(blob_seed_fd, LOCK_EX) == 0 &&
+			    fstat(blob_seed_fd, &st) == 0) {
+				if (st.st_size > BLOB_MAX_FILE) {
+					ftruncate(blob_seed_fd, 0);
+					st.st_size = 0;
+				}
+				/* недописанный хвост отрезаем — читатель встал бы на нём */
+				if (write(blob_seed_fd, buf, n) != (ssize_t)n)
+					ftruncate(blob_seed_fd, st.st_size);
+			}
+			flock(blob_seed_fd, LOCK_UN);
+			free(buf);
+		}
+	}
+	pthread_mutex_unlock(&blob_mu);
+}
+
+static EGLsizeiANDROID blob_get(const void *key, EGLsizeiANDROID klen,
+				void *val, EGLsizeiANDROID vsize)
+{
+	EGLsizeiANDROID ret = 0;
+	struct bf7_blob *b;
+
+	if (klen <= 0)
+		return 0;
+	pthread_mutex_lock(&blob_mu);
+	b = blob_find(blob_hash(key, (uint32_t)klen), key, (uint32_t)klen);
+	if (b) {
+		ret = b->vlen;
+		if (val && vsize >= (EGLsizeiANDROID)b->vlen)
+			memcpy(val, b->val, b->vlen);
+		blob_hits++;
+	} else {
+		blob_miss++;
+	}
+	pthread_mutex_unlock(&blob_mu);
+	return ret;
+}
+
+static void blob_report(void)
+{
+	fprintf(stderr, "[hybris] кэш шейдеров: попаданий %lu, промахов %lu, записей %lu\n",
+		blob_hits, blob_miss, blob_sets);
+}
+
+static void blob_open(void)
+{
+	char dir[512], path[600], seed[600];
+	const char *home = getenv("HOME");
+	const char *name = program_invocation_short_name;
+	struct stat st;
+	FILE *f;
+
+	if (!home || !name || !*name)
+		return;
+	snprintf(dir, sizeof(dir), "%s/.cache", home);
+	mkdir(dir, 0700);
+	snprintf(dir, sizeof(dir), "%s/.cache/bf7-egl", home);
+	mkdir(dir, 0700);
+	snprintf(path, sizeof(path), "%s/%s.blob", dir, name);
+
+	if (stat(path, &st) == 0 && st.st_size > BLOB_MAX_FILE)
+		unlink(path);
+	snprintf(seed, sizeof(seed), "%s/obshchij.blob", dir);
+	if (stat(path, &st) != 0) {
+		/* своего журнала нет — начинаем с копии общего */
+		int sfd = open(seed, O_RDONLY | O_CLOEXEC);
+
+		if (sfd >= 0) {
+			int dfd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+
+			if (dfd >= 0 && flock(sfd, LOCK_SH) == 0) {
+				char b[65536];
+				ssize_t r;
+
+				while ((r = read(sfd, b, sizeof(b))) > 0)
+					if (write(dfd, b, r) != r)
+						break;
+				flock(sfd, LOCK_UN);
+			}
+			if (dfd >= 0)
+				close(dfd);
+			close(sfd);
+		}
+	}
+	f = fopen(path, "rb");
+	if (f) {
+		uint32_t kl, vl;
+
+		while (fread(&kl, 4, 1, f) == 1 && fread(&vl, 4, 1, f) == 1) {
+			unsigned char *k, *v;
+
+			if (kl == 0 || kl > BLOB_MAX_ITEM || vl > BLOB_MAX_ITEM)
+				break;
+			k = malloc(kl);
+			v = malloc(vl ? vl : 1);
+			if (!k || !v || fread(k, 1, kl, f) != kl ||
+			    fread(v, 1, vl, f) != vl) {
+				free(k);
+				free(v);
+				break;
+			}
+			blob_put(k, kl, v, vl);
+			free(k);
+			free(v);
+		}
+		fclose(f);
+	}
+	blob_log = fopen(path, "ab");
+	blob_seed_fd = open(seed, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0600);
+}
+
+static void blob_register(EGLDisplay dpy)
+{
+	typedef void (*SetFuncs)(EGLDisplay, EGLSetBlobFuncANDROID, EGLGetBlobFuncANDROID);
+	static SetFuncs setfuncs;
+	static int opened;
+
+	if (getenv("BF7_EGL_NO_BLOB"))
+		return;
+	if (!setfuncs)
+		setfuncs = (SetFuncs)hybris_egl_lookup_ext("eglSetBlobCacheFuncsANDROID");
+	if (!setfuncs)
+		return;
+	static EGLDisplay done[8];
+	int already = 0;
+
+	pthread_mutex_lock(&blob_mu);
+	if (!opened) {
+		opened = 1;
+		blob_open();
+		if (getenv("BF7_EGL_BLOB_TRACE"))
+			atexit(blob_report);
+	}
+	/* по правилам расширения — один раз на дисплей */
+	for (unsigned i = 0; i < 8; i++) {
+		if (done[i] == dpy) {
+			already = 1;
+			break;
+		}
+		if (!done[i]) {
+			done[i] = dpy;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&blob_mu);
+	if (!already)
+		setfuncs(dpy, blob_set, blob_get);
+}
