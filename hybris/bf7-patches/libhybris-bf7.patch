+		return new _EGLDisplay;
+	return 0;
+}
+
+extern "C" void mtkfbws_releaseDisplay(_EGLDisplay *dpy)
+{
+	delete dpy;
+}
+
+extern "C" EGLNativeWindowType mtkfbws_CreateWindow(EGLNativeWindowType win,
+						    _EGLDisplay *display)
+{
+	(void)win; (void)display;
+	assert(_nativewindow == NULL);
+	_nativewindow = new MtkFbNativeWindow();
+	_nativewindow->common.incRef(&_nativewindow->common);
+	return (EGLNativeWindowType)static_cast<struct ANativeWindow *>(_nativewindow);
+}
+
+extern "C" void mtkfbws_DestroyWindow(EGLNativeWindowType win)
+{
+	assert(_nativewindow != NULL);
+	assert(static_cast<MtkFbNativeWindow *>((struct ANativeWindow *)win) == _nativewindow);
+	_nativewindow->common.decRef(&_nativewindow->common);
+	_nativewindow = NULL;
+}
+
+extern "C" __eglMustCastToProperFunctionPointerType
+mtkfbws_eglGetProcAddress(const char *procname)
+{
+	return eglplatformcommon_eglGetProcAddress(procname);
+}
+
+extern "C" void mtkfbws_passthroughImageKHR(EGLContext *ctx, EGLenum *target,
+					    EGLClientBuffer *buffer,
+					    const EGLint **attrib_list)
+{
+	eglplatformcommon_passthroughImageKHR(ctx, target, buffer, attrib_list);
+}
+
+extern "C" void mtkfbws_setSwapInterval(EGLDisplay dpy, EGLNativeWindowType win,
+					EGLint interval)
+{
+	(void)dpy;
+	MtkFbNativeWindow *window =
+		static_cast<MtkFbNativeWindow *>((struct ANativeWindow *)win);
+	window->setSwapInterval(interval);
+}
