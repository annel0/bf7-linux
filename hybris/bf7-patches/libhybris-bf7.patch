+/*
+ * Нижний слой свойств bionic.
+ *
+ * Начиная с Android 8 libbase читает свойства не через property_get, а через
+ * пару __system_property_find + __system_property_read_callback. В libhybris
+ * find был заглушкой, возвращавшей NULL, а read_callback не перехватывался
+ * вовсе, поэтому android::base::GetProperty всегда отдавала значение по
+ * умолчанию.
+ *
+ * Само по себе это тихая поломка, но HidlServiceManagement делает
+ *
+ *	while (GetProperty("hwservicemanager.ready", "") != "true")
+ *		WaitForProperty("hwservicemanager.ready", "true", 1s);
+ *
+ * а __system_property_wait возвращался мгновенно — цикл становился плотным и
+ * съедал ядро целиком. На BF7 это проявилось, как только появился
+ * /dev/hwbinder: до него блоб пропускал путь HIDL и поломки не было видно.
+ *
+ * Здесь заводится таблица описателей: find ищет значение обычным путём и
+ * возвращает на него устойчивый указатель, read_callback отдаёт имя и
+ * значение, а wait честно выжидает свой таймаут, чтобы даже для неизвестного
+ * свойства получался опрос раз в секунду, а не кручение.
+ */
+struct hybris_prop_handle {
+	char name[PROP_NAME_MAX];
+	char value[PROP_VALUE_MAX];
+	uint32_t serial;
+};
+
+#define HYBRIS_MAX_PROP_HANDLES 256
+
+static struct hybris_prop_handle prop_handles[HYBRIS_MAX_PROP_HANDLES];
+static int prop_handle_count;
+static pthread_mutex_t prop_handle_lock = PTHREAD_MUTEX_INITIALIZER;
+
+const void *my_property_find(const char *name)
+{
+	char value[PROP_VALUE_MAX];
+	struct hybris_prop_handle *h = NULL;
+	int i;
+
+	if (!name)
+		return NULL;
+
+	value[0] = '\0';
+	if (my_property_get(name, value, NULL) <= 0 || value[0] == '\0')
+		return NULL;
+
+	pthread_mutex_lock(&prop_handle_lock);
+	for (i = 0; i < prop_handle_count; i++) {
+		if (strcmp(prop_handles[i].name, name) == 0) {
+			h = &prop_handles[i];
+			break;
+		}
+	}
+	if (!h && prop_handle_count < HYBRIS_MAX_PROP_HANDLES) {
+		h = &prop_handles[prop_handle_count++];
+		snprintf(h->name, sizeof(h->name), "%s", name);
+		h->serial = 2;
+	}
+	if (h && strcmp(h->value, value) != 0) {
+		snprintf(h->value, sizeof(h->value), "%s", value);
+		/* Младший бит bionic держит под признаком «идёт запись». */
+		h->serial += 2;
+	}
+	pthread_mutex_unlock(&prop_handle_lock);
+
+	return h;
+}
+
+void my_property_read_callback(const void *pi,
+			       void (*cb)(void *cookie, const char *name,
+					  const char *value, uint32_t serial),
+			       void *cookie)
+{
+	const struct hybris_prop_handle *h = pi;
+
+	if (!h || !cb)
+		return;
+	cb(cookie, h->name, h->value, h->serial);
+}
+
+int my_property_read_pi(const void *pi, char *name, char *value)
+{
+	const struct hybris_prop_handle *h = pi;
+
+	if (!h)
+		return 0;
+	if (name)
+		strcpy(name, h->name);
+	if (value)
+		strcpy(value, h->value);
+
+	return (int)strlen(h->value);
+}
+
+uint32_t my_property_serial_pi(const void *pi)
+{
+	const struct hybris_prop_handle *h = pi;
+
+	return h ? h->serial : 0;
+}
+
+/*
+ * Ждать нам нечего: значения берутся из файла и в течение работы процесса не
+ * меняются. Но возвращаться немедленно нельзя — вызывающий тут же спросит
+ * снова. Выжидаем запрошенный таймаут (по умолчанию секунду) и сообщаем, что
+ * он истёк.
+ */
+int my_property_wait(const void *pi, uint32_t old_serial, uint32_t *new_serial,
+		     const struct timespec *relative_timeout)
+{
+	struct timespec ts = { 1, 0 };
+
+	(void)old_serial;
+	if (relative_timeout)
+		ts = *relative_timeout;
+	if (ts.tv_sec == 0 && ts.tv_nsec == 0)
+		ts.tv_nsec = 100 * 1000 * 1000;
+
+	nanosleep(&ts, NULL);
+
+	if (new_serial)
+		*new_serial = my_property_serial_pi(pi);
+
+	return 0;	/* таймаут истёк, значение не менялось */
+}
+
+uint32_t my_property_area_serial(void)
+{
+	return 1;
+}
+
 int my_property_set(const char *key, const char *value)
 {
 	int err;
