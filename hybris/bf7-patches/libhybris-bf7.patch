+
+void WaylandNativeWindow::commitLoop()
+{
+    lock();
+    for (;;) {
+        while (!m_commitPending && !m_commitQuit)
+            pthread_cond_wait(&m_commitCond, &mutex);
+        if (!m_commitPending)
+            break;
