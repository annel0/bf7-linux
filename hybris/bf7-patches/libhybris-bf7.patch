+	case EGL_EXTENSIONS:
+		return "EGL_EXT_device_drm EGL_EXT_device_drm_render_node";
+	case BF7_EGL_DRM_DEVICE_FILE_EXT:
+	case BF7_EGL_DRM_RENDER_NODE_FILE_EXT:
+		return bf7_render_node();
+	default:
+		__eglHybrisSetError(EGL_BAD_PARAMETER);
