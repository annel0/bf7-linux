+/*
+ * BF7: NATIVE_WINDOW_BUFFER_AGE по-честному. Возраст — сколько кадров назад
+ * буфер, который сейчас выдан на рисование, ушёл композитору (1 — в прошлом
+ * кадре); 0 — буфер новый или содержимое неизвестно, рисовать всё заново.
+ */
+int WaylandNativeWindow::bf7_query(const struct ANativeWindow *window, int what, int *value)
+{
+    const WaylandNativeWindow *self = static_cast<const WaylandNativeWindow *>(
+        static_cast<const BaseNativeWindow *>(window));
+
+    if (what == NATIVE_WINDOW_BUFFER_AGE) {
+        WaylandNativeWindow *w = const_cast<WaylandNativeWindow *>(self);
+        int age = 0;
+
+        w->lock();
+        /* номер хранится в самом буфере: у нового (после смены размера) он 0 */
+        if (w->m_poslednij && w->m_poslednij->bf7_kadr > 0)
+            age = (int)(w->m_kadr + 1 - w->m_poslednij->bf7_kadr);
+        w->unlock();
+        *value = age;
+        return NO_ERROR;
+    }
+    return bf7_base_query(window, what, value);
+}
