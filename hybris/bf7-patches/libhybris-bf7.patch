+/*
+ * Окно ANativeWindow поверх /dev/fb0 для BF7.
+ *
+ * Штатная платформа fbdev опирается на framebuffer_device_t из gralloc,
+ * которого в Android 12 больше нет (gralloc4 — это HIDL-сервис, а модуль
+ * gralloc.rogue.so не реализует framebuffer_device_open). Здесь буферы
+ * выделяются обычным gralloc, а показ делается самостоятельно: gralloc lock,
+ * копирование в mmap /dev/fb0 и FBIOPAN_DISPLAY.
+ *
+ * Логика вращения буферов взята из fbdev_window.cpp libhybris без изменений.
+ */
+#ifndef MTKFB_WINDOW_H
+#define MTKFB_WINDOW_H
+
+#include "eglnativewindowbase.h"
+#include <linux/fb.h>
+#include <hardware/gralloc.h>
+#include "disp_session.h"
+
+#include <list>
+#include <stddef.h>
+
+class MtkFbNativeWindowBuffer : public BaseNativeWindowBuffer {
+friend class MtkFbNativeWindow;
+
+protected:
+	MtkFbNativeWindowBuffer(unsigned int width,
+				unsigned int height,
+				unsigned int format,
+				uint64_t usage);
+	virtual ~MtkFbNativeWindowBuffer();
+
+protected:
+	int busy;
+	int status;
+	void *mapAddr;		/* прямое отображение dma-buf, если gralloc не даёт lock */
+	size_t mapLen;
+	int dmaFd;		/* fd dma-buf внутри native_handle */
+};
+
+class MtkFbNativeWindow : public EGLBaseNativeWindow {
+public:
+	MtkFbNativeWindow();
+	~MtkFbNativeWindow();
+
+	virtual int setSwapInterval(int interval);
+
+protected:
+	virtual int dequeueBuffer(BaseNativeWindowBuffer **buffer, int *fenceFd);
+	virtual int queueBuffer(BaseNativeWindowBuffer *buffer, int fenceFd);
+	virtual int cancelBuffer(BaseNativeWindowBuffer *buffer, int fenceFd);
+	virtual int lockBuffer(BaseNativeWindowBuffer *buffer);
+
+	virtual unsigned int type() const;
+	virtual unsigned int width() const;
+	virtual unsigned int height() const;
+	virtual unsigned int format() const;
+	virtual unsigned int defaultWidth() const;
+	virtual unsigned int defaultHeight() const;
+	virtual unsigned int queueLength() const;
+	virtual unsigned int transformHint() const;
+	virtual unsigned int getUsage() const;
+
+	virtual int setUsage(uint64_t usage);
+	virtual int setBuffersFormat(int format);
+	virtual int setBuffersDimensions(int width, int height);
+	virtual int setBufferCount(int cnt);
+
+private:
+	void destroyBuffers();
+	void reallocateBuffers();
+	int openFramebuffer();
+	int postBuffer(MtkFbNativeWindowBuffer *buffer);
+	int findDmaFd(MtkFbNativeWindowBuffer *buffer);
+	int openDispMgr();
+	int postViaDispMgr(MtkFbNativeWindowBuffer *buffer);
+	int postViaFramebuffer(MtkFbNativeWindowBuffer *buffer);
+	bool mirrorWanted() const;
+
+private:
+	uint64_t m_usage;
+	int m_bufFormat;
+	int m_bufferCount;
+	int m_freeBufs;
+	bool m_allocateBuffers;
+	int m_swapInterval;
+
+	int m_fbFd;
+	unsigned char *m_fbMem;
+	size_t m_fbMapLen;
+	unsigned int m_fbWidth;
+	unsigned int m_fbHeight;
+	unsigned int m_fbStride;
+	unsigned int m_fbPages;
+	unsigned int m_page;
+	struct fb_var_screeninfo m_var;
+
+	/* Вывод слоем наложения через /dev/mtk_disp_mgr: кадр не копируется
+	 * вовсе, дисплейный контроллер читает буфер gralloc напрямую. */
+	int m_dispFd;
+	unsigned int m_dispSession;
+	unsigned int m_dispLayer;
+	struct disp_frame_cfg_t m_frameCfg;	/* большая, держим вне стека */
+
+	std::list<MtkFbNativeWindowBuffer *> m_bufList;
+	MtkFbNativeWindowBuffer *m_frontBuf;
+};
+
+#endif
