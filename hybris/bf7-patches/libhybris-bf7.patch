+#define BF7_EGL_DEVICE_EXT			0x322C
+#define BF7_EGL_BAD_DEVICE_EXT			0x322B
+#define BF7_EGL_DRM_DEVICE_FILE_EXT		0x3233
+#define BF7_EGL_DRM_RENDER_NODE_FILE_EXT	0x3377
+
+/* Само значение неважно: наружу уходит только этот указатель. */
+static const char bf7_the_device[] = "bf7-render-device";
+
+static const char *bf7_render_node(void)
+{
+	static char path[64];
+	static int looked = 0;
+
+	if (looked)
+		return path[0] ? path : NULL;
+	looked = 1;
+
+	const char *env = getenv("BF7_DRM_RENDER_NODE");
+
+	if (env && access(env, R_OK | W_OK) == 0) {
+		snprintf(path, sizeof(path), "%s", env);
+		return path;
+	}
+	for (int i = 128; i < 136; i++) {
+		snprintf(path, sizeof(path), "/dev/dri/renderD%d", i);
+		if (access(path, R_OK | W_OK) == 0)
+			return path;
+	}
+	path[0] = '\0';
+	return NULL;
