+        m_pendFd = -1;
+        unlock();
+        double g0 = bf7_trace > 0 ? bf7_now() : 0;
+        sync_wait(fd, -1);
+        close(fd);
+        lock();
+        if (bf7_trace > 0) {
+            bf7_t_gpu += bf7_now() - g0;
+            bf7_n_async++;
