+	const char *path = getenv("LIBGLESV2") ? getenv("LIBGLESV2") : DEFAULT_LIBGLESV2;
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	struct stat st;
+	unsigned char *m;
