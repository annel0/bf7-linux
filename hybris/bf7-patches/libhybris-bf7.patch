+    }
+    if (fd >= 0 && sync_wait(fd, 0) != 0) {
+        /*
+         * GPU ещё рисует, а окно во всю панель — его могут показать
+         * напрямую, и контроллер дисплея забор не ждёт. Кадр зафиксирует
+         * поток, когда сработает забор.
