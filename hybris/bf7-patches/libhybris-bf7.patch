diff --git a/hybris/egl/platforms/mtkfb/mtkfb_window.cpp b/hybris/egl/platforms/mtkfb/mtkfb_window.cpp
new file mode 100644
index 0000000..cdc4292
--- /dev/null
+++ b/hybris/egl/platforms/mtkfb/mtkfb_window.cpp
@@ -0,0 +1,778 @@
+/*
+ * Окно ANativeWindow поверх /dev/fb0 для BF7. См. mtkfb_window.h.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <linux/types.h>
+#include <cutils/native_handle.h>
+
+extern "C" {
+#include <sync/sync.h>
+};
+
+#include <hybris/gralloc/gralloc.h>
+
+#include "mtkfb_window.h"
+#include "disp_session.h"
+#include "logging.h"
+
+#define MTKFB_BUFFER_COUNT 3
+
+/* Синхронизация кэша для dma-buf: ядро должно сделать буфер видимым для CPU. */
+#ifndef DMA_BUF_IOCTL_SYNC
+struct dma_buf_sync { __u64 flags; };
+#define DMA_BUF_SYNC_READ	(1 << 0)
+#define DMA_BUF_SYNC_START	(0 << 2)
+#define DMA_BUF_SYNC_END	(1 << 2)
+#define DMA_BUF_BASE		'b'
+#define DMA_BUF_IOCTL_SYNC	_IOW(DMA_BUF_BASE, 0, struct dma_buf_sync)
+#endif
+
+
+/*
+ * Чтение из буфера gralloc идёт со скоростью ~145 МБ/с: память отображена
+ * без кэша (write-combine), и одиночный memcpy на кадр 720x1612 стоит 31 мс.
+ * Задержка, а не полоса: четыре потока дают 523 МБ/с (8.7 мс). Пул живёт
+ * всё время работы окна, чтобы не платить за создание потоков на каждый кадр.
+ */
+#define MTKFB_COPY_THREADS 4
+
+struct CopyJob {
+	const unsigned char *src;
+	unsigned char *dst;
+	size_t srcStride;
+	size_t dstStride;
+	size_t row;
+	unsigned int height;
+};
+
+static pthread_mutex_t g_copy_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_copy_start = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t g_copy_done = PTHREAD_COND_INITIALIZER;
+static CopyJob g_job;
+static int g_copy_generation;
+static int g_copy_pending;
+static bool g_copy_ready;
+
+static void copy_band(const CopyJob &j, int idx, int total)
+{
+	unsigned int from = j.height * idx / total;
+	unsigned int to = j.height * (idx + 1) / total;
+
+	if (j.srcStride == j.dstStride && j.row == j.dstStride) {
+		memcpy(j.dst + (size_t)from * j.dstStride,
+		       j.src + (size_t)from * j.srcStride,
+		       (size_t)(to - from) * j.dstStride);
+		return;
+	}
+	for (unsigned int y = from; y < to; y++)
+		memcpy(j.dst + (size_t)y * j.dstStride,
+		       j.src + (size_t)y * j.srcStride, j.row);
+}
+
+static void *copy_worker(void *arg)
+{
+	long idx = (long)arg;
+	int seen = 0;
+
+	for (;;) {
+		pthread_mutex_lock(&g_copy_mutex);
+		while (g_copy_generation == seen)
+			pthread_cond_wait(&g_copy_start, &g_copy_mutex);
+		seen = g_copy_generation;
+		CopyJob job = g_job;
+		pthread_mutex_unlock(&g_copy_mutex);
+
+		copy_band(job, (int)idx, MTKFB_COPY_THREADS);
+
+		pthread_mutex_lock(&g_copy_mutex);
+		if (--g_copy_pending == 0)
+			pthread_cond_signal(&g_copy_done);
+		pthread_mutex_unlock(&g_copy_mutex);
+	}
+	return NULL;
+}
+
+static void copy_pool_init(void)
+{
+	if (g_copy_ready)
+		return;
+	for (long i = 1; i < MTKFB_COPY_THREADS; i++) {
+		pthread_t t;
+
+		if (pthread_create(&t, NULL, copy_worker, (void *)i) == 0)
+			pthread_detach(t);
+	}
+	g_copy_ready = true;
+}
+
+static void copy_parallel(const CopyJob &job)
+{
+	copy_pool_init();
+	pthread_mutex_lock(&g_copy_mutex);
+	g_job = job;
+	g_copy_pending = MTKFB_COPY_THREADS - 1;
+	g_copy_generation++;
+	pthread_cond_broadcast(&g_copy_start);
+	pthread_mutex_unlock(&g_copy_mutex);
+
+	copy_band(job, 0, MTKFB_COPY_THREADS);
+
+	pthread_mutex_lock(&g_copy_mutex);
+	while (g_copy_pending > 0)
+		pthread_cond_wait(&g_copy_done, &g_copy_mutex);
+	pthread_mutex_unlock(&g_copy_mutex);
+}
+
+static double mono_now(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+
+static void dmabuf_sync(int fd, bool start)
+{
+	struct dma_buf_sync s;
+
+	if (fd < 0)
+		return;
+	s.flags = DMA_BUF_SYNC_READ | (start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END);
+	ioctl(fd, DMA_BUF_IOCTL_SYNC, &s);
+}
+
+/* Отладочный след платформы: MTKFB_TRACE=1 */
+static int mtkfb_trace(void)
+{
+	static int on = -1;
+	if (on < 0)
+		on = getenv("MTKFB_TRACE") ? 1 : 0;
+	return on;
+}
+#define MT(fmt, ...) do { if (mtkfb_trace()) \
+	fprintf(stderr, "mtkfb: " fmt "\n", ##__VA_ARGS__); } while (0)
+
+static pthread_cond_t _cond = PTHREAD_COND_INITIALIZER;
+static pthread_mutex_t _mutex = PTHREAD_MUTEX_INITIALIZER;
+
+MtkFbNativeWindowBuffer::MtkFbNativeWindowBuffer(unsigned int width,
+						 unsigned int height,
+						 unsigned int format,
+						 uint64_t usage)
+{
+	ANativeWindowBuffer::width  = width;
+	ANativeWindowBuffer::height = height;
+	ANativeWindowBuffer::format = format;
+	ANativeWindowBuffer::usage  = usage;
+	busy = 0;
+	mapAddr = NULL;
+	mapLen = 0;
+	dmaFd = -1;
+	status = hybris_gralloc_allocate(width, height, format, usage,
+					 (buffer_handle_t *)&handle,
+					 (uint32_t *)&stride);
+}
+
+MtkFbNativeWindowBuffer::~MtkFbNativeWindowBuffer()
+{
+	if (mapAddr)
+		munmap(mapAddr, mapLen);
+	if (handle)
+		hybris_gralloc_release(handle, 1);
+}
+
+MtkFbNativeWindow::MtkFbNativeWindow()
+{
+	/* Никаких SW_*: драйвер PowerVR отказывается делать такой буфер целью
+	 * отрисовки (eglMakeCurrent -> EGL_BAD_MATCH). Читаем кадр напрямую
+	 * через mmap dma-buf из native_handle. */
+	m_usage = GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE;
+	{
+		const char *e = getenv("MTKFB_USAGE");
+		if (e)
+			m_usage = strtoull(e, NULL, 0);
+	}
+	m_bufFormat = HAL_PIXEL_FORMAT_RGBA_8888;
+	m_bufferCount = MTKFB_BUFFER_COUNT;
+	m_freeBufs = 0;
+	m_allocateBuffers = true;
+	m_swapInterval = 1;
+	m_frontBuf = NULL;
+	m_fbFd = -1;
+	m_fbMem = NULL;
+	m_fbMapLen = 0;
+	m_fbWidth = m_fbHeight = m_fbStride = 0;
+	m_fbPages = 1;
+	m_page = 0;
+	m_dispFd = -1;
+	m_dispSession = 0;
+	m_dispLayer = 0;		/* FB_LAYER: тот же слой, которым пользуется mtkfb */
+
+	if (openFramebuffer() != 0)
+		fprintf(stderr, "mtkfb: не удалось открыть /dev/fb0: %s\n", strerror(errno));
+	if (!getenv("MTKFB_NO_DISP_MGR") && openDispMgr() == 0)
+		fprintf(stderr, "mtkfb: вывод слоем наложения, без копирования кадра\n");
+}
+
+MtkFbNativeWindow::~MtkFbNativeWindow()
+{
+	destroyBuffers();
+	if (m_dispFd >= 0)
+		close(m_dispFd);
+	if (m_fbMem)
+		munmap(m_fbMem, m_fbMapLen);
+	if (m_fbFd >= 0)
+		close(m_fbFd);
+}
+
+int MtkFbNativeWindow::openFramebuffer()
+{
+	const char *dev = getenv("HYBRIS_MTKFB_DEVICE");
+	struct fb_fix_screeninfo fix;
+
+	m_fbFd = open(dev ? dev : "/dev/fb0", O_RDWR);
+	if (m_fbFd < 0)
+		return -errno;
+	if (ioctl(m_fbFd, FBIOGET_VSCREENINFO, &m_var) < 0 ||
+	    ioctl(m_fbFd, FBIOGET_FSCREENINFO, &fix) < 0)
+		return -errno;
+
+	m_fbWidth  = m_var.xres;
+	m_fbHeight = m_var.yres;
+	m_fbStride = fix.line_length;
+	m_fbPages  = m_var.yres_virtual / m_var.yres;
+	if (m_fbPages < 1)
+		m_fbPages = 1;
+	if (m_fbPages > 2)
+		m_fbPages = 2;
+	m_fbMapLen = (size_t)m_fbStride * m_var.yres_virtual;
+	m_fbMem = (unsigned char *)mmap(NULL, m_fbMapLen, PROT_READ | PROT_WRITE,
+					MAP_SHARED, m_fbFd, 0);
+	if (m_fbMem == MAP_FAILED) {
+		m_fbMem = NULL;
+		return -errno;
+	}
+
+	/* Панель ARGB/RGBA определяется по var: красный в нулевом бите значит,
+	 * что в памяти порядок R,G,B,A — совпадает с HAL_PIXEL_FORMAT_RGBA_8888. */
+	if (m_var.red.offset == 16)
+		m_bufFormat = HAL_PIXEL_FORMAT_BGRA_8888;
+
+	fprintf(stderr, "mtkfb: %ux%u stride=%u страниц=%u формат=0x%x\n",
+		m_fbWidth, m_fbHeight, m_fbStride, m_fbPages, m_bufFormat);
+	return 0;
+}
+
+
+/*
+ * Находит в native_handle дескриптор dma-buf: у буфера gralloc их несколько
+ * (у PowerVR три), и нужен тот, чей размер не меньше самого кадра.
+ */
+int MtkFbNativeWindow::findDmaFd(MtkFbNativeWindowBuffer *b)
+{
+	const native_handle_t *h = (const native_handle_t *)b->handle;
+	size_t need = (size_t)b->stride * m_fbHeight * 4;
+
+	if (b->dmaFd >= 0)
+		return b->dmaFd;
+	if (!h)
+		return -1;
+	for (int i = 0; i < h->numFds; i++) {
+		off_t len = lseek(h->data[i], 0, SEEK_END);
+
+		if (len > 0 && (size_t)len >= need) {
+			b->dmaFd = h->data[i];
+			return b->dmaFd;
+		}
+	}
+	return -1;
+}
+
+/*
+ * Открывает дисплейный контроллер и регистрирует сессию основного экрана.
+ *
+ * Обратите внимание: DISP_IOCTL_SET_INPUT_BUFFER и DISP_IOCTL_TRIGGER_SESSION
+ * в этом ядре не реализованы — весь кадр отправляется одним
+ * DISP_IOCTL_FRAME_CONFIG.
+ */
+int MtkFbNativeWindow::openDispMgr()
+{
+	struct disp_session_config cfg;
+
+	m_dispFd = open("/dev/mtk_disp_mgr", O_RDONLY);
+	if (m_dispFd < 0)
+		return -errno;
+
+	memset(&cfg, 0, sizeof cfg);
+	cfg.type = DISP_SESSION_PRIMARY;
+	cfg.device_id = 0;
+	cfg.mode = DISP_SESSION_DIRECT_LINK_MODE;
+	cfg.user = SESSION_USER_HWC;
+	if (ioctl(m_dispFd, DISP_IOCTL_CREATE_SESSION, &cfg) < 0) {
+		fprintf(stderr, "mtkfb: CREATE_SESSION: %s\n", strerror(errno));
+		close(m_dispFd);
+		m_dispFd = -1;
+		return -1;
+	}
+	m_dispSession = cfg.session_id;
+	return 0;
+}
+
+/*
+ * Пока к VNC кто-то подключён, кадр дополнительно копируется в фреймбуфер:
+ * bf7vnc читает именно /dev/fb0, а при выводе слоем наложения фреймбуфер
+ * перестаёт обновляться. Без зрителей копирования нет.
+ */
+bool MtkFbNativeWindow::mirrorWanted() const
+{
+	static const char *path = getenv("MTKFB_MIRROR_FLAG") ?
+				  getenv("MTKFB_MIRROR_FLAG") :
+				  "/run/bf7-gui/mirror-fb";
+
+	return access(path, F_OK) == 0;
+}
+
+int MtkFbNativeWindow::postViaDispMgr(MtkFbNativeWindowBuffer *b)
+{
+	struct disp_buffer_info info;
+	struct disp_frame_cfg_t *frame = &m_frameCfg;
+	struct disp_input_config *in;
+	int dma = findDmaFd(b);
+
+	if (dma < 0)
+		return -EINVAL;
+
+	memset(&info, 0, sizeof info);
+	info.session_id = m_dispSession;
+	info.layer_id = m_dispLayer;
+	info.layer_en = 1;
+	info.ion_fd = dma;
+	info.cache_sync = 1;
+	if (ioctl(m_dispFd, DISP_IOCTL_PREPARE_INPUT_BUFFER, &info) < 0)
+		return -errno;
+
+	memset(frame, 0, sizeof *frame);
+	frame->setter = SESSION_USER_HWC;
+	frame->session_id = m_dispSession;
+	frame->input_layer_num = 1;
+	frame->mode = DISP_SESSION_DIRECT_LINK_MODE;
+	frame->user = SESSION_USER_HWC;
+	frame->present_fence_idx = (unsigned int)-1;
+	frame->prev_present_fence_fd = -1;
+
+	in = &frame->input_cfg[0];
+	in->layer_id = m_dispLayer;
+	in->layer_enable = 1;
+	in->buffer_source = DISP_BUFFER_ION;
+	in->security = DISP_NORMAL_BUFFER;
+	in->src_fmt = (m_bufFormat == HAL_PIXEL_FORMAT_BGRA_8888) ?
+		      DISP_FORMAT_BGRA8888 : DISP_FORMAT_RGBA8888;
+	in->src_pitch = (unsigned short)b->stride;
+	in->src_width = (unsigned short)m_fbWidth;
+	in->src_height = (unsigned short)m_fbHeight;
+	in->tgt_width = (unsigned short)m_fbWidth;
+	in->tgt_height = (unsigned short)m_fbHeight;
+	in->next_buff_idx = info.index;
+	in->src_phy_addr = NULL;		/* адрес ядро возьмёт из ION */
+	in->src_fence_fd = -1;
+	in->alpha = 0xFF;
+	in->ext_sel_layer = -1;
+
+	if (ioctl(m_dispFd, DISP_IOCTL_FRAME_CONFIG, frame) < 0) {
+		int err = -errno;
+
+		if (info.fence_fd >= 0)
+			close(info.fence_fd);
+		return err;
+	}
+	if (info.fence_fd >= 0)
+		close(info.fence_fd);
+
+	/*
+	 * FRAME_CONFIG не блокирует, поэтому без ожидания синхроимпульса всё
+	 * крутится вхолостую: замер показал 260 кадров в секунду на панели
+	 * 60 Гц. Ждём здесь, заодно давая Qt правильный ритм кадров.
+	 */
+	if (m_swapInterval > 0) {
+		struct disp_session_vsync_config vsync;
+
+		memset(&vsync, 0, sizeof vsync);
+		vsync.session_id = m_dispSession;
+		if (ioctl(m_dispFd, DISP_IOCTL_WAIT_FOR_VSYNC, &vsync) < 0 &&
+		    errno != EINTR)
+			MT("ожидание кадрового импульса: %s", strerror(errno));
+	}
+	return 0;
+}
+
+/*
+ * Копия кадра в фреймбуфер.
+ *
+ * Когда кадр показывается слоем наложения, фреймбуфер служит только снимком
+ * для VNC: пишем в видимую страницу и ничего не переключаем. Иначе
+ * панорамирование уводит вывод на страницу, которую зритель не читает, и в
+ * VNC попадает то предыдущий кадр, то смесь двух.
+ */
+int MtkFbNativeWindow::postViaFramebuffer(MtkFbNativeWindowBuffer *b)
+{
+	const bool mirrorOnly = (m_dispFd >= 0);
+
+	const unsigned char *src = NULL;
+	bool locked = false;
+	void *vaddr = NULL;
+
+	if (!m_fbMem)
+		return -ENODEV;
+
+	/* Сначала пробуем штатный путь gralloc. */
+	static int nolock = -1;
+	int lockrc;
+	double t0 = 0, t1 = 0, t2 = 0;
+
+	if (nolock < 0)
+		nolock = getenv("MTKFB_NO_LOCK") ? 1 : 0;
+	if (mtkfb_trace() && !b->mapAddr) {
+		const native_handle_t *h = (const native_handle_t *)b->handle;
+		if (h) {
+			MT("handle: numFds=%d numInts=%d", h->numFds, h->numInts);
+			for (int i = 0; i < h->numFds; i++) {
+				off_t len = lseek(h->data[i], 0, SEEK_END);
+				MT("  fd[%d]=%d размер=%ld", i, h->data[i], (long)len);
+			}
+		}
+	}
+	if (mtkfb_trace())
+		t0 = mono_now();
+	lockrc = nolock ? -1 :
+		 hybris_gralloc_lock(b->handle, GRALLOC_USAGE_SW_READ_OFTEN,
+				     0, 0, m_fbWidth, m_fbHeight, &vaddr);
+	MT("gralloc lock -> %d vaddr=%p", lockrc, vaddr);
+	if (lockrc == 0 && vaddr) {
+		src = (const unsigned char *)vaddr;
+		locked = true;
+	} else {
+		/* Буфер выделен без SW-флагов: читаем dma-buf напрямую.
+		 * В native_handle первым идёт fd ION-буфера. */
+		if (!b->mapAddr) {
+			const native_handle_t *h = (const native_handle_t *)b->handle;
+
+			if (!h || h->numFds < 1) {
+				fprintf(stderr, "mtkfb: у буфера нет fd (numFds=%d)\n",
+					h ? h->numFds : -1);
+				return -EINVAL;
+			}
+			b->mapLen = (size_t)b->stride * m_fbHeight * 4;
+			for (int i = 0; i < h->numFds; i++) {
+				off_t len = lseek(h->data[i], 0, SEEK_END);
+
+				if (len > 0 && (size_t)len < b->mapLen)
+					continue;
+				void *p = mmap(NULL, b->mapLen, PROT_READ, MAP_SHARED,
+					       h->data[i], 0);
+				if (p != MAP_FAILED) {
+					b->mapAddr = p;
+					b->dmaFd = h->data[i];
+					MT("dma-buf: подошёл fd[%d]=%d", i, b->dmaFd);
+					break;
+				}
+				MT("dma-buf: fd[%d]=%d не отображается: %s",
+				   i, h->data[i], strerror(errno));
+			}
+			if (!b->mapAddr) {
+				fprintf(stderr, "mtkfb: ни один fd буфера не отображается\n");
+				return -EINVAL;
+			}
+			MT("dma-buf fd=%d отображён, %zu байт", b->dmaFd, b->mapLen);
+		}
+		dmabuf_sync(b->dmaFd, true);
+		src = (const unsigned char *)b->mapAddr;
+	}
+
+	if (mtkfb_trace())
+		t1 = mono_now();
+	{
+		CopyJob job;
+		unsigned int page = mirrorOnly ? (m_var.yoffset / m_fbHeight) : m_page;
+
+		job.src = src;
+		job.dst = m_fbMem + (size_t)page * m_fbHeight * m_fbStride;
+		job.srcStride = (size_t)b->stride * 4;
+		job.dstStride = m_fbStride;
+		job.row = (size_t)m_fbWidth * 4;
+		job.height = m_fbHeight;
+		copy_parallel(job);
+	}
+
+	if (mtkfb_trace())
+		t2 = mono_now();
+	if (locked)
+		hybris_gralloc_unlock(b->handle);
+	else
+		dmabuf_sync(b->dmaFd, false);
+
+
+	if (mirrorOnly)
+		return 0;
+
+	/* FBIOPAN_DISPLAY с yoffset=0 всё равно нужен: именно он сбрасывает кэш
+	 * и заново отправляет слой в overlay (см. mtkfb_pan_display_impl). */
+	m_var.yoffset = m_page * m_fbHeight;
+	m_var.activate = m_swapInterval ? FB_ACTIVATE_VBL : FB_ACTIVATE_NOW;
+	if (ioctl(m_fbFd, FBIOPAN_DISPLAY, &m_var) < 0) {
+		if (m_fbPages > 1 && errno == EINVAL) {
+			/* В нашем mtkfb fix.ypanstep = 0 (так нужно консоли), поэтому
+			 * ядро отклоняет любой yoffset > 0. Переходим на одну
+			 * страницу — возможен разрыв кадра, зато картинка идёт. */
+			fprintf(stderr, "mtkfb: панорамирование недоступно "
+				"(ypanstep=0), переключаюсь на одну страницу\n");
+			m_fbPages = 1;
+			m_page = 0;
+			m_var.yoffset = 0;
+			if (ioctl(m_fbFd, FBIOPAN_DISPLAY, &m_var) == 0)
+				return 0;
+		}
+		fprintf(stderr, "mtkfb: FBIOPAN_DISPLAY(yoffset=%u): %s\n",
+			m_var.yoffset, strerror(errno));
+		return -errno;
+	}
+	if (m_fbPages > 1)
+		m_page ^= 1;
+	if (mtkfb_trace()) {
+		double t3 = mono_now();
+		MT("кадр: lock %.1f мс, копирование %.1f мс, FBIOPAN %.1f мс",
+		   (t1 - t0) * 1e3, (t2 - t1) * 1e3, (t3 - t2) * 1e3);
+	}
+	return 0;
+}
+
+int MtkFbNativeWindow::postBuffer(MtkFbNativeWindowBuffer *b)
+{
+	if (m_dispFd >= 0) {
+		int rv = postViaDispMgr(b);
+
+		if (rv == 0) {
+			/* Зеркало для VNC — только пока кто-то смотрит. */
+			if (mirrorWanted())
+				postViaFramebuffer(b);
+			return 0;
+		}
+		fprintf(stderr, "mtkfb: слой наложения не принял кадр (%s), "
+			"перехожу на копирование в фреймбуфер\n", strerror(-rv));
+		close(m_dispFd);
+		m_dispFd = -1;
+	}
+	return postViaFramebuffer(b);
+}
+
+void MtkFbNativeWindow::destroyBuffers()
+{
+	std::list<MtkFbNativeWindowBuffer *>::iterator it = m_bufList.begin();
+
+	for (; it != m_bufList.end(); ++it) {
+		MtkFbNativeWindowBuffer *b = *it;
+		b->common.decRef(&b->common);
+	}
+	m_bufList.clear();
+	m_freeBufs = 0;
+	m_frontBuf = NULL;
+}
+
+void MtkFbNativeWindow::reallocateBuffers()
+{
+	destroyBuffers();
+
+	for (int i = 0; i < m_bufferCount; i++) {
+		MtkFbNativeWindowBuffer *b =
+			new MtkFbNativeWindowBuffer(m_fbWidth, m_fbHeight,
+						    m_bufFormat, m_usage);
+		b->common.incRef(&b->common);
+		MT("буфер %d: status=%d handle=%p stride=%d", i, b->status, (void *)b->handle, b->stride);
+		if (b->status) {
+			b->common.decRef(&b->common);
+			fprintf(stderr, "mtkfb: выделено только %d буферов из %d\n",
+				m_freeBufs, m_bufferCount);
+			break;
+		}
+		m_freeBufs++;
+		m_bufList.push_back(b);
+	}
+	m_allocateBuffers = false;
+}
+
+int MtkFbNativeWindow::setSwapInterval(int interval)
+{
+	m_swapInterval = interval;
+	return 0;
+}
+
+int MtkFbNativeWindow::dequeueBuffer(BaseNativeWindowBuffer **buffer, int *fenceFd)
+{
+	MtkFbNativeWindowBuffer *b = NULL;
+
+	MT("dequeueBuffer");
+	pthread_mutex_lock(&_mutex);
+
+	if (m_allocateBuffers)
+		reallocateBuffers();
+
+	while (m_freeBufs == 0)
+		pthread_cond_wait(&_cond, &_mutex);
+
+	while (1) {
+		std::list<MtkFbNativeWindowBuffer *>::iterator it = m_bufList.begin();
+
+		for (; it != m_bufList.end(); ++it) {
+			if (*it == m_frontBuf)
+				continue;
+			if ((*it)->busy == 0)
+				break;
+		}
+		if (it == m_bufList.end()) {
+			pthread_cond_wait(&_cond, &_mutex);
+			continue;
+		}
+		b = *it;
+		break;
+	}
+
+	b->busy = 1;
+	m_freeBufs--;
+	*buffer = b;
+	*fenceFd = -1;
+	pthread_mutex_unlock(&_mutex);
+	return 0;
+}
+
+int MtkFbNativeWindow::queueBuffer(BaseNativeWindowBuffer *buffer, int fenceFd)
+{
+	MtkFbNativeWindowBuffer *b = (MtkFbNativeWindowBuffer *)buffer;
+	int rv;
+
+	MT("queueBuffer %p", b);
+
+	pthread_mutex_lock(&_mutex);
+	b->busy = 2;
+	pthread_mutex_unlock(&_mutex);
+
+	{
+		double f0 = mtkfb_trace() ? mono_now() : 0;
+
+		if (fenceFd >= 0) {
+			sync_wait(fenceFd, -1);
+			close(fenceFd);
+		}
+		if (mtkfb_trace())
+			MT("ожидание fence(%d): %.1f мс", fenceFd, (mono_now() - f0) * 1e3);
+	}
+
+	if (getenv("MTKFB_NULLPOST")) {
+		pthread_mutex_lock(&_mutex);
+		b->busy = 0;
+		m_frontBuf = b;
+		m_freeBufs++;
+		pthread_cond_signal(&_cond);
+		pthread_mutex_unlock(&_mutex);
+		return 0;
+	}
+	rv = postBuffer(b);
+	if (rv != 0)
+		fprintf(stderr, "mtkfb: показ кадра не удался: %s\n", strerror(-rv));
+
+	pthread_mutex_lock(&_mutex);
+	b->busy = 0;
+	m_frontBuf = b;
+	m_freeBufs++;
+	pthread_cond_signal(&_cond);
+	pthread_mutex_unlock(&_mutex);
+	return rv;
+}
+
+int MtkFbNativeWindow::cancelBuffer(BaseNativeWindowBuffer *buffer, int fenceFd)
+{
+	MtkFbNativeWindowBuffer *b = (MtkFbNativeWindowBuffer *)buffer;
+
+	if (fenceFd >= 0)
+		close(fenceFd);
+
+	pthread_mutex_lock(&_mutex);
+	b->busy = 0;
+	m_freeBufs++;
+	pthread_cond_signal(&_cond);
+	pthread_mutex_unlock(&_mutex);
+	return 0;
+}
+
+int MtkFbNativeWindow::lockBuffer(BaseNativeWindowBuffer *buffer)
+{
+	(void)buffer;
+	return NO_ERROR;
+}
+
+unsigned int MtkFbNativeWindow::width() const         { return m_fbWidth; }
+unsigned int MtkFbNativeWindow::height() const        { return m_fbHeight; }
+unsigned int MtkFbNativeWindow::format() const        { MT("format -> 0x%x", m_bufFormat); return m_bufFormat; }
+unsigned int MtkFbNativeWindow::defaultWidth() const  { return m_fbWidth; }
+unsigned int MtkFbNativeWindow::defaultHeight() const { return m_fbHeight; }
+unsigned int MtkFbNativeWindow::queueLength() const   { return 0; }
+unsigned int MtkFbNativeWindow::type() const
+{
+	const char *e = getenv("MTKFB_TYPE");
+
+	MT("type");
+	if (e && atoi(e) == 1)
+		return NATIVE_WINDOW_SURFACE;
+	return NATIVE_WINDOW_FRAMEBUFFER;
+}
+unsigned int MtkFbNativeWindow::transformHint() const { return 0; }
+unsigned int MtkFbNativeWindow::getUsage() const      { MT("getUsage -> 0x%llx", (unsigned long long)m_usage); return m_usage; }
+
+int MtkFbNativeWindow::setUsage(uint64_t usage)
+{
+	MT("setUsage 0x%llx", (unsigned long long)usage);
+	{
+		const char *e = getenv("MTKFB_USAGE");
+		if (e)
+			usage |= strtoull(e, NULL, 0);
+		else
+			usage |= GRALLOC_USAGE_HW_RENDER;
+	}
+	m_allocateBuffers = (m_usage != usage);
+	m_usage = usage;
+	return NO_ERROR;
+}
+
+int MtkFbNativeWindow::setBuffersFormat(int format)
+{
+	MT("setBuffersFormat 0x%x", format);
+	if (format == 0)
+		return NO_ERROR;
+	m_allocateBuffers |= (format != m_bufFormat);
+	m_bufFormat = format;
+	return NO_ERROR;
+}
+
+int MtkFbNativeWindow::setBuffersDimensions(int width, int height)
+{
+	(void)width; (void)height;
+	/* Размер окна всегда равен размеру панели. */
+	return NO_ERROR;
+}
+
+int MtkFbNativeWindow::setBufferCount(int cnt)
+{
+	MT("setBufferCount %d", cnt);
+	if (cnt != m_bufferCount) {
+		m_bufferCount = cnt;
+		m_allocateBuffers = true;
+	}
+	return NO_ERROR;
+}
