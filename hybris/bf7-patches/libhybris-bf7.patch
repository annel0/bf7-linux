+EGLBoolean eglQueryDevicesEXT(EGLint max_devices, void **devices,
+			      EGLint *num_devices)
+{
+	if (!num_devices || (max_devices > 0 && !devices)) {
+		__eglHybrisSetError(EGL_BAD_PARAMETER);
+		return EGL_FALSE;
+	}
+	if (!bf7_render_node()) {
+		*num_devices = 0;
+		return EGL_TRUE;
+	}
+	if (max_devices <= 0) {
+		*num_devices = 1;
+		return EGL_TRUE;
+	}
+	devices[0] = (void *) bf7_the_device;
+	*num_devices = 1;
+	return EGL_TRUE;
