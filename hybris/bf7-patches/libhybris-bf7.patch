+EGLSync eglCreateSync(EGLDisplay dpy, EGLenum type, const EGLAttrib *attrib_list)
+{
+	EGLint ints[33];
+	unsigned n = 0;
+
+	HYBRIS_EGL_EXT(&_eglCreateSyncKHR, "eglCreateSyncKHR");
+	if (!_eglCreateSyncKHR)
+		return EGL_NO_SYNC;
+	if (attrib_list) {
+		while (attrib_list[n] != EGL_NONE && n + 2 < sizeof(ints) / sizeof(ints[0])) {
+			ints[n] = (EGLint) attrib_list[n];
+			ints[n + 1] = (EGLint) attrib_list[n + 1];
+			n += 2;
+		}
