+static gboolean
+bf7_back_to_info (PhoshLockscreen *self)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+
+  priv->widget_timer = 0;
+  hdy_deck_set_visible_child (priv->deck, priv->carousel);
+  return G_SOURCE_REMOVE;
+}
