 }
 
+/*****************************************************************************/
+/* MediaTek data path (BF7)
+ *
+ * The MediaTek modem has no PPP on its AT port: ATD*99# is taken as a voice
+ * call and the port stops answering. Data goes through the ccmni network
+ * interface instead: the PDP context is activated with +CGACT, the modem
+ * brings the interface up by itself, and the IP settings are read back with
+ * +CGCONTRDP. Enabled only when the net port carries the udev property
+ * ID_MM_BF7_MTK_DATA=1, so every other modem keeps the generic behaviour.
+ */
+
+static gboolean
+bf7_is_mtk_net_port (MMPort *port)
+{
+    MMKernelDevice *kernel_device;
+
+    if (!port || mm_port_get_port_type (port) != MM_PORT_TYPE_NET)
+        return FALSE;
+    kernel_device = mm_port_peek_kernel_device (port);
+    return (kernel_device &&
+            mm_kernel_device_get_property_as_boolean (kernel_device, "ID_MM_BF7_MTK_DATA"));
+}
+
+static MMPort *
+bf7_peek_mtk_net_port (MMBaseModem *modem)
+{
+    MMPort *net;
+
+    net = mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET);
+    mm_obj_dbg (modem, "MediaTek data port: %s", net ? mm_port_get_device (net) : "none");
+    return bf7_is_mtk_net_port (net) ? net : NULL;
+}
+
+/* The modem itself is tagged on its primary AT port */
+static gboolean
+bf7_is_mtk_modem (MMBaseModem *modem)
+{
+    MMPortSerialAt *primary;
+    MMKernelDevice *kernel_device;
+
+    primary = mm_base_modem_peek_port_primary (modem);
+    kernel_device = primary ? mm_port_peek_kernel_device (MM_PORT (primary)) : NULL;
+    return (kernel_device &&
+            mm_kernel_device_get_property_as_boolean (kernel_device, "ID_MM_BF7_MTK_DATA"));
+}
+
+static gboolean
+bf7_is_ipv4 (const gchar *str)
+{
+    g_autoptr(GInetAddress) address = NULL;
+
+    address = str ? g_inet_address_new_from_string (str) : NULL;
+    return (address && g_inet_address_get_family (address) == G_SOCKET_FAMILY_IPV4);
+}
+
+static guint
+bf7_prefix_from_mask (const gchar *mask)
+{
+    guint  a, b, c, d, prefix = 0;
+    guint32 bits;
+
+    if (!mask || sscanf (mask, "%u.%u.%u.%u", &a, &b, &c, &d) != 4 ||
+        a > 255 || b > 255 || c > 255 || d > 255)
+        return 32;
+    bits = (a << 24) | (b << 16) | (c << 8) | d;
+    while (bits & 0x80000000) {
+        prefix++;
+        bits <<= 1;
+    }
+    /* Not a contiguous mask, or nonsense like 0.0.0.0: point to point */
+    if (bits || prefix < 8)
+        return 32;
+    return prefix;
+}
+
+/* The modem binds each new context to the next ccmni interface in turn
+ * (100 -> ccmni0, 504 -> ccmni4, 605 -> ccmni5 ...) and says which one in
+ * "+EIF: <id>, ifup, ..."; the interface is ccmni<id % 100>. */
+static void
+bf7_eif_received (MMPortSerialAt *port,
+                  GMatchInfo     *info,
+                  MMBaseModem    *modem)
+{
+    g_autofree gchar *line = NULL;
+    guint             id = 0;
+    gchar             state[16] = "";
+
+    line = g_match_info_fetch (info, 0);
+    if (!line)
+        return;
+    g_strstrip (line);
+    mm_obj_dbg (modem, "MediaTek interface report: %s", line);
+    if (sscanf (line, "+EIF: %u, %15[a-z]", &id, state) == 2 && g_str_equal (state, "ifup"))
+        g_object_set_data (G_OBJECT (modem), "bf7-eif-ifup", GUINT_TO_POINTER (id + 1));
+}
+
+static void
+bf7_listen_eif (MMBaseModem    *modem,
+                MMPortSerialAt *primary)
+{
+    g_autoptr(GRegex) r = NULL;
+
+    r = g_regex_new ("\\r\\n\\+EIF:[^\\r\\n]*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, r,
+                                                   (MMPortSerialAtUnsolicitedMsgFn)bf7_eif_received,
+                                                   modem, NULL);
+}
+
+typedef struct {
+    MMBaseModem *modem;
+    guint        cid;
+    guint        tries;
+} Bf7DialContext;
+
+static void
+bf7_dial_context_free (Bf7DialContext *ctx)
+{
+    g_object_unref (ctx->modem);
+    g_slice_free (Bf7DialContext, ctx);
+}
+
+static void
+bf7_dial_fail (GTask  *task,
+               GError *error)
+{
+    Bf7DialContext *ctx = g_task_get_task_data (task);
+    MMPortSerialAt *primary;
+    gchar          *command;
+
+    /* The context is up but unusable: take it down again */
+    primary = mm_base_modem_peek_port_primary (ctx->modem);
+    if (primary) {
+        command = g_strdup_printf ("+CGACT=0,%u", ctx->cid);
+        mm_base_modem_at_command_full (ctx->modem, primary, command, 45,
+                                       FALSE, FALSE, NULL, NULL, NULL);
+        g_free (command);
+    }
+    g_task_return_error (task, error);
+    g_object_unref (task);
+}
+
+static gboolean
+bf7_wait_eif (GTask *task)
+{
+    Bf7DialContext *ctx = g_task_get_task_data (task);
+    guint           v;
+    GList          *l;
+    g_autofree gchar *name = NULL;
+
+    v = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (ctx->modem), "bf7-eif-ifup"));
+    if (!v) {
+        if (++ctx->tries < 50)
+            return G_SOURCE_CONTINUE;
+        bf7_dial_fail (task, g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                          "MediaTek modem did not report the data interface"));
+        return G_SOURCE_REMOVE;
+    }
+
+    name = g_strdup_printf ("ccmni%u", (v - 1) % 100);
+    for (l = mm_base_modem_peek_data_ports (ctx->modem); l; l = g_list_next (l)) {
+        MMPort *port = MM_PORT (l->data);
+
+        if (bf7_is_mtk_net_port (port) && g_str_equal (mm_port_get_device (port), name)) {
+            mm_obj_dbg (ctx->modem, "context %u is on %s", ctx->cid, name);
+            g_task_return_pointer (task, g_object_ref (port), g_object_unref);
+            g_object_unref (task);
+            return G_SOURCE_REMOVE;
+        }
+    }
+    bf7_dial_fail (task, g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                      "MediaTek data interface %s is not a port of this modem", name));
+    return G_SOURCE_REMOVE;
+}
+
+static void
+bf7_cgact_dial_ready (MMBaseModem  *modem,
+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* "+EIF: ... ifup" may come before or after OK: wait up to 5 s */
+    if (bf7_wait_eif (task) == G_SOURCE_CONTINUE)
+        g_timeout_add (100, (GSourceFunc)bf7_wait_eif, task);
+}
+
+static void
+bf7_cgact_disconnect_ready (MMBaseModem  *modem,
+                            GAsyncResult *res,
+                            GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        mm_obj_dbg (g_task_get_source_object (task),
+                    "PDP context deactivation failed (not fatal): %s", error->message);
+        g_error_free (error);
+    }
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
