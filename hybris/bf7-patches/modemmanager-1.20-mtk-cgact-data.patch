--- modemmanager-1.20.4.orig/src/mm-broadband-bearer.c	2026-09-23 17:11:08.089217573 +0300
+++ modemmanager-1.20.4/src/mm-broadband-bearer.c	2026-09-23 17:55:39.463501986 +0300
@@ -524,6 +524,215 @@
