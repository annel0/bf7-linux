+/* MediaTek: a context activated but left unusable must not stay up */
+static void
+bf7_deactivate (MMBroadbandBearer      *self,
+                DetailedConnectContext *ctx)
+{
+    gchar *command;
+
+    command = g_strdup_printf ("+CGACT=0,%d", self->priv->profile_id);
+    mm_base_modem_at_command_full (ctx->modem, ctx->primary, command, 45,
+                                   FALSE, FALSE, NULL, NULL, NULL);
+    g_free (command);
+}
+
+static void bf7_cgcontrdp_ready (MMBaseModem  *modem,
+                                 GAsyncResult *res,
+                                 GTask        *task);
+
+/* MediaTek: the address of the context, from +CGPADDR: <cid>,"<addr>"[,...] */
+static void
+bf7_cgpaddr_ready (MMBaseModem  *modem,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    MMBroadbandBearer *self;
+    DetailedConnectContext *ctx;
+    const gchar *response;
+    gchar *command;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, NULL);
+    if (response) {
+        const gchar *p = strstr (response, "+CGPADDR:");
+        g_auto(GStrv) fields = NULL;
+        guint i;
+
+        fields = p ? g_strsplit (p + strlen ("+CGPADDR:"), ",", -1) : NULL;
+        for (i = 1; fields && fields[i]; i++) {
+            gchar *f = g_strstrip (fields[i]);
+            gsize  n = strlen (f);
+
+            if (n >= 2 && f[0] == '"' && f[n - 1] == '"') {
+                f[n - 1] = '\0';
+                f++;
+            }
+            if (bf7_is_ipv4 (f) && !g_str_equal (f, "0.0.0.0")) {
+                g_object_set_data_full (G_OBJECT (task), "bf7-address", g_strdup (f), g_free);
+                break;
+            }
+        }
+    }
+
+    command = g_strdup_printf ("+CGCONTRDP=%d", self->priv->profile_id);
+    mm_base_modem_at_command_full (ctx->modem, ctx->primary, command, 10,
+                                   FALSE, FALSE, NULL,
+                                   (GAsyncReadyCallback)bf7_cgcontrdp_ready, task);
+    g_free (command);
+}
+
+/* MediaTek: static IPv4 settings of the active context, from +CGCONTRDP */
+static void
+bf7_cgcontrdp_ready (MMBaseModem  *modem,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    MMBroadbandBearer                *self;
+    DetailedConnectContext           *ctx;
+    const gchar                      *response;
+    GError                           *error = NULL;
+    g_auto(GStrv)                     lines = NULL;
+    g_autofree gchar                 *address = NULL;
+    g_autofree gchar                 *subnet = NULL;
+    g_autofree gchar                 *dns1 = NULL;
+    g_autofree gchar                 *dns2 = NULL;
+    const gchar                      *dns[3] = { NULL, NULL, NULL };
+    guint                             n_dns = 0;
+    guint                             i;
+    g_autoptr(MMBearerIpConfig)       ipv4_config = NULL;
+    g_autoptr(MMBearerConnectResult)  result = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        bf7_deactivate (self, ctx);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* One line per address family; take the IPv4 one. The MediaTek modem
+     * leaves the address field empty and gives only DNS here; the address
+     * then comes from +CGPADDR, asked before. MM's own parser can't be used:
+     * with an empty address field it takes the subnet from the next field
+     * and shifts the DNS servers by one. */
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i] && !dns1; i++) {
+        g_auto(GStrv) f = NULL;
+        guint         n, j;
+
+        g_strstrip (lines[i]);
+        if (!g_str_has_prefix (lines[i], "+CGCONTRDP:"))
+            continue;
+        f = g_strsplit (lines[i] + strlen ("+CGCONTRDP:"), ",", -1);
+        n = g_strv_length (f);
+        for (j = 0; j < n; j++) {
+            gchar *v = g_strstrip (f[j]);
+            gsize  k = strlen (v);
+
+            if (k >= 2 && v[0] == '"' && v[k - 1] == '"') {
+                memmove (v, v + 1, k - 2);
+                v[k - 2] = '\0';
+            }
+        }
+        if (n < 4)
+            continue;
+        /* f[3]: "a.b.c.d.m.m.m.m" (27.007 >= v9.4.0), "a.b.c.d" (older, mask
+         * in f[4]) or empty (MediaTek, newer layout) */
+        {
+            g_auto(GStrv) o = g_strsplit (f[3], ".", -1);
+            guint         no = g_strv_length (o);
+            guint         d;
+
+            if (no == 8) {
+                address = g_strdup_printf ("%s.%s.%s.%s", o[0], o[1], o[2], o[3]);
+                subnet  = g_strdup_printf ("%s.%s.%s.%s", o[4], o[5], o[6], o[7]);
+                d = 5;
+            } else if (no == 4) {
+                address = g_strdup (f[3]);
+                subnet  = n > 4 ? g_strdup (f[4]) : NULL;
+                d = 6;
+            } else
+                d = 5;
+            if (address && !bf7_is_ipv4 (address))
+                g_clear_pointer (&address, g_free);
+            if (n > d && bf7_is_ipv4 (f[d]))
+                dns1 = g_strdup (f[d]);
+            if (n > d + 1 && bf7_is_ipv4 (f[d + 1]))
+                dns2 = g_strdup (f[d + 1]);
+        }
+    }
+
+    if (!address)
+        address = g_strdup (g_object_get_data (G_OBJECT (task), "bf7-address"));
+    if (!address) {
+        bf7_deactivate (self, ctx);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No IPv4 address in +CGPADDR or +CGCONTRDP response");
+        g_object_unref (task);
+        return;
+    }
+
+    if (bf7_is_ipv4 (dns1) && !g_str_equal (dns1, "0.0.0.0"))
+        dns[n_dns++] = dns1;
+    if (bf7_is_ipv4 (dns2) && !g_str_equal (dns2, "0.0.0.0"))
+        dns[n_dns++] = dns2;
+
+    ipv4_config = mm_bearer_ip_config_new ();
+    mm_bearer_ip_config_set_method (ipv4_config, MM_BEARER_IP_METHOD_STATIC);
+    mm_bearer_ip_config_set_address (ipv4_config, address);
+    mm_bearer_ip_config_set_prefix (ipv4_config, bf7_prefix_from_mask (subnet));
+    if (n_dns)
+        mm_bearer_ip_config_set_dns (ipv4_config, dns);
+    mm_obj_dbg (self, "context %d settings: %s/%u, %u DNS server(s)",
+                self->priv->profile_id, address, bf7_prefix_from_mask (subnet), n_dns);
+
+    result = mm_bearer_connect_result_new (ctx->data, ipv4_config, NULL);
+    mm_bearer_connect_result_set_profile_id (result, self->priv->profile_id);
+    g_task_return_pointer (task, g_steal_pointer (&result), (GDestroyNotify)mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
