#!/bin/bash
# Снять тёмный кадр: карту собственного свечения матрицы.
#
# Закройте объектив чем-нибудь плотным — так, чтобы света не проходило совсем.
# Кадр снимается при тех выдержке и усилении, которые стоят сейчас, и годится
# только для близких условий: свечение растёт и с выдержкой, и с усилением.
set -u
N=${1:-16}
V=/sys/class/leds/vibrator/brightness
buzz() { [ -w $V ] && { echo 200 > $V; sleep "$1"; echo 0 > $V; }; }
# Ждём по самому файлу калибровки, а не по журналу: служба пишет вывод в
# /tmp/camera.log, и journalctl про неё ничего не знает — на этом обвязка
# один раз уже соврала «съёмка не удалась», хотя кадр снялся.
F=/var/lib/bf7-camd-тёмный.raw
БЫЛО=$(stat -c %Y "$F" 2>/dev/null || echo 0)

buzz 0.25
echo "темнота $N" > /run/bf7-camd
for i in $(seq 1 200); do
    СТАЛО=$(stat -c %Y "$F" 2>/dev/null || echo 0)
    if [ "$СТАЛО" != "$БЫЛО" ] && [ -s "$F" ]; then
        sleep 0.5
        buzz 0.06; sleep 0.12; buzz 0.06
        echo "калибровка снята: $(head -c 32 "$F" | head -1)"
        exit 0
    fi
    sleep 0.25
done
buzz 0.8
echo "не дождался" >&2
exit 1
