[Desktop Entry]
Type=Application
Name=Фотоаппарат
Comment=Съёмка со сложением кадров
# Раньше здесь стоял GDK_BACKEND=x11: программа писалась для рабочего стола
# Xfce, где всё шло через Xwayland. В телефонном сеансе окно должно быть
# родным для Wayland, иначе оболочка не сможет им управлять как своим.
Exec=bf7-camera-gui
Icon=camera-photo
Terminal=false
Categories=Graphics;Photography;
Keywords=камера;фото;снимок;
# С 2026-09-23 в сетке — «Камера» (bf7-kamera.py): видоискатель, «Фото» и
# «Ночь». Эта запись остаётся ради тёмного кадра (калибровка) и серий, но в
# сетке не показывается, чтобы не было двух камер.
NoDisplay=true
