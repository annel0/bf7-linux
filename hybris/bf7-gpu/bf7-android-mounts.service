[Unit]
Description=Стоковые разделы Android для libhybris
# Как можно раньше: к моменту, когда стартует всё остальное, среда для
# libhybris должна быть готова. Если её подготовил initramfs, скрипт увидит
# смонтированное и ничего не сделает.
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target systemd-udevd.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bf7-android-mounts.sh

[Install]
WantedBy=sysinit.target
