# Панель BF7 повёрнута на 180° относительно тачскрина: касание в левом верхнем
# углу приходит как правый нижний. Матрица калибровки libinput разворачивает
# обе оси: x' = -x + 1, y' = -y + 1.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="mtk-tpd2", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1"
