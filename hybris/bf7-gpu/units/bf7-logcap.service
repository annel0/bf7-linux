[Unit]
Description=Ограничение размера журнала андроидных блобов

[Service]
Type=oneshot
# oneshot без предела может повиснуть навсегда; усечение журнала — доли секунды.
TimeoutStartSec=30
# logrotate на устройстве не установлен. Один зациклившийся блоб надувает
# журнал до сотен мегабайт за минуты — так уже было 2026-09-16.
ExecStart=/bin/sh -c 'f=/var/log/bf7-android.log; [ -f "$f" ] || exit 0; s=$(stat -c %%s "$f"); [ "$s" -gt 33554432 ] || exit 0; mv "$f" "$f.1"; : > "$f"; echo "журнал усечён, было $s байт"'
