[Unit]
# BF7: держать вывод внешнего усилителя динамика.
#
# Линия 151 (mt_soc_dl1_pcm@11220000/extamp_gpio) поднимает усилитель класса D.
# Раньше считалось, что её забирает и ведёт сам звуковой драйвер, а ключа
# Ext_Speaker_Amp_Switch достаточно. Это оказалось не так — проверено
# 2026-09-22 замером через микрофон:
#
#   ключ туда-сюда, линия отпущена  -> энергия записи 175
#   линия поднята снаружи           -> энергия записи 41733, пик 9292
#
# Драйвер и не может её вести: при загрузке он не находит ни одного нужного
# состояния pinctrl, о чём честно пишет в журнал:
#   AudDrv_GPIO_probe pinctrl_lookup_state aud_smartpa_on fail -19
#   AudDrv_GPIO_probe pinctrl_lookup_state extamp-pullhigh fail -19
# и в gpioinfo линия 151 так и остаётся «unused».
#
# gpioset держит линию, пока жив: отпустит — и она вернётся во вход, усилитель
# замолчит. Поэтому служба долгоживущая, а не oneshot.
Description=Внешний усилитель динамика BF7
After=bf7-audio.service
Wants=bf7-audio.service
# На время сна усилитель выключаем: отпущенная линия уходит во вход, и он
# молчит. Долг из списка доводки — расход в глубоком сне ~50 мА, усилитель
# был одним из двух постоянных потребителей (второй, камера, уже гаснет).
# После сна службу поднимает bf7-posle-sna через 1 с — раньше systemd
# отклоняет запуск, пока сон не закончен.
Conflicts=sleep.target
Before=sleep.target

[Service]
Type=exec
# --mode=time, а не signal: в signal gpioset из libgpiod 1.6 опрашивает
# сигналы раз в секунду — пробуждение процессора каждую секунду
# круглосуточно (замер 2026-09-23: 10 за 10 с). В time он один раз засыпает
# на ~23 дня; по истечении systemd поднимет его заново (Restart=always).
ExecStart=/usr/bin/gpioset --mode=time --sec=2000000 gpiochip0 151=1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
