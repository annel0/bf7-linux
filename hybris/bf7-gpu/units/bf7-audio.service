[Unit]
# BF7: аналоговый путь звука.
#
# Идёт ПОСЛЕ звукового сервера, а не до. Причина: ключи кодека принимаются
# только при работающем нисходящем тракте, и держать его открытым — как раз
# работа сервера. Пытаться открыть устройство вторым потоком нельзя: это роняет
# ядро. Поэтому сервер поднимает поток, а эта служба лишь щёлкает ключами.
#
# Подробности и что нельзя трогать — в /usr/local/bin/bf7-audio-up.
Description=Аналоговый путь звука BF7
After=bf7-pulse.service
Wants=bf7-pulse.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/bf7-audio-up

[Install]
WantedBy=multi-user.target
