# BF7: отдать feedbackd наш вибромотор.
#
# Вибромотор на плате — светодиодного класса с «спуском» (duration/activate),
# feedbackd такого не понимает. Служба bf7-vibrad выставляет его как
# устройство ввода «bf7-vibrator» с силовой обратной связью (FF_RUMBLE,
# FF_PERIODIC). Но feedbackd берёт только устройства с меткой
# FEEDBACKD_TYPE=vibra, а его собственное правило метит лишь путь
# platform-vibrator. Наше устройство виртуальное, путь у него другой — и
# уведомления, звонки и нажатия не вибрировали вовсе, хотя мост работал.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="bf7-vibrator", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"

# Синий светодиод уведомлений. Штатные правила feedbackd метят только
# «*:status» и «*:indicator», а наш называется просто «blue» (цвет feedbackd
# берёт из имени). Мигает он через триггер pattern — в 4.19 его не было,
# перенесён в наше ядро из 5.16 (2026-09-23). fbd-ledctrl ставит триггер
# pattern и отдаёт файлы группе feedbackd. Тема feedbackd мигает синим о
# пропущенных звонках, сообщениях и уведомлениях.
#
# Камера показала: светодиод (у верхнего края, рядом с фронтальной камерой)
# на плате включён НАОБОРОТ — горит, пока канал ISINK1 выключен, и гаснет,
# когда включён, при любом токе. Синего огонька нет вовсе. На кабеле поэтому
# уведомление видно как «обратное дыхание» ровного огня. Горит ли он без
# кабеля — не проверено; драйвер вслепую не переворачиваем.
SUBSYSTEM=="leds", KERNEL=="blue", ENV{FEEDBACKD_TYPE}="led", RUN+="/usr/libexec/fbd-ledctrl -p %S%p -t pattern -G feedbackd"
