[Unit]
# BF7: сторож выключения. 2026-09-24 перезагрузка трижды повисла на выходе phoc
# (ping жив, systemd встал посреди строки консоли), и телефон сбрасывался сам
# лишь через 15-25 минут — хозяина рядом нет, кнопку нажать некому.
#
# Сторож запускается целями выключения и сам не останавливается
# (DefaultDependencies=no). Нормальное выключение занимает 2-20 с. Если через
# 60 с система ещё жива — значит, зависла:
#   s, u — сбросить буферы и перемонтировать ФС только для чтения (паники
#       уже портили корень — см. research-log 2026-09-22);
#   b — немедленная перезагрузка (с 2026-09-24 ядро перезагружает плату
#       сразу, через сторож mtk-wdt, а не ждёт его тайм-аута).
# Дамп задач (SysRq w) убран: печатаясь при уровне 7 во все консоли, он
# растягивал сброс до 150 с, а сохранить его негде — pstore после сброса
# отдаёт устаревшую запись.
# На последнем шаге выключения systemd-shutdown сам убивает оставшиеся
# процессы, сторож в том числе: до него дело доходит только при зависании.
Description=BF7: сторож выключения (сброс через 60 с зависания)
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/bin/sh -c 'sleep 60; echo "bf7-straza-vykl: выключение висит 60 с, сброс" > /dev/kmsg; echo s > /proc/sysrq-trigger; sleep 2; echo u > /proc/sysrq-trigger; sleep 2; echo b > /proc/sysrq-trigger'

[Install]
WantedBy=reboot.target poweroff.target halt.target
