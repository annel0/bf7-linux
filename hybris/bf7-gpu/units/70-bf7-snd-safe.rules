# BF7: закрыть доступ к опасным звуковым устройствам.
#
# У mt-snd-card двадцать три устройства воспроизведения и восемь записи:
# голосовые каналы модема, петли, TDM, SCP, BTCVSD. Открытие некоторых из них
# роняет ядро. Точная причина найдена по посмертному журналу:
#
#   [wireplumber] Unable to handle kernel paging request at ffffff8009e66000
#   Internal error: Oops: 96000047
#     __memset_io
#     mtk_pcm_dl2_params        <- устройство 23, MultiMedia2_PLayback
#     soc_pcm_hw_params
#     snd_pcm_hw_params
#
# Обработчик DL2 подставляет в поток область звукового ОЗУ и затирание выходит
# за её отображённые границы. Нам это устройство не нужно.
#
# Поэтому доступ оставлен только двум проверенным: pcmC0D0p (воспроизведение) и
# pcmC0D1c (запись). Остальные закрыты для всех, кроме root, и звуковой сервер
# их даже не увидит. Правило не отменяет необходимости починить драйвер, но
# снимает возможность уронить телефон одним неосторожным перебором устройств.

SUBSYSTEM!="sound", GOTO="bf7_snd_end"
KERNEL!="pcmC0D*", GOTO="bf7_snd_end"

KERNEL=="pcmC0D0p", GROUP="audio", MODE="0660", GOTO="bf7_snd_end"
KERNEL=="pcmC0D1c", GROUP="audio", MODE="0660", GOTO="bf7_snd_end"

# Всё прочее — только root, и то по необходимости.
GROUP="root", MODE="0600"

LABEL="bf7_snd_end"
