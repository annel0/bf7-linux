# BF7: привязать светодиод панели к нашему устройству подсветки.
#
# Модуль bf7_backlight объявляет устройство класса backlight (его ищет
# gsd-power, а через него — ползунок яркости в телефонной оболочке) и ведёт
# светодиод через триггер. Привязку делает эта строка: без неё устройство есть,
# а яркость не меняется.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="lcd-backlight", ATTR{trigger}="bf7-backlight"
