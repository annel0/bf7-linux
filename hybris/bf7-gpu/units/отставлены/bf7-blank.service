# ОТСТАВЛЕНА 2026-09-23. Всё, что она делала, теперь делают штатно, а её
# собственные действия стали вредны:
#   - кнопку питания обрабатывает Phosh (проверено bf7-knopka: гасит и зажигает
#     сам), а эта служба вела свой счётчик «погашен/зажжён» и расходилась с
#     ним: нажатие, разбудившее экран через Phosh, она принимала за гашение и
#     выключала тачскрин — экран горел с мёртвым касанием (журнал 07:47:53);
#   - гашение подсветки и сон тачскрина при выключенном выводе делает ядро:
#     bf7_drm гасит тракт через fb_blank, класс backlight получает FB_BLANK,
#     тачскрин — своё оповещение;
#   - её записи в /sys/class/backlight gsd-power принимал за выбор хозяина и
#     запоминал: после пробуждения экран возвращался на 12 из 255.
# Двоичный файл hybris/bf7-gpu/bf7-blank.c оставлен как история.
[Unit]
# BF7: гашение экрана по кнопке питания.
#
# Живёт отдельно от композитора, поэтому работает и под нашим рабочим столом,
# и под телефонным сеансом. Долгое нажатие остаётся за systemd-logind.
Description=Кнопка питания BF7: гашение экрана и усыпление тача
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bf7-blank
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
