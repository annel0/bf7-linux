[Unit]
Description=BF7 WPA3 Wi-Fi supplicant
After=bf7-wifi.service systemd-networkd.service
Requires=bf7-wifi.service

[Service]
Type=simple
# Do not use -B: Android's OEM kernel rejects daemon(3) with ENXIO.
ExecStart=/usr/sbin/wpa_supplicant -D nl80211 -i wlan0 -c /etc/wpa_supplicant/wlan0.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
