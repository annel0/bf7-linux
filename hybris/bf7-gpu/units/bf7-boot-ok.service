[Unit]
# BF7: отметить загрузку успешной — с выдержкой.
#
# В нашем образе намеренно нет отметки успеха: так плохое ядро само
# откатывается на прежний слот. Но у этого есть обратная сторона — счётчик
# попыток загрузчика уменьшается при КАЖДОЙ загрузке, и после нескольких
# перезагрузок подряд телефон уходит на слот B со стоковым ядром. В ночь на
# 2026-09-22 это случилось и выглядело как «всё сломалось».
#
# Решение посередине: отмечаем успех не сразу, а через три минуты работы и
# только если поднялся графический сеанс. Плохое ядро до этого не доживёт и
# по-прежнему откатится, а обычная перезагрузка счётчик не тратит.
Description=Отметить загрузку BF7 успешной
After=graphical.target
Wants=graphical.target

[Service]
# Type=simple, а не oneshot: скрипт выжидает три минуты, прежде чем отметить
# слот, и с oneshot всё это время задание числится выполняющимся, а systemd —
# «загружающимся». Настоящую поломку в таком состоянии легко проглядеть.
Type=simple
ExecStart=/usr/local/sbin/bf7-boot-ok
# Отметка нужна один раз за загрузку; если не вышло — перезапускать незачем.
Restart=no

[Install]
WantedBy=graphical.target
