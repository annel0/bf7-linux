# BF7: настройка PulseAudio.
#
# Почему не штатная. Штатная грузит module-udev-detect, который перебирает все
# устройства карты, а их у mt-snd-card двадцать три — голосовые каналы модема,
# петли, TDM, SCP. Открытие одного из них роняет ядро: проверено дважды,
# оба раза androidboot.bootreason=kernel_panic ровно на запуске звукового
# сервера. Поэтому устройства заданы поимённо, и только те два, что проверены.
#
# mmap=false обязателен: отображения памяти драйвер не поддерживает, dmix на нём
# отвечает «Function not implemented», а ядро от такого доступа падает.
#
# module-suspend-on-idle грузится — с 2026-09-23.
#
# Раньше он был выключен намеренно: «аналоговый путь кодека живёт только пока
# открыт поток, через 20 секунд после закрытия звук пропадает». Плата за это
# была круглосуточной: сервер писал тишину в железо, ~113 пробуждений
# процессора в секунду при погашенном экране, кодек и DMA не засыпали никогда.
#
# Перемерено приборно — акустической петлёй: телефон играет тон 1 кГц через
# динамик и одновременно пишет его своим микрофоном (tools/bf7-zvuk-petlya.sh).
# Опора при открытом устройстве — тон на 68–70 дБ над шумом. После сна
# устройства 36 секунд и после сна 3 минуты — те же 68–71 дБ, начало звука
# не обрезано. Прежнее опасение больше не подтверждается: скорее всего, его
# сняли позднейшие починки тракта — внешний усилитель теперь держит своя
# служба bf7-extamp, а ключи тракта включает bf7-audio-up.
#
# Пробуждений сервера во сне — 0 за 30 секунд вместо ~3400.

.fail

load-module module-device-restore
load-module module-stream-restore
load-module module-native-protocol-unix auth-anonymous=1 socket=/run/bf7-pulse/native

# Размер периода трогать НЕЛЬЗЯ. Попытка поднять его с 4096 до 16384 кадров
# (ради трёх пробуждений в секунду вместо двенадцати) обернулась чередой паник
# ядра: буфер перестаёт помещаться в звуковое ОЗУ, и драйвер затирает память за
# его границей — та же беда, что и у mtk_pcm_dl2. Телефон уходил в перезагрузку
# раз в минуту, пока служба не была выключена.
#
# 4096 кадров при четырёх периодах — проверенное сочетание. Пока звук
# играет, это около пяти процентов ядра; в тишине устройство теперь засыпает
# (см. module-suspend-on-idle выше), и расход — ноль.
load-module module-alsa-sink device=hw:0,0 mmap=false tsched=0 fragments=4 fragment_size=4096 sink_name=bf7out sink_properties=device.description="Динамик\ BF7"
load-module module-alsa-source device=hw:0,1 mmap=false tsched=0 fragments=4 fragment_size=4096 source_name=bf7in source_properties=device.description="Микрофон\ BF7"

set-default-sink bf7out
set-default-source bf7in

# Усыплять приёмник и источник через 5 секунд тишины.
load-module module-suspend-on-idle timeout=5

# Bluetooth-наушники и колонки (A2DP). Без пакета pulseaudio-module-bluetooth
# и этих строк сопряжение проходило, а звук в наушники не шёл вовсе (найдено
# 2026-09-30). Discover ждёт BlueZ на системной шине сам, так что порядок
# запуска с bluetooth.service не важен. switch-on-connect переводит звук на
# подключённые наушники и обратно на динамик, когда они отключаются.
.ifexists module-bluetooth-discover.so
load-module module-bluetooth-policy
load-module module-bluetooth-discover
load-module module-switch-on-connect
.endif
