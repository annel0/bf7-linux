diff --git a/drivers/misc/mediatek/imgsensor/src/common/v1/imgsensor_proc.c b/drivers/misc/mediatek/imgsensor/src/common/v1/imgsensor_proc.c
index 7f799e3a6..73b0c4392 100644
--- a/drivers/misc/mediatek/imgsensor/src/common/v1/imgsensor_proc.c
+++ b/drivers/misc/mediatek/imgsensor/src/common/v1/imgsensor_proc.c
@@ -455,6 +455,306 @@ static int imgsensor_proc_status_open(struct inode *inode, struct file *file)
 	return single_open(file, imgsensor_proc_status_read, NULL);
 };
 
+/************************************************************************
+ * BF7: удержание питания на гнезде камеры
+ *
+ * Зачем. Штатный путь (SET_DRIVER -> CHECK_IS_ALIVE) подаёт питание,
+ * читает код сенсора и тут же снимает питание. Окно выходит около 25 мс —
+ * за него не успеть ни просканировать шину, ни посмотреть состояние ножек
+ * в debugfs. Этот переключатель подаёт то же самое питание и оставляет его,
+ * пока не скажут снять.
+ *
+ *     echo "0 on"  > /proc/driver/camsensor_power   # главное гнездо
+ *     echo "1 on"  > /proc/driver/camsensor_power   # переднее гнездо
+ *     cat          /proc/driver/camsensor_power     # что сейчас держим
+ *     echo "0 off" > /proc/driver/camsensor_power
+ *
+ * Отдельно — такты и ножки, чтобы перебирать догадки без пересборки ядра:
+ *
+ *     echo "0 mclk 1 1"        # включить мультиплексор camtg1_sel на 24 МГц
+ *     echo "0 mclk 1 1 26"     # то же, но 26 МГц
+ *     echo "0 pin PDN 1"       # поднять ножку PDN гнезда 0
+ *     echo "0 pin DVDD 1100"   # выставить цифровое питание 1,1 В
+ *
+ * Имена ножек: PDN RST AVDD DVDD DOVDD AFVDD MCLK. Значение — либо 0/1, либо
+ * напряжение в милливольтах из набора, который понимает драйвер
+ * (1000 1100 1200 1210 1220 1500 1800 2500 2800 2900).
+ *
+ * Про MCLK отдельно и важно. Какой мультиплексор кому достаётся, видно не из
+ * драйвера, а из дерева устройств: `cam0_mclk_on` переводит GPIO100 в режим 1,
+ * а это по таблице выводов MT6761 — **CMMCLK1**, то есть источник camtg1_sel.
+ * У переднего гнезда `cam1_mclk_on` — это GPIO99, режим 1, **CMMCLK0**, то
+ * есть camtg_sel. Нумерация гнёзд и нумерация CMMCLK здесь переставлены
+ * местами, и на этом легко обжечься.
+ *
+ * Имя сенсора выбирается само: берётся первая запись из
+ * sensor_power_sequence[], имя которой встречается в списке разрешённых для
+ * этого гнезда (cam<N>_enable_sensor из дерева устройств). Так работает и
+ * штатный перебор, только он ещё и требует ответа по шине.
+ *
+ * Про такты. Родительские такты camsys/seninf включает открытие
+ * /dev/kd_camera_hw, а его закрытие их гасит — и заодно
+ * imgsensor_hw_release_all() сбрасывает все ножки в «выключено». Чтобы
+ * чужое закрытие не погасило то, что мы держим, здесь повторён тот же учёт
+ * ссылок, что и у самого узла устройства: счётчик imgsensor_open_cnt.
+ *
+ * Важно при отладке: пока гнездо под удержанием, не гонять пробы, которые
+ * сами дёргают питание (CHECK_IS_ALIVE и прочее) — их выключение опустит
+ * сброс и погасит MCLK, а регуляторы останутся включёнными по счётчику, и
+ * измерять вы будете половинчатое состояние, не зная об этом.
+ ************************************************************************/
+static char *bf7_pwr_held[IMGSENSOR_SENSOR_IDX_MAX_NUM];
+
+/*
+ * Какой мультиплексор тактов обслуживает какое гнездо. Взято из дерева
+ * устройств: гнездо 0 сидит на CMMCLK1, гнездо 1 — на CMMCLK0 (см. шапку).
+ */
+static const unsigned int bf7_pwr_tg[] = { 1, 0, 2, 3 };
+
+static const struct {
+	const char *name;
+	enum IMGSENSOR_HW_PIN pin;
+} bf7_pin_names[] = {
+	{ "PDN",   IMGSENSOR_HW_PIN_PDN },
+	{ "RST",   IMGSENSOR_HW_PIN_RST },
+	{ "AVDD",  IMGSENSOR_HW_PIN_AVDD },
+	{ "DVDD",  IMGSENSOR_HW_PIN_DVDD },
+	{ "DOVDD", IMGSENSOR_HW_PIN_DOVDD },
+	{ "AFVDD", IMGSENSOR_HW_PIN_AFVDD },
+	{ "MCLK",  IMGSENSOR_HW_PIN_MCLK },
+};
+
+static const struct {
+	unsigned int mv;
+	enum IMGSENSOR_HW_PIN_STATE state;
+} bf7_pin_levels[] = {
+	{    0, IMGSENSOR_HW_PIN_STATE_LEVEL_0 },
+	{    1, IMGSENSOR_HW_PIN_STATE_LEVEL_HIGH },
+	{ 1000, IMGSENSOR_HW_PIN_STATE_LEVEL_1000 },
+	{ 1100, IMGSENSOR_HW_PIN_STATE_LEVEL_1100 },
+	{ 1200, IMGSENSOR_HW_PIN_STATE_LEVEL_1200 },
+	{ 1210, IMGSENSOR_HW_PIN_STATE_LEVEL_1210 },
+	{ 1220, IMGSENSOR_HW_PIN_STATE_LEVEL_1220 },
+	{ 1500, IMGSENSOR_HW_PIN_STATE_LEVEL_1500 },
+	{ 1800, IMGSENSOR_HW_PIN_STATE_LEVEL_1800 },
+	{ 2500, IMGSENSOR_HW_PIN_STATE_LEVEL_2500 },
+	{ 2800, IMGSENSOR_HW_PIN_STATE_LEVEL_2800 },
+	{ 2900, IMGSENSOR_HW_PIN_STATE_LEVEL_2900 },
+};
+
+static int bf7_pwr_mclk(unsigned int tg, int on, unsigned int freq)
+{
+	struct ACDK_SENSOR_MCLK_STRUCT mclk;
+
+	memset(&mclk, 0, sizeof(mclk));
+	mclk.TG   = (MUINT8)tg;
+	mclk.freq = freq;
+	mclk.on   = (MUINT8)(on ? 1 : 0);
+
+	return imgsensor_clk_set(&pgimgsensor->clk, &mclk);
+}
+
+static int bf7_pwr_pin(enum IMGSENSOR_SENSOR_IDX idx,
+		       enum IMGSENSOR_HW_PIN pin,
+		       enum IMGSENSOR_HW_PIN_STATE state)
+{
+	struct IMGSENSOR_HW_DEVICE *pdev =
+		pgimgsensor->hw.pdev[pgimgsensor->hw.sensor_pwr[idx].id[pin]];
+
+	if (pdev == NULL || pdev->set == NULL)
+		return -ENODEV;
+
+	pdev->set(pdev->pinstance, idx, pin, state);
+	return 0;
+}
+
+static char *bf7_pwr_pick_name(enum IMGSENSOR_SENSOR_IDX idx)
+{
+	struct IMGSENSOR_HW_POWER_SEQ *pseq = sensor_power_sequence;
+	const char *enable_list = pgimgsensor->hw.enable_sensor_by_index[idx];
+
+	if (enable_list == NULL)
+		return NULL;
+
+	while (pseq < sensor_power_sequence + IMGSENSOR_HW_SENSOR_MAX_NUM &&
+	       pseq->name != NULL) {
+		if (strstr(enable_list, pseq->name))
+			return pseq->name;
+		pseq++;
+	}
+
+	return NULL;
+}
+
+static int bf7_pwr_hold_read(struct seq_file *m, void *v)
+{
+	enum IMGSENSOR_SENSOR_IDX i;
+
+	for (i = IMGSENSOR_SENSOR_IDX_MIN_NUM;
+	     i < IMGSENSOR_SENSOR_IDX_MAX_NUM;
+	     i++) {
+		const char *list = pgimgsensor->hw.enable_sensor_by_index[i];
+		char *pick = bf7_pwr_pick_name(i);
+
+		seq_printf(m,
+			"гнездо %d: %s, разрешены [%s], запись питания есть у [%s]\n",
+			i,
+			bf7_pwr_held[i] ? "ПОД ПИТАНИЕМ" : "обесточено",
+			list ? list : "-",
+			pick ? pick : "-");
+	}
+
+	seq_printf(m, "открытий устройства: %d\n",
+		atomic_read(&pgimgsensor->imgsensor_open_cnt));
+
+	return 0;
+}
+
+static int bf7_pwr_hold_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, bf7_pwr_hold_read, NULL);
+}
+
+static ssize_t bf7_pwr_hold_write(
+	struct file *file,
+	const char __user *buffer,
+	size_t count,
+	loff_t *data)
+{
+	char buf[32] = { '\0' };
+	char verb[8] = { '\0' };
+	unsigned int idx = 0;
+	size_t len = (count < sizeof(buf) - 1) ? count : sizeof(buf) - 1;
+	struct IMGSENSOR_SENSOR *psensor;
+	char *name;
+	int ret;
+
+	if (copy_from_user(buf, buffer, len))
+		return -EFAULT;
+
+	if (sscanf(buf, "%u %7s", &idx, verb) != 2)
+		return -EINVAL;
+
+	if (idx >= IMGSENSOR_SENSOR_IDX_MAX_NUM)
+		return -EINVAL;
+
+	psensor = &pgimgsensor->sensor[idx];
+	/*
+	 * Номер гнезда обычно проставляет ioctl SET_DRIVER. Мы идём мимо него,
+	 * поэтому ставим сами: imgsensor_hw_power() читает его из psensor.
+	 */
+	psensor->inst.sensor_idx = idx;
+
+	if (!strncmp(verb, "on", 2)) {
+		if (bf7_pwr_held[idx] != NULL) {
+			pr_info("%s: гнездо %u уже держим (%s)\n",
+				__func__, idx, bf7_pwr_held[idx]);
+			return count;
+		}
+
+		name = bf7_pwr_pick_name(idx);
+		if (name == NULL) {
+			pr_info("%s: гнездо %u: нет записи питания ни для одного разрешённого сенсора\n",
+				__func__, idx);
+			return -ENODEV;
+		}
+
+		if (atomic_read(&pgimgsensor->imgsensor_open_cnt) == 0)
+			imgsensor_clk_enable_all(&pgimgsensor->clk);
+		atomic_inc(&pgimgsensor->imgsensor_open_cnt);
+
+		ret = imgsensor_hw_power(&pgimgsensor->hw, psensor, name,
+					 IMGSENSOR_HW_POWER_STATUS_ON);
+		if (ret != IMGSENSOR_RETURN_SUCCESS) {
+			atomic_dec(&pgimgsensor->imgsensor_open_cnt);
+			if (atomic_read(&pgimgsensor->imgsensor_open_cnt) == 0)
+				imgsensor_clk_disable_all(&pgimgsensor->clk);
+			pr_info("%s: гнездо %u (%s): питание подать не вышло\n",
+				__func__, idx, name);
+			return -EIO;
+		}
+
+		bf7_pwr_held[idx] = name;
+
+		/*
+		 * Такты включать здесь больше не надо: это делает mclk_set() в
+		 * самом пути питания (mt6761/camera_hw/mclk/mclk.c). Команда
+		 * `mclk` ниже осталась — ей удобно перебирать частоты и
+		 * мультиплексоры вручную.
+		 */
+		pr_info("%s: гнездо %u (%s): питание подано и удерживается\n",
+			__func__, idx, name);
+
+	} else if (!strncmp(verb, "mclk", 4)) {
+		unsigned int tg = 0, on = 0, freq = 24;
+		int n = sscanf(buf, "%*u %*7s %u %u %u", &tg, &on, &freq);
+
+		if (n < 2)
+			return -EINVAL;
+
+		ret = bf7_pwr_mclk(tg, on, freq);
+		pr_info("%s: мультиплексор тактов %u -> %s, %u МГц (ответ %d)\n",
+			__func__, tg, on ? "включён" : "выключен", freq, ret);
+
+	} else if (!strncmp(verb, "pin", 3)) {
+		char pname[8] = { '\0' };
+		unsigned int mv = 0;
+		unsigned int i;
+		enum IMGSENSOR_HW_PIN pin = IMGSENSOR_HW_PIN_NONE;
+		enum IMGSENSOR_HW_PIN_STATE state = IMGSENSOR_HW_PIN_STATE_NONE;
+
+		if (sscanf(buf, "%*u %*7s %7s %u", pname, &mv) != 2)
+			return -EINVAL;
+
+		for (i = 0; i < ARRAY_SIZE(bf7_pin_names); i++)
+			if (!strcmp(pname, bf7_pin_names[i].name))
+				pin = bf7_pin_names[i].pin;
+
+		for (i = 0; i < ARRAY_SIZE(bf7_pin_levels); i++)
+			if (mv == bf7_pin_levels[i].mv)
+				state = bf7_pin_levels[i].state;
+
+		if (pin == IMGSENSOR_HW_PIN_NONE ||
+		    state == IMGSENSOR_HW_PIN_STATE_NONE) {
+			pr_info("%s: не понял ножку «%s» или значение %u\n",
+				__func__, pname, mv);
+			return -EINVAL;
+		}
+
+		ret = bf7_pwr_pin(idx, pin, state);
+		pr_info("%s: гнездо %u, ножка %s -> %u (ответ %d)\n",
+			__func__, idx, pname, mv, ret);
+
+	} else if (!strncmp(verb, "off", 3)) {
+		if (bf7_pwr_held[idx] == NULL)
+			return count;
+
+		imgsensor_hw_power(&pgimgsensor->hw, psensor, bf7_pwr_held[idx],
+				   IMGSENSOR_HW_POWER_STATUS_OFF);
+		bf7_pwr_held[idx] = NULL;
+
+		atomic_dec(&pgimgsensor->imgsensor_open_cnt);
+		if (atomic_read(&pgimgsensor->imgsensor_open_cnt) == 0)
+			imgsensor_clk_disable_all(&pgimgsensor->clk);
+
+		pr_info("%s: гнездо %u: питание снято\n", __func__, idx);
+
+	} else {
+		return -EINVAL;
+	}
+
+	return count;
+}
+
+static const struct file_operations fcamera_proc_fops_bf7_power = {
+	.owner = THIS_MODULE,
+	.open  = bf7_pwr_hold_open,
+	.read  = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+	.write = bf7_pwr_hold_write,
+};
+
 static const struct file_operations fcamera_proc_fops_status = {
 	.owner = THIS_MODULE,
 	.open = imgsensor_proc_status_open,
@@ -517,6 +817,10 @@ enum IMGSENSOR_RETURN imgsensor_proc_init(void)
 	    "driver/pdaf_type", 0664, NULL, &fcamera_proc_fops_set_pdaf_type);
 	proc_create(PROC_SENSOR_STAT, 0664, NULL, &fcamera_proc_fops_status);
 
+	/* BF7: удержание питания на гнезде, см. выше */
+	proc_create("driver/camsensor_power", 0664, NULL,
+		    &fcamera_proc_fops_bf7_power);
+
 	/* Camera information */
 	proc_create(PROC_CAMERA_INFO, 0664, NULL, &fcamera_proc_fops1);
 
diff --git a/drivers/misc/mediatek/imgsensor/src/mt6761/camera_hw/imgsensor_cfg_table.c b/drivers/misc/mediatek/imgsensor/src/mt6761/camera_hw/imgsensor_cfg_table.c
index 60aa045e5..278dd9cd3 100644
--- a/drivers/misc/mediatek/imgsensor/src/mt6761/camera_hw/imgsensor_cfg_table.c
+++ b/drivers/misc/mediatek/imgsensor/src/mt6761/camera_hw/imgsensor_cfg_table.c
@@ -28,9 +28,22 @@ struct IMGSENSOR_HW_CFG imgsensor_custom_config[] = {
 		IMGSENSOR_I2C_DEV_0,
 		{
 			{IMGSENSOR_HW_ID_MCLK, IMGSENSOR_HW_PIN_MCLK},
-			{IMGSENSOR_HW_ID_REGULATOR, IMGSENSOR_HW_PIN_AVDD},
+			/*
+			 * BF7: раздача выводов питания взята с общей площадки
+			 * mt6761 и нашей плате не соответствует. По дереву
+			 * устройств (kd_camera_hw1@15040000) у нас так:
+			 *   аналоговое AVDD  — ножкой, есть pinctrl
+			 *                      cam0_vcama_on/cam0_vcama_off;
+			 *   цифровое  DVDD  — от PMIC, cam0_vcamd-supply;
+			 *   ввод-вывод DOVDD — от PMIC, cam0_vcamio-supply.
+			 * До правки AVDD искали у регулятора с именем
+			 * cam0_vcama, которого в дереве нет, получали NULL
+			 * ("regulator == NULL 0 3 3" в журнале) и шли дальше
+			 * без питания — сенсор молчал по I2C.
+			 */
+			{IMGSENSOR_HW_ID_GPIO, IMGSENSOR_HW_PIN_AVDD},
