#!/usr/bin/env python3
"""Сторож голосового разговора: хозяин звонит — телефон берёт трубку
(bf7-hozyain), здесь — приветствие и слух; отвечает Клауд (skazat-pc).

Строки для Клауда (stdout): «ЗВОНОК …», «СОБЕСЕДНИК: …», «РАЗГОВОР ОКОНЧЕН».
Работает бесконечно: после разговора снова ждёт звонка.
"""
import os, subprocess, sys, time

G = os.path.dirname(os.path.abspath(__file__))

def p(s):
    print("%s %s" % (time.strftime("%H:%M:%S"), s), flush=True)

def razgovor_idet():
    r = subprocess.run(["ssh", "-o", "ConnectTimeout=5", "bf7",
        "for q in /proc/[0-9]*; do tr '\\0' ' ' < $q/cmdline 2>/dev/null | grep -q '^/usr/local/bin/bf7-rech zvonok' && exit 0; done; exit 1"])
    return r.returncode == 0

def razgovor():
    for _ in range(20):                      # тракт разговора поднимается за 1–3 с
        if razgovor_idet():
            break
        time.sleep(0.5)
    subprocess.run([os.path.join(G, "skazat-pc"), "Алло! Это Клауд. Слушаю тебя."],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    s = subprocess.Popen([os.path.join(G, "sluh-pc")], stdout=subprocess.PIPE, text=True)
    for line in s.stdout:
        line = line.rstrip()
        if "СОБЕСЕДНИК:" in line:
            print(line, flush=True)
    s.wait()
    p("РАЗГОВОР ОКОНЧЕН")

def pulsirovat():
    # Отметка «Клауд на связи» для bf7-hozyain: без неё трубку он не берёт.
    while True:
        subprocess.run(["ssh", "-o", "ConnectTimeout=5", "bf7", "touch /run/bf7-klaud-na-svyazi"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(30)

def main():
    import threading
    threading.Thread(target=pulsirovat, daemon=True).start()
    p("жду звонка хозяина")
    while True:
        t = subprocess.Popen(["ssh", "-o", "ServerAliveInterval=15", "bf7",
                              "touch /run/bf7-dialog.log; exec tail -n0 -F /run/bf7-dialog.log"],
                             stdout=subprocess.PIPE, text=True)
        for line in t.stdout:
            if "ЗВОНОК:" in line:
                p(line.split(" ", 1)[1].strip())
                if "принят" in line:
                    razgovor()
                    p("жду звонка хозяина")
        t.wait()
        time.sleep(5)                        # связь с телефоном прервалась — снова

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass
