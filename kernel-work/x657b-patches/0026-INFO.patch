mtk_charger ставил себе CHRLOG_DEBUG_LEVEL в пробе — отладочная печать
шла всегда, в том числе на каждое чтение свойства (upower читает их
постоянно). Теперь INFO; подробность — echo 3 > charger_log_level.
psy_charger_get_property и psy_chr_type_get_property печатают через
отладочный уровень.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/mt6357-charger-type.c |  3 ++-
 drivers/power/supply/mtk_charger.c         | 10 ++++++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/mt6357-charger-type.c b/drivers/power/supply/mt6357-charger-type.c
index bace82668..28e8d840f 100644
--- a/drivers/power/supply/mt6357-charger-type.c
+++ b/drivers/power/supply/mt6357-charger-type.c
@@ -634,7 +634,8 @@ static int psy_chr_type_get_property(struct power_supply *psy,
 	struct mtk_charger_type *info;
 	int vbus = 0;
 
-	pr_notice("%s: prop:%d\n", __func__, psp);
+	/* BF7: на каждое чтение свойства — upower читает их постоянно */
+	pr_debug("%s: prop:%d\n", __func__, psp);
 	info = (struct mtk_charger_type *)power_supply_get_drvdata(psy);
 
 	switch (psp) {
diff --git a/drivers/power/supply/mtk_charger.c b/drivers/power/supply/mtk_charger.c
index 4579ce6bd..4b802ffdb 100644
--- a/drivers/power/supply/mtk_charger.c
+++ b/drivers/power/supply/mtk_charger.c
@@ -1879,7 +1879,8 @@ static int psy_charger_get_property(struct power_supply *psy,
 
 	info = (struct mtk_charger *)power_supply_get_drvdata(psy);
 
-	chr_err("%s psp:%d\n",
+	/* BF7: каждое чтение свойства — upower читает их постоянно */
+	chr_debug("%s psp:%d\n",
 		__func__, psp);
 
 
@@ -2184,7 +2185,12 @@ static int mtk_charger_probe(struct platform_device *pdev)
 		chr_err("register psy2 fail:%d\n",
 			PTR_ERR(info->psy2));
 
-	info->log_level = CHRLOG_DEBUG_LEVEL;
+	/*
+	 * BF7: было CHRLOG_DEBUG_LEVEL — отладочная печать шла в журнал всегда.
+	 * Подробность возвращается на лету:
+	 * echo 3 > /sys/devices/platform/charger/charger_log_level
+	 */
+	info->log_level = CHRLOG_INFO_LEVEL;
 
 	info->pd_adapter = get_adapter_by_name("pd_adapter");
 	if (!info->pd_adapter)
