---
 drivers/misc/mediatek/leds/leds-mt6357.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/misc/mediatek/leds/leds-mt6357.c b/drivers/misc/mediatek/leds/leds-mt6357.c
index 6df9d96dc..6a081e738 100644
--- a/drivers/misc/mediatek/leds/leds-mt6357.c
+++ b/drivers/misc/mediatek/leds/leds-mt6357.c
@@ -1105,6 +1105,18 @@ static int mt6357_led_hw_on(struct led_classdev *cdev,
 	return 0;
 }
 
+/*
+ * BF7: огонёк уведомлений на ISINK1 включён наоборот — горит при яркости 0 и
+ * гаснет при любом включении ISINK1 (камера, 2026-09-23 и 2026-09-30). В покое
+ * он светится постоянно, а мигание feedbackd не видно. С bf7_invert_isink1=1 в
+ * железо уходит max − яркость: в покое тёмный, при уведомлении вспыхивает.
+ * По умолчанию выключено, пока не подтверждено без кабеля. Включить:
+ *   echo 1 > /sys/module/leds_mt6357/parameters/bf7_invert_isink1
+ * (новое значение применяется со следующей записи яркости).
+ */
+static bool bf7_invert_isink1;
+module_param(bf7_invert_isink1, bool, 0644);
+
 static void mt6357_led_set_brightness(struct led_classdev *cdev,
 				     enum led_brightness brightness)
 {
@@ -1113,6 +1125,9 @@ static void mt6357_led_set_brightness(struct led_classdev *cdev,
 	struct mt6357_leds *leds = led->parent;
 	int ret;
 
+	if (bf7_invert_isink1 && led->id == MT6357_ISINK1)
+		brightness = cdev->max_brightness - brightness;
+
 	mutex_lock(&leds->lock);
 
 	if (!led->current_brightness && brightness) {
