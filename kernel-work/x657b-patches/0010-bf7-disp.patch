TINYDRM_MODE ставит пиксельную частоту в 1 кГц «лишь бы прошло
проверку», и режим объявлял обновление 1 мГц. GTK брал это за период
кадра и назначал следующую отрисовку через тысячу секунд — окна казались
замёрзшими, хотя программы работали. Теперь clock = 60·w·h/1000,
vrefresh = 60.

Там же защита от вечного ожидания: вендорский запуск кадра может не
вернуться, когда панелью владеет другой сеанс, и держит замок смены
режима. Второй и следующие вызовы теперь сразу отвечают отказом, а не
копятся в очереди без права быть убитыми.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mediatek/video/mt6765/videox/bf7_drm.c    | 63 ++++++++++++++++++-
 1 file changed, 62 insertions(+), 1 deletion(-)

diff --git a/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c b/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
index db9998317..e47290747 100644
--- a/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
+++ b/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
@@ -55,6 +55,19 @@ struct bf7_drm_device {
 	bool enabled;
 	bool direct_announced;
 
+	/*
+	 * Показ уже идёт.
+	 *
+	 * Вендорский запуск кадра блокирующий и, когда панелью владеет другой
+	 * сеанс (композитор выводит слоем наложения через /dev/mtk_disp_mgr),
+	 * может не вернуться вовсе. Один застрявший поток держал бы замок
+	 * смены режима, и всякий, кто потом хоть что-то спросит у card1,
+	 * встал бы в очередь навсегда и без права быть убитым — так у нас
+	 * намертво повисло пять посторонних программ. Поэтому второй и
+	 * следующие вызовы не ждут, а сразу отвечают отказом.
+	 */
+	atomic_t posting;
+
 	/*
 	 * Собственный буфер вывода.
 	 *
@@ -192,13 +205,24 @@ static int bf7_post_frame(struct bf7_drm_device *bf7, unsigned int mva,
 	in->next_buff_idx = -1;
 	in->ext_sel_layer = -1;
 
+	/*
+	 * Отмечаемся на всё время работы с вендорским трактом: и настройка
+	 * слоя, и запуск кадра берут его замок, и любой из них может не
+	 * вернуться, если панелью владеет другой сеанс. По этой отметке
+	 * следующие вызовы сразу отвечают отказом вместо того, чтобы копиться
+	 * в очереди за замком смены режима.
+	 */
+	atomic_set(&bf7->posting, 1);
+
 	ret = primary_display_config_input_multiple(cfg);
 	if (ret) {
 		DRM_ERROR("bf7: настройка слоя отказала: %d\n", ret);
+		atomic_set(&bf7->posting, 0);
 		goto out;
 	}
 
 	ret = primary_display_trigger(1 /* блокирующий */, NULL, 0);
+	atomic_set(&bf7->posting, 0);
 	if (ret) {
 		DRM_ERROR("bf7: запуск кадра отказал: %d\n", ret);
 	} else {
@@ -437,7 +461,30 @@ static int bf7_fb_dirty(struct drm_framebuffer *fb,
 	struct drm_gem_object *obj;
 	int ret;
 
-	mutex_lock(&tdev->dirty_lock);
+	/*
+	 * Ждать замок бесконечно нельзя: этот вызов приходит из ioctl,
+	 * который держит замок смены режима всего устройства DRM.
+	 */
+	if (!mutex_trylock(&tdev->dirty_lock)) {
+		unsigned long deadline = jiffies + msecs_to_jiffies(100);
+		bool got = false;
+
+		while (time_before(jiffies, deadline)) {
+			if (mutex_trylock(&tdev->dirty_lock)) {
+				got = true;
+				break;
+			}
+			usleep_range(1000, 2000);
+		}
+		if (!got)
+			return -EBUSY;
+	}
+
+	/* Предыдущий показ не вернулся — новый не начинаем. */
+	if (atomic_read(&bf7->posting)) {
+		ret = -EBUSY;
+		goto out;
+	}
 
 	if (!bf7->enabled) {
 		/* Панель выключена: кадр показывать некому, но это не ошибка. */
@@ -787,6 +834,20 @@ static int bf7_drm_probe(struct platform_device *pdev)
 	bf7->mode.vdisplay = bf7->mode.vsync_start = bf7->mode.vsync_end =
 		bf7->mode.vtotal = h;
 
+	/*
+	 * Частота обновления. TINYDRM_MODE ставит пиксельную частоту в один
+	 * килогерц — «лишь бы прошло проверку». Из неё считается частота
+	 * обновления экрана: 1000/(720·1612) ≈ 0,00086 Гц, и наружу уходит
+	 * 1 мГц. GTK берёт эту величину за период кадра и назначает следующую
+	 * отрисовку через тысячу секунд: окно выглядит намертво замёрзшим,
+	 * хотя приложение работает и всё считает правильно. Так «глотала
+	 * нажатия» оболочка и «подтормаживал» браузер.
+	 *
+	 * Ставим настоящие 60 Гц: clock в килогерцах = 60 · htotal · vtotal.
+	 */
+	bf7->mode.clock = 60u * w * h / 1000u;
+	bf7->mode.vrefresh = 60;
+
 	ret = bf7_alloc_scanout(dev, bf7);
 	if (ret) {
 		dev_err(dev, "буфер вывода не готов: %d\n", ret);
-- 
