 =?UTF-8?q?=D1=82=D1=8C=20=D1=85=D0=B2=D0=BE=D1=81=D1=82=D1=8B=20=D0=B7?=
 =?UTF-8?q?=D0=B0=D0=BF=D0=B8=D1=81=D0=B5=D0=B9,=20=D0=BD=D0=B5=20=D0=BA?=
 =?UTF-8?q?=D1=80=D0=B0=D1=82=D0=BD=D1=8B=D0=B5=2016=20=D0=B1=D0=B0=D0=B9?=
 =?UTF-8?q?=D1=82=D0=B0=D0=BC=20(DL1=20=D0=B8=20=D0=BE=D0=B1=D1=89=D0=B8?=
