RetroArch: 1408 из 4500 записей за 10 с не кратны 16, 11552 байта терялось —
звук заедал, [AudioWarn] u4DataRemained < 0. Копия идёт через посредника и
memcpy_toio, выравнивание не нужно.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mediatek/common_int/mtk-soc-afe-control.c    | 16 ++++++++++++----
 sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c  | 16 ++++++++++++----
 2 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/sound/soc/mediatek/common_int/mtk-soc-afe-control.c b/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
index 42b88425d..dd17c097d 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
@@ -4677,7 +4677,16 @@ static int mtk_mem_dlblk_copy(struct snd_pcm_substream *substream, int channel,
 			copy_size = count;
 	}
 
-	copy_size = word_size_align(copy_size);
+	/*
+	 * BF7: без word_size_align. Округление вниз до 16 байт молча отбрасывало
+	 * до 12 байт каждой записи, не кратной 4 стереокадрам, — ALSA считала их
+	 * записанными, а свой указатель записи драйвера отставал. Пока программа
+	 * часто спрашивает время (RetroArch, GStreamer), PulseAudio пишет мелкими
+	 * кусками, учёт расползался до недоигрывания: [AudioWarn] u4DataRemained
+	 * < 0, а на слух — звук «проглатывается» и заедает. Выравнивать незачем:
+	 * запись идёт через посредника и memcpy_toio (bf7_copy_from_user_io),
+	 * который сам выравнивается по стороне устройства.
+	 */
 
 	if (copy_size != 0) {
 		mem_blk_spinlock(mem_blk);
@@ -4724,9 +4733,8 @@ static int mtk_mem_dlblk_copy(struct snd_pcm_substream *substream, int channel,
 		} else { /* copy twice */
 			kal_uint32 size_1 = 0, size_2 = 0;
 
-			size_1 = word_size_align(
-				(Afe_Block->u4BufferSize - Afe_WriteIdx_tmp));
-			size_2 = word_size_align((copy_size - size_1));
+			size_1 = Afe_Block->u4BufferSize - Afe_WriteIdx_tmp;
+			size_2 = copy_size - size_1;
 #ifdef AFE_CONTROL_DEBUG_LOG
 			pr_debug("size_1=0x%x, size_2=0x%x\n", size_1,
 				 size_2);
diff --git a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
index e3319bbca..d3d8ab72a 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
@@ -402,7 +402,16 @@ static int mtk_pcm_copy(struct snd_pcm_substream *substream,
 			copy_size = count;
 	}
 
-	copy_size = word_size_align(copy_size);
+	/*
+	 * BF7: без word_size_align — это путь MultiMedia1 (hw:0,0), им играет
+	 * PulseAudio. Округление вниз до 16 байт молча отбрасывало хвост каждой
+	 * записи, не кратной 4 стереокадрам; ALSA считала его записанным. Замер
+	 * kprobe 2026-09-24: RetroArch — 1408 из 4500 записей за 10 с не кратны
+	 * 16, потеряно 11552 байта (у paplay — 0 из 945). На слух: звук
+	 * «проглатывается» и заедает, в журнале [AudioWarn] u4DataRemained < 0.
+	 * Выравнивать незачем: bf7_copy_from_user_io идёт через посредника и
+	 * memcpy_toio, который выравнивается по стороне устройства.
+	 */
 #ifdef DL1_DEBUG_LOG
 	pr_debug("copy_size=0x%x, count=0x%x\n", copy_size,
 		       (unsigned int)count);
@@ -460,9 +469,8 @@ static int mtk_pcm_copy(struct snd_pcm_substream *substream,
 			/* copy twice */
 			kal_uint32 size_1 = 0, size_2 = 0;
 
-			size_1 = word_size_align(
-				(Afe_Block->u4BufferSize - Afe_WriteIdx_tmp));
-			size_2 = word_size_align((copy_size - size_1));
+			size_1 = Afe_Block->u4BufferSize - Afe_WriteIdx_tmp;
+			size_2 = copy_size - size_1;
 #ifdef DL1_DEBUG_LOG
 			pr_debug("size_1=0x%x, size_2=0x%x\n", size_1,
 				       size_2);
