diff --git a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
index c14bf2532..1bb8197fc 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
@@ -163,10 +163,12 @@ static snd_pcm_uframes_t mtk_pcm_pointer(struct snd_pcm_substream *substream)
  * SRAM отображена как память устройства: каждая 8-байтовая запись memcpy_toio
  * идёт отдельной транзакцией, ~6 МБ/с. Замер perf 2026-09-25: треть времени
  * PulseAudio при воспроизведении — в __memcpy_toio, ~3% ядра непрерывно.
- * DRAM из dma_alloc_coherent — Normal-NC, записи склеиваются. SRAM нужна
- * MediaTek, чтобы DRAM спала во время музыки при погашенном экране; у нас
- * звук во сне не играет. Выключить на лету (со следующего открытия
- * устройства): echo 0 > /sys/module/mtk_soc_pcm_dl1/parameters/bf7_dl1_dram
+ * DRAM из dma_alloc_coherent — Normal-NC, записи склеиваются. Цена: ветка
+ * DRAM держит spm_resource_req(AUDIO, DRAM), и пока играет звук, память не
+ * уходит в самообновление (ради этого MediaTek и держит DL1 в SRAM). Что
+ * выгоднее при погашенном экране — решает замер тока; переключается на лету
+ * со следующего открытия устройства:
+ *   echo 0 > /sys/module/mtk_soc_pcm_dl1/parameters/bf7_dl1_dram
  */
 static bool bf7_dl1_dram = true;
 module_param(bf7_dl1_dram, bool, 0644);
