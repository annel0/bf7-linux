Subject: [PATCH 33/40] =?UTF-8?q?BF7:=20=D0=BF=D0=BE=D1=82=D0=BE=D0=BA?=
 =?UTF-8?q?=D0=B8=20=D1=8F=D0=B4=D1=80=D0=B0=20MediaTek=20=D0=B6=D0=B4?=
 =?UTF-8?q?=D1=83=D1=82=20=D0=B2=20TASK=5FIDLE=20=E2=80=94=20load=20averag?=
 =?UTF-8?q?e=2014=20=D0=B2=20=D0=BF=D0=BE=D0=BA=D0=BE=D0=B5=20=D1=83=D1=85?=
 =?UTF-8?q?=D0=BE=D0=B4=D0=B8=D1=82?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

hang_detect, ccci_poll, rpmb_open (request_send), battery/power_misc,
gauge_coulomb, charger: msleep → schedule_timeout_idle,
wait_event → wait_event_idle. disp_idlemgr/disp_check: общий макрос
ожидания состояния → wait_event_idle_timeout. decouple_trigger:
wait_event_idle. tee_irq_bh: killable → interruptible (сигналов у потока
нет). sspm_ipi_recv_wait: interruptible только для потоков ядра.
ddp_irq_log_kthread больше не создаётся — MediaTek его не запускал.
Ни один из потоков не замораживаемый, ложных сигналов нет.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/misc/mediatek/eccci/fsm/ccci_fsm_poller.c   |  3 ++-
 drivers/misc/mediatek/monitor_hang/monitor_hang.c   |  9 +++++++--
 drivers/misc/mediatek/sspm/sspm_ipi_mbox.c          | 10 +++++++++-
 .../misc/mediatek/video/mt6765/dispsys/ddp_irq.c    | 13 +++++++------
 .../mediatek/video/mt6765/videox/primary_display.c  |  5 +++--
 drivers/power/supply/mtk_battery.c                  |  5 +++--
 drivers/power/supply/mtk_battery_coulomb_service.c  |  3 ++-
 drivers/power/supply/mtk_charger.c                  |  7 ++++---
 drivers/tee/gud/500/MobiCoreDriver/admin.c          |  2 +-
 drivers/tee/gud/500/MobiCoreDriver/nq.c             |  3 ++-
 sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c     | 10 ++++++----
 11 files changed, 46 insertions(+), 24 deletions(-)

diff --git a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_poller.c b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_poller.c
index e82ecfbaf..0c200ea48 100644
--- a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_poller.c
+++ b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_poller.c
@@ -136,7 +136,8 @@ static int fsm_poll_main(void *data)
 			}
 		}
 next:
-		msleep(POLLING_INTERVAL_TIME);
+		/* BF7: TASK_IDLE — не в load average (см. monitor_hang.c) */
+		schedule_timeout_idle(msecs_to_jiffies(POLLING_INTERVAL_TIME));
 	}
 	return 0;
 }
diff --git a/drivers/misc/mediatek/monitor_hang/monitor_hang.c b/drivers/misc/mediatek/monitor_hang/monitor_hang.c
index c4230c7cf..19f22e591 100644
--- a/drivers/misc/mediatek/monitor_hang/monitor_hang.c
+++ b/drivers/misc/mediatek/monitor_hang/monitor_hang.c
@@ -1940,7 +1940,12 @@ static int hang_detect_thread(void *arg)
 
 	sched_setscheduler(current, SCHED_FIFO, &param);
 	reset_hang_info();
-	msleep(120 * 1000);
+	/*
+	 * BF7: спать TASK_IDLE, а не msleep (TASK_UNINTERRUPTIBLE). Поведение то
+	 * же, но поток не попадает в load average: 13 таких потоков MediaTek
+	 * держали его на 14 в полном покое.
+	 */
+	schedule_timeout_idle(msecs_to_jiffies(120 * 1000));
 	pr_debug("[Hang_Detect] hang_detect thread starts.\n");
 
 #ifdef BOOT_UP_HANG
@@ -2000,7 +2005,7 @@ static int hang_detect_thread(void *arg)
 			hang_detect_counter--;
 		}
 
-		msleep((HD_INTER) * 1000);
+		schedule_timeout_idle(msecs_to_jiffies((HD_INTER) * 1000));
 	}
 	return 0;
 }
diff --git a/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c b/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
index d9a6986e6..111c88c82 100644
--- a/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
+++ b/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
@@ -365,7 +365,15 @@ int sspm_ipi_recv_wait(int mid)
 		return IPI_SERVICE_NOT_AVAILABLE;
 
 	pin = &(recv_pintable[mid]);
-	wait_for_completion(&sema_ipi_task[mid]);
+	/*
+	 * BF7: поток ядра ждёт здесь вечно (ipi_cpu_dvfs_rt) и сидел в load
+	 * average. Сигналов у потоков ядра нет, поэтому для них interruptible —
+	 * то же ожидание; обычным процессам оставлено прежнее.
+	 */
+	if (current->flags & PF_KTHREAD)
+		wait_for_completion_interruptible(&sema_ipi_task[mid]);
+	else
+		wait_for_completion(&sema_ipi_task[mid]);
 
 	/* if the pin is waiting async data, eliminate multiple completions */
 	if (pin->act->lock)
diff --git a/drivers/misc/mediatek/video/mt6765/dispsys/ddp_irq.c b/drivers/misc/mediatek/video/mt6765/dispsys/ddp_irq.c
index 62ff88c25..aa94d8578 100644
--- a/drivers/misc/mediatek/video/mt6765/dispsys/ddp_irq.c
+++ b/drivers/misc/mediatek/video/mt6765/dispsys/ddp_irq.c
@@ -546,11 +546,12 @@ int disp_init_irq(void)
 
 	/* create irq log thread */
 	init_waitqueue_head(&disp_irq_log_wq);
-	disp_irq_log_task = kthread_create(disp_irq_log_kthread_func,
-		NULL, "ddp_irq_log_kthread");
-	if (IS_ERR(disp_irq_log_task))
-		DDPERR(" can not create disp_irq_log_task kthread\n");
-
-	/* wake_up_process(disp_irq_log_task); */
+	/*
+	 * BF7: поток не создаём. MediaTek его не запускает (wake_up_process
+	 * закомментирован), и он висел в TASK_UNINTERRUPTIBLE со старта,
+	 * добавляя единицу к load average.
+	 */
+	(void)disp_irq_log_task;
+	(void)disp_irq_log_kthread_func;
 	return 0;
 }
diff --git a/drivers/misc/mediatek/video/mt6765/videox/primary_display.c b/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
index da716c242..63a436995 100644
--- a/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
+++ b/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
@@ -555,8 +555,9 @@ void debug_print_power_mode_check(enum mtkfb_power_mode prev,
 /* use MAX_SCHEDULE_TIMEOUT to wait for ever
  * NOTES: primary_path_lock should NOT be held when call this func !!!!!!!!
  */
+/* BF7: _idle — то же ожидание, но не в load average (disp_idlemgr, disp_check) */
 #define __primary_display_wait_state(condition, timeout) \
-	wait_event_timeout(display_state_wait_queue, condition, timeout)
+	wait_event_idle_timeout(display_state_wait_queue, condition, timeout)
 
 long primary_display_wait_state(enum DISP_POWER_STATE state, long timeout)
 {
@@ -5530,7 +5531,7 @@ static int decouple_trigger_worker_thread(void *data)
 	sched_setscheduler(current, SCHED_RR, &param);
 
 	while (1) {
-		wait_event(decouple_trigger_wq,
+		wait_event_idle(decouple_trigger_wq,	/* BF7: не в load average */
 			atomic_read(&decouple_trigger_event));
 		dpmgr_wait_event(pgc->dpmgr_handle, DISP_PATH_EVENT_IF_VSYNC);
 
