index a82703005..42b88425d 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
@@ -73,6 +73,89 @@
 #include <mtk_vcorefs_manager.h>
 #endif
 
+/*
+ * BF7: обмен с буфером DMA звука в обход выравнивания.
+ *
+ * Буфер AFE отображён как память устройства — об этом прямо сказано ниже, у
+ * word_size_align. Такая память принимает только естественно выровненные
+ * доступы, а copy_from_user/copy_to_user на arm64 этого не обещают:
+ * реализация выравнивается по **источнику**, а на другой стороне работает
+ * восьмибайтовыми и парными командами по любому адресу.
+ *
+ * Поэтому выравнивать свою сторону бесполезно — проверено на живом телефоне:
+ * побайтовые края с выровненной серединой дали ту же панику по тому же
+ * адресу. Нужен посредник в обычной памяти и memcpy_toio/memcpy_fromio,
+ * которые выравниваются именно по стороне устройства.
+ *
+ * Роняется по заказу (до правки):
+ *   aplay   -D hw:0,0 -f S16_LE -r 48000 -c 2 \
+ *           --period-size=1021 --buffer-size=4084 /dev/urandom
+ *   arecord -D hw:0,1 -f S16_LE -r 48000 -c 2 \
+ *           --period-size=33 --buffer-size=133 -d 4 /dev/null
+ * Первое давало ESR 0x96000021 на записи, второе — на чтении.
+ */
+#define BF7_BOUNCE_SIZE 4096
+
+int bf7_copy_from_user_io(void *dst, const void __user *src, unsigned long bytes)
+{
+	void *bounce;
+	int ret = 0;
+
+	bounce = kmalloc(BF7_BOUNCE_SIZE, GFP_KERNEL);
+	if (!bounce)
+		return -ENOMEM;
+
+	while (bytes) {
+		unsigned long chunk = bytes;
+
+		if (chunk > BF7_BOUNCE_SIZE)
+			chunk = BF7_BOUNCE_SIZE;
+
+		if (copy_from_user(bounce, src, chunk)) {
+			ret = -EFAULT;
+			break;
+		}
+		memcpy_toio((void __iomem *)dst, bounce, chunk);
+
+		dst = (char *)dst + chunk;
+		src = (const char __user *)src + chunk;
+		bytes -= chunk;
+	}
+
+	kfree(bounce);
+	return ret;
+}
+
+int bf7_copy_to_user_io(void __user *dst, const void *src, unsigned long bytes)
+{
+	void *bounce;
+	int ret = 0;
+
+	bounce = kmalloc(BF7_BOUNCE_SIZE, GFP_KERNEL);
+	if (!bounce)
+		return -ENOMEM;
+
+	while (bytes) {
+		unsigned long chunk = bytes;
+
+		if (chunk > BF7_BOUNCE_SIZE)
+			chunk = BF7_BOUNCE_SIZE;
+
+		memcpy_fromio(bounce, (const void __iomem *)src, chunk);
+		if (copy_to_user(dst, bounce, chunk)) {
+			ret = -EFAULT;
+			break;
+		}
+
+		dst = (char __user *)dst + chunk;
+		src = (const char *)src + chunk;
+		bytes -= chunk;
+	}
+
+	kfree(bounce);
+	return ret;
+}
+
 static DEFINE_SPINLOCK(afe_control_lock);
 static DEFINE_SPINLOCK(afe_sram_control_lock);
 static DEFINE_SPINLOCK(afe_mem_blk_dl1_lock);
@@ -4616,7 +4699,7 @@ static int mtk_mem_dlblk_copy(struct snd_pcm_substream *substream, int channel,
 					Afe_WriteIdx_tmp,
 					data_w_ptr, copy_size);
 #endif
-				if (copy_from_user((Afe_Block->pucVirtBufAddr +
+				if (bf7_copy_from_user_io((Afe_Block->pucVirtBufAddr +
 						    Afe_WriteIdx_tmp),
 						   data_w_ptr, copy_size)) {
 					pr_warn("[AudioWarn] Fail copy from user\n");
@@ -4661,7 +4744,7 @@ static int mtk_mem_dlblk_copy(struct snd_pcm_substream *substream, int channel,
 					Afe_WriteIdx_tmp,
 					data_w_ptr, size_1);
 #endif
-				if ((copy_from_user((Afe_Block->pucVirtBufAddr +
+				if ((bf7_copy_from_user_io((Afe_Block->pucVirtBufAddr +
 						     Afe_WriteIdx_tmp),
 						    data_w_ptr, size_1))) {
 					pr_warn(" Fail 1 copy from user");
@@ -4690,7 +4773,7 @@ static int mtk_mem_dlblk_copy(struct snd_pcm_substream *substream, int channel,
 					Afe_WriteIdx_tmp,
 					data_w_ptr + size_1, size_2);
 #endif
-				if ((copy_from_user((Afe_Block->pucVirtBufAddr +
+				if ((bf7_copy_from_user_io((Afe_Block->pucVirtBufAddr +
 						     Afe_WriteIdx_tmp),
 						    (data_w_ptr + size_1),
 						    size_2))) {
@@ -4798,7 +4881,7 @@ static int mtk_mem_ulblk_copy(struct snd_pcm_substream *substream, int channel,
 				DMA_Read_Ptr, Vul_Block->u4DMAReadIdx);
 		}
 
-		if (copy_to_user((void __user *)Read_Data_Ptr,
+		if (bf7_copy_to_user_io((void __user *)Read_Data_Ptr,
 				 (Vul_Block->pucVirtBufAddr + DMA_Read_Ptr),
 				 read_size)) {
 
@@ -4839,7 +4922,7 @@ static int mtk_mem_ulblk_copy(struct snd_pcm_substream *substream, int channel,
 				__func__, size_1, Vul_Block->u4DataRemained,
 				DMA_Read_Ptr, Vul_Block->u4DMAReadIdx);
 		}
-		if (copy_to_user((void __user *)Read_Data_Ptr,
+		if (bf7_copy_to_user_io((void __user *)Read_Data_Ptr,
 				 (Vul_Block->pucVirtBufAddr + DMA_Read_Ptr),
 				 (unsigned int)size_1)) {
 
@@ -4870,7 +4953,7 @@ static int mtk_mem_ulblk_copy(struct snd_pcm_substream *substream, int channel,
 				__func__, size_2, Vul_Block->u4DataRemained,
 				DMA_Read_Ptr, Vul_Block->u4DMAReadIdx);
 		}
-		if (copy_to_user((void __user *)(Read_Data_Ptr + size_1),
+		if (bf7_copy_to_user_io((void __user *)(Read_Data_Ptr + size_1),
 				 (Vul_Block->pucVirtBufAddr + DMA_Read_Ptr),
 				 size_2)) {
 
