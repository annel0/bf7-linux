tscpu_polling_factor1 1 -> 5: между 20 и 40 C опрос был таким же частым, как
в жару (200 мс). Монитор трафика CCIF будил процессор и писал 3-5 строк
в журнал каждые 10 с; теперь только при traffic_log=1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../misc/mediatek/eccci/hif/ccci_hif_ccif.c   | 19 +++++++++++++++----
 .../misc/mediatek/thermal/mt6761/src/mtk_tc.c |  9 ++++++++-
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
index 4891c6eff..d2bb74fa4 100644
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
@@ -752,6 +752,15 @@ static int ccif_check_flow_ctrl(struct md_ccif_ctrl *md_ctrl,
 	return ret;
 }
 
+/*
+ * BF7: the traffic monitor is a debug dump - every 10 s it woke the CPU and
+ * logged the port status, ccmni counters and per-queue interrupt counts (three
+ * to five kernel log lines, written to eMMC by journald). Off unless asked
+ * for: echo 1 > /sys/module/ccci_hif_all/parameters/traffic_log
+ */
+static bool bf7_traffic_log;
+module_param_named(traffic_log, bf7_traffic_log, bool, 0644);
+
 static void md_ccif_traffic_work_func(struct work_struct *work)
 {
 	struct ccci_hif_traffic *traffic_inf =
@@ -841,8 +850,9 @@ static void md_ccif_traffic_work_func(struct work_struct *work)
 	kfree(string);
 	kfree(string_temp);
 
-	mod_timer(&md_ctrl->traffic_monitor,
-		jiffies + CCIF_TRAFFIC_MONITOR_INTERVAL * HZ);
+	if (bf7_traffic_log)
+		mod_timer(&md_ctrl->traffic_monitor,
+			jiffies + CCIF_TRAFFIC_MONITOR_INTERVAL * HZ);
 }
 
 static void md_ccif_traffic_monitor_func(struct timer_list *t)
@@ -1148,8 +1158,9 @@ void md_ccif_reset_queue(unsigned char hif_id, unsigned char for_start)
 	unsigned long flags;
 
 	if (for_start) {
-		mod_timer(&md_ctrl->traffic_monitor,
-			jiffies + CCIF_TRAFFIC_MONITOR_INTERVAL * HZ);
+		if (bf7_traffic_log)
+			mod_timer(&md_ctrl->traffic_monitor,
+				jiffies + CCIF_TRAFFIC_MONITOR_INTERVAL * HZ);
 	} else {
 		del_timer(&md_ctrl->traffic_monitor);
 		/*
diff --git a/drivers/misc/mediatek/thermal/mt6761/src/mtk_tc.c b/drivers/misc/mediatek/thermal/mt6761/src/mtk_tc.c
index a3f545de3..8b93be33f 100644
--- a/drivers/misc/mediatek/thermal/mt6761/src/mtk_tc.c
+++ b/drivers/misc/mediatek/thermal/mt6761/src/mtk_tc.c
@@ -161,7 +161,14 @@ static __u32 calefuse3;
 /* chip dependent */
 int tscpu_polling_trip_temp1 = 40000;
 int tscpu_polling_trip_temp2 = 20000;
-int tscpu_polling_factor1 = 1;
+/*
+ * BF7: was 1 - between 20 and 40 C the CPU zone was polled as often as when
+ * hot (every 200 ms, the interval thermal_manager sets for ATM), which with
+ * the screen off was the most frequent work item left (8.5/s together with
+ * the other zones). Throttling starts at 54 C and at 40 C the factor drops
+ * back to the full rate, so 1 s below 40 C loses nothing.
+ */
+int tscpu_polling_factor1 = 5;
 int tscpu_polling_factor2 = 4;
 
 #if MTKTSCPU_FAST_POLLING
