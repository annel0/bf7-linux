g_ta_status не сбрасывается до перезагрузки — одна давняя ошибка
печаталась каждый третий вызов вечно; теперь только новое. Об отсутствии
thermalloadalgod — один раз до его регистрации. -ECONNREFUSED от
netlink_unicast означает, что демон умер: g_tad_pid обнуляется. В BTS и
DCTM «out of memory» только при настоящей -ENOMEM.

Проверено на телефоне: за загрузку две строки вместо ~24 в минуту.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mediatek/thermal/common/coolers/mtk_ta.c  | 26 ++++++++++++++++---
 .../thermal/common/thermal_zones/mtk_ts_bts.c |  3 ++-
 .../common/thermal_zones/mtk_ts_dctm.c        |  3 ++-
 3 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/mediatek/thermal/common/coolers/mtk_ta.c b/drivers/misc/mediatek/thermal/common/coolers/mtk_ta.c
index 6ffa82ed9..503f9d0c4 100644
--- a/drivers/misc/mediatek/thermal/common/coolers/mtk_ta.c
+++ b/drivers/misc/mediatek/thermal/common/coolers/mtk_ta.c
@@ -77,6 +77,9 @@ struct SPA_T thermal_spa_t;
 struct DCTM_T thermal_dctm_t;
 static struct tad_nl_msg_t tad_ret_msg;
 static unsigned int g_ta_status;
+/* BF7: последний напечатанный статус и «про отсутствие демона уже сказали» */
+static unsigned int g_ta_status_printed;
+static bool g_ta_no_daemon_told;
 static int g_ta_counter;
 /*=============================================================
  *Local function prototype
@@ -194,6 +197,7 @@ void atm_ctrl_cmd_from_user(void *nl_data, struct tad_nl_msg_t *ret_msg)
 		{
 			memcpy(&g_tad_pid, &msg->tad_data[0],
 						sizeof(g_tad_pid));
+			g_ta_no_daemon_told = false;
 
 			tsta_dprintk(
 				"[%s] g_tad_pid = %d\n", __func__,
@@ -316,6 +320,12 @@ static void ta_nl_send_to_user(int pid, int seq, struct tad_nl_msg_t *reply_msg)
 	if (ret < 0) {
 		g_ta_status = g_ta_status | 0x00000010;
 		pr_notice("[%s] send failed %d\n", __func__, ret);
+		/*
+		 * BF7: демон умер — сокета с этим pid больше нет. Забываем его,
+		 * иначе ядро слало бы в пустоту при каждом замере температуры.
+		 */
+		if (ret == -ECONNREFUSED && pid == g_tad_pid)
+			g_tad_pid = 0;
 		return;
 	}
 
@@ -371,11 +381,17 @@ int wakeup_ta_algo(int flow_state)
 	tsta_dprintk("[%s]g_tad_pid=%d, state=%d\n", __func__, g_tad_pid,
 								flow_state);
 
-	/*Avoid print log too much*/
+	/*
+	 * Avoid print log too much. BF7: флаги в g_ta_status не сбрасываются
+	 * до перезагрузки, и одна давняя ошибка печаталась каждый третий вызов
+	 * вечно. Печатаем только новое.
+	 */
 	if (g_ta_counter >= 3) {
 		g_ta_counter = 0;
-		if (g_ta_status != 0)
+		if (g_ta_status != g_ta_status_printed) {
 			tsta_warn("[%s] status: 0x%x\n", __func__, g_ta_status);
+			g_ta_status_printed = g_ta_status;
+		}
 	}
 	g_ta_counter++;
 	if (g_tad_pid != 0) {
@@ -398,7 +414,11 @@ int wakeup_ta_algo(int flow_state)
 		kfree(tad_msg);
 		return 0;
 	}
-	tsta_warn("[%s] error,g_tad_pid=0\n", __func__);
+	/* BF7: без демона (thermalloadalgod) это каждый замер — говорим раз */
+	if (!g_ta_no_daemon_told) {
+		tsta_warn("[%s] error,g_tad_pid=0\n", __func__);
+		g_ta_no_daemon_told = true;
+	}
 	g_ta_status = g_ta_status | 0x00001000;
 	return -1;
 }
diff --git a/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_bts.c b/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_bts.c
index 681dbf45a..f3cfe9a48 100644
--- a/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_bts.c
+++ b/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_bts.c
@@ -702,7 +702,8 @@ int mtkts_bts_get_hw_temp(void)
 		(tsdctm_thermal_get_ttj_on() == 0))
 		t_ret2 = wakeup_ta_algo(TA_CATMPLUS_TTJ);
 
-	if (t_ret2 < 0)
+	/* BF7: -1 — это «нет демона», о нём скажет сам wakeup_ta_algo */
+	if (t_ret2 == -ENOMEM)
 		pr_notice("[Thermal/TZ/BTS]wakeup_ta_algo out of memory\n");
 
 	bts_cur_temp = t_ret;
diff --git a/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_dctm.c b/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_dctm.c
index 65b46b634..3b2b48133 100644
--- a/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_dctm.c
+++ b/drivers/misc/mediatek/thermal/common/thermal_zones/mtk_ts_dctm.c
@@ -282,7 +282,8 @@ static int mtkts_dctm_get_temp(struct thermal_zone_device *thermal, int *t)
 			t_ret = wakeup_ta_algo(TA_DCTM_TTJ);
 	}
 
-	if (t_ret < 0)
+	/* BF7: -1 — это «нет демона», о нём скажет сам wakeup_ta_algo */
+	if (t_ret == -ENOMEM)
 		pr_notice("%s, wakeup_ta_algo out of memory\n", __func__);
 
 	if ((int)*t >= polling_trip_temp1)
