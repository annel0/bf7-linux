ISP_resume включал часы один раз на любое число открытий, а ISP_suspend
выключал все; лишнее выключение уводило в минус счётчики CCF общих часов
(SMI), 2026-09-26 это встало WDMA дисплея и зависанием с hang_detect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../cameraisp/src/mt6761/camera_isp.c         | 28 +++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/mediatek/cameraisp/src/mt6761/camera_isp.c b/drivers/misc/mediatek/cameraisp/src/mt6761/camera_isp.c
index 7c166e522..8940a68be 100644
--- a/drivers/misc/mediatek/cameraisp/src/mt6761/camera_isp.c
+++ b/drivers/misc/mediatek/cameraisp/src/mt6761/camera_isp.c
@@ -835,6 +835,7 @@ static struct ISP_RT_BUF_STRUCT *pstRTBuf;
 unsigned long g_Flash_SpinLock;
 
 static unsigned int G_u4EnableClockCount;
+static unsigned int bf7_isp_susp_count;	/* BF7: сколько выключений сделал ISP_suspend */
 
 /******************************************************************
  *
@@ -3198,7 +3199,19 @@ static void ISP_EnableClock(bool En)
 
 #else
 		/*log_inf("CCF:disable_unprepare clk\n"); */
+		/*
+		 * BF7: при нулевом счётчике не выключать. Лишнее выключение
+		 * (закрытий больше, чем включений) уводило в минус счётчики CCF
+		 * общих часов, включая SMI, которую делит дисплей: 2026-09-26 после
+		 * «camsv1 already unprepared» встал WDMA дисплея (CMDQ timeout),
+		 * процессы повисли в D, и через 5 мин сработал hang_detect.
+		 */
 		spin_lock(&(IspInfo.SpinLockClock));
+		if (G_u4EnableClockCount == 0) {
+			spin_unlock(&(IspInfo.SpinLockClock));
+			log_err("BF7: лишнее выключение тактирования ISP пропущено\n");
+			return;
+		}
 		G_u4EnableClockCount--;
 		spin_unlock(&(IspInfo.SpinLockClock));
 		Disable_Unprepare_ccf_clock();
@@ -13734,6 +13747,8 @@ static signed int ISP_suspend(struct platform_device *pDev, pm_message_t Mesg)
 	spin_lock(&(IspInfo.SpinLockClock));
 	loopcnt = G_u4EnableClockCount; //"G_u4EnableClockCount" times
 	spin_unlock(&(IspInfo.SpinLockClock));
+	/* BF7: ISP_resume вернёт ровно столько включений (см. ISP_resume) */
+	bf7_isp_susp_count = loopcnt;
 	while( loopcnt ){//make sure G_u4EnableClockCount dec to 0
 		ISP_EnableClock(MFALSE);
 		log_inf("isp suspend G_u4EnableClockCount: %d", G_u4EnableClockCount);
@@ -13754,8 +13769,17 @@ static signed int ISP_resume(struct platform_device *pDev)
 		log_dbg("ISP UserCount=0");
 		return 0;
 	}
-	//enable clock
-	ISP_EnableClock(MTRUE);
+	/*
+	 * BF7: включить столько раз, сколько выключил ISP_suspend. Прежде здесь
+	 * было одно включение на любое число открытий — после сна при двух
+	 * пользователях второе закрытие выключало уже выключенные часы.
+	 */
+	if (bf7_isp_susp_count == 0)
+		bf7_isp_susp_count = 1;
+	while (bf7_isp_susp_count) {
+		ISP_EnableClock(MTRUE);
+		bf7_isp_susp_count--;
+	}
 
 	/* TG_VF_CON[0] (0x15004414[0]): VFDATA_EN.     TG1     Take Picture
 	 * Request.
