+/*
+ * Кадр, пришедший из чужого dma-buf.
+ *
+ * Ради этого весь драйвер и затевался: буфер, в который нарисовал GPU или
+ * который выдал декодер, показывается панели без единого копирования. Всё,
+ * что для этого нужно, — отобразить его страницы в M4U и отдать слою
+ * полученный MVA.
+ *
+ * Базой взят drm_gem_cma_object, хотя памяти CMA тут нет: так остаются
+ * работоспособными готовые помощники DRM, а drm_gem_cma_free_object() сам
+ * правильно разбирает импортированный объект (vaddr у нас NULL, а
+ * import_attach выставляет ядро DRM). Своё поле — только MVA.
+ */
+struct bf7_gem_object {
+	struct drm_gem_cma_object base;	/* обязан быть первым */
+	struct bf7_drm_device *bf7;
+	unsigned int mva;
+	unsigned int mva_size;
+};
+
+static inline struct bf7_gem_object *to_bf7_gem(struct drm_gem_object *obj)
+{
+	return container_of(to_drm_gem_cma_obj(obj), struct bf7_gem_object,
+			    base);
+}
+
+/*
+ * Порядок байтов.
+ *
+ * Имена DRM перечисляют каналы от старшего бита к младшему, имена MediaTek —
+ * в порядке байтов в памяти, поэтому они выглядят зеркально. Сверено по
+ * mtkfb_pan_display_impl(): там при blue.offset == 0, то есть при синем в
+ * младшем байте (это и есть DRM_FORMAT_XRGB8888), выбирается BGRA8888.
+ */
+static enum DISP_FORMAT bf7_disp_format(u32 drm_format)
+{
+	switch (drm_format) {
+	case DRM_FORMAT_XRGB8888:
+	case DRM_FORMAT_ARGB8888:
+		return DISP_FORMAT_BGRA8888;
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		/* то, что отдаёт gralloc: HAL_PIXEL_FORMAT_RGBA_8888 */
+		return DISP_FORMAT_RGBA8888;
+	default:
+		return DISP_FORMAT_UNKNOWN;
+	}
+}
+
 /*
  * Отправка кадра в панель.
  *
@@ -86,7 +152,9 @@ static inline struct bf7_drm_device *bf7_from_tinydrm(struct tinydrm_device *t)
  * Слой берём тот же, что и mtkfb (FB_LAYER, он же 0): консоль на нём всё
  * равно отключена, а чужие слои трогать незачем.
  */
-static int bf7_post_frame(struct bf7_drm_device *bf7)
+static int bf7_post_frame(struct bf7_drm_device *bf7, unsigned int mva,
+			  enum DISP_FORMAT fmt, unsigned int pitch_px,
+			  unsigned int width, unsigned int height)
 {
 	struct disp_session_input_config *cfg;
 	struct disp_input_config *in;
@@ -107,17 +175,18 @@ static int bf7_post_frame(struct bf7_drm_device *bf7)
 	in->layer_id = primary_display_get_option("FB_LAYER");
 	in->layer_enable = 1;
 	in->buffer_source = DISP_BUFFER_MVA;	/* адрес уже готов */
-	in->src_phy_addr = (void *)(unsigned long)bf7->scanout_mva;
-	in->src_fmt = DISP_FORMAT_BGRA8888;	/* синий в младшем байте, как XRGB8888 у DRM */
+	in->src_phy_addr = (void *)(unsigned long)mva;
+	in->src_fmt = fmt;
 	in->src_offset_x = 0;
 	in->src_offset_y = 0;
-	in->src_width = bf7->mode.hdisplay;
-	in->src_height = bf7->mode.vdisplay;
-	in->src_pitch = bf7->pitch_px;		/* в ПИКСЕЛЯХ, не в байтах */
+	/* Больше панели не показываем: лишнее слой всё равно обрежет. */
+	in->src_width = min_t(unsigned int, width, bf7->mode.hdisplay);
+	in->src_height = min_t(unsigned int, height, bf7->mode.vdisplay);
+	in->src_pitch = pitch_px;		/* в ПИКСЕЛЯХ, не в байтах */
 	in->tgt_offset_x = 0;
 	in->tgt_offset_y = 0;
-	in->tgt_width = bf7->mode.hdisplay;
-	in->tgt_height = bf7->mode.vdisplay;
+	in->tgt_width = in->src_width;
+	in->tgt_height = in->src_height;
 	in->alpha_enable = 0;
 	in->alpha = 0xff;
 	in->next_buff_idx = -1;
@@ -139,7 +208,7 @@ static int bf7_post_frame(struct bf7_drm_device *bf7)
 		if (first) {
 			first = false;
 			DRM_INFO("bf7: первый кадр показан (слой %u, MVA 0x%x)\n",
-				 in->layer_id, bf7->scanout_mva);
+				 in->layer_id, mva);
 		}
 	}
 out:
@@ -234,6 +303,128 @@ static int bf7_alloc_scanout(struct device *dev, struct bf7_drm_device *bf7)
 	return ret;
 }
 
+/*
+ * Снимок экрана.
+ *
+ * Зачем это в драйвере. Убедиться, что кадр дошёл до панели, иначе нельзя:
+ * при показе без копирования своего буфера у нас нет, читать нечего, а
+ * вендорский тракт молчит одинаково и когда всё хорошо, и когда слой выключен
+ * чужим кодом. WDMA0 снимает выход OVL0 — ровно то, что видит глаз.
+ *
+ * Буфер нужен отдельный: у снимка шаг строки равен ширине панели, а у буфера
+ * вывода он выровнен, и класть одно в другое значило бы портить показанное.
+ */
+static int bf7_capture_prepare(struct bf7_drm_device *bf7)
+{
+	struct device *dev = bf7->tinydrm.drm->dev;
+	unsigned int mva;
+	int ret;
+
+	if (bf7->cap_va)
+		return 0;
+
+	bf7->cap_size = PAGE_ALIGN((size_t)bf7->mode.hdisplay *
+				   bf7->mode.vdisplay * 4);
+	bf7->cap_va = dma_alloc_wc(dev, bf7->cap_size, &bf7->cap_pa,
+				   GFP_KERNEL);
+	if (!bf7->cap_va)
+		return -ENOMEM;
+
+	memset(bf7->cap_va, 0, bf7->cap_size);
+
+	if (!bf7->m4u_client) {
+		bf7->cap_mva = (unsigned int)bf7->cap_pa;
+		return 0;
+	}
+
+	ret = sg_alloc_table(&bf7->cap_sgt, 1, GFP_KERNEL);
+	if (ret)
+		goto err_free;
+
+	sg_dma_address(bf7->cap_sgt.sgl) = bf7->cap_pa;
+	sg_dma_len(bf7->cap_sgt.sgl) = bf7->cap_size;
+
+	mva = 0;
+	ret = m4u_alloc_mva(bf7->m4u_client, M4U_PORT_DISP_WDMA0, 0,
+			    &bf7->cap_sgt, bf7->cap_size,
+			    M4U_PROT_READ | M4U_PROT_WRITE, 0, &mva);
+	if (ret) {
+		DRM_ERROR("bf7: m4u_alloc_mva для снимка отказал: %d\n", ret);
+		ret = ret > 0 ? -EIO : ret;
+		goto err_sgt;
+	}
+
+	bf7->cap_mva = mva;
+	DRM_INFO("bf7: буфер снимка %zu байт, MVA 0x%x\n",
+		 bf7->cap_size, bf7->cap_mva);
+	return 0;
+
+err_sgt:
+	sg_free_table(&bf7->cap_sgt);
+err_free:
+	dma_free_wc(dev, bf7->cap_size, bf7->cap_va, bf7->cap_pa);
+	bf7->cap_va = NULL;
+	return ret;
+}
+
+static int bf7_capture_open(struct inode *inode, struct file *file)
+{
+	file->private_data = inode->i_private;
+	return 0;
+}
+
+/*
+ * Снимок делается один раз, при чтении с нулевого смещения; дальше читается
+ * уже готовый буфер. Так обычный `dd` или `cat` получает целый кадр.
+ */
+static ssize_t bf7_capture_read(struct file *file, char __user *ubuf,
+				size_t len, loff_t *ppos)
+{
+	struct bf7_drm_device *bf7 = file->private_data;
+	ssize_t ret;
+
+	mutex_lock(&bf7->cap_lock);
+
+	if (*ppos == 0) {
+		ret = bf7_capture_prepare(bf7);
+		if (ret)
+			goto out;
+
+		ret = primary_display_capture_to_mva(bf7->cap_mva);
+		if (ret) {
+			DRM_ERROR("bf7: снимок не получился: %zd\n", ret);
+			goto out;
+		}
+	}
+
+	if (!bf7->cap_va) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	ret = simple_read_from_buffer(ubuf, len, ppos, bf7->cap_va,
+				      bf7->cap_size);
+out:
+	mutex_unlock(&bf7->cap_lock);
+	return ret;
+}
+
+static const struct file_operations bf7_capture_fops = {
+	.owner = THIS_MODULE,
+	.open = bf7_capture_open,
+	.read = bf7_capture_read,
+	.llseek = default_llseek,
+};
+
+/*
+ * Показ кадра.
+ *
+ * Два пути. Если кадр лежит в чужом dma-buf — из gralloc после GPU или из
+ * декодера, — его страницы уже отображены в M4U, и слою отдаётся готовый MVA:
+ * ни одного байта не переписывается. Если кадр обычный, из dumb-буфера DRM,
+ * копируем его в собственный буфер вывода: у клиента свой шаг строки, а
+ * непрерывной памяти под произвольный dumb-буфер вендорский тракт не знает.
+ */
 static int bf7_fb_dirty(struct drm_framebuffer *fb,
 			struct drm_file *file_priv, unsigned int flags,
 			unsigned int color, struct drm_clip_rect *clips,
@@ -242,6 +433,7 @@ static int bf7_fb_dirty(struct drm_framebuffer *fb,
 	struct tinydrm_device *tdev = fb->dev->dev_private;
 	struct bf7_drm_device *bf7 = bf7_from_tinydrm(tdev);
 	struct drm_gem_cma_object *cma_obj;
+	struct drm_gem_object *obj;
 	int ret;
 
 	mutex_lock(&tdev->dirty_lock);
@@ -252,6 +444,39 @@ static int bf7_fb_dirty(struct drm_framebuffer *fb,
 		goto out;
 	}
 
+	obj = fb->obj[0];
+	if (!obj) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (obj->import_attach) {
+		struct bf7_gem_object *bgo = to_bf7_gem(obj);
+		enum DISP_FORMAT fmt = bf7_disp_format(fb->format->format);
+
+		if (!bgo->mva || fmt == DISP_FORMAT_UNKNOWN) {
+			ret = -EINVAL;
+			goto out;
+		}
+
+		if (!bf7->direct_announced) {
+			bf7->direct_announced = true;
+			DRM_INFO("bf7: кадр из чужого dma-buf показан без копирования (MVA 0x%x, шаг %u)\n",
+				 bgo->mva, fb->pitches[0]);
+		}
+
+		/*
+		 * Буфер жив, пока жив кадр: ссылку на кадр держит состояние
+		 * плоскости, а старое состояние атомарные помощники отпускают
+		 * уже после этого вызова. Запуск у нас блокирующий, так что к
+		 * моменту освобождения слой смотрит на новый буфер.
+		 */
+		ret = bf7_post_frame(bf7, bgo->mva + fb->offsets[0], fmt,
+				     fb->pitches[0] / 4,
+				     fb->width, fb->height);
+		goto out;
+	}
+
 	cma_obj = drm_fb_cma_get_gem_obj(fb, 0);
 	if (!cma_obj || !cma_obj->vaddr) {
 		ret = -EINVAL;
@@ -275,16 +500,128 @@ static int bf7_fb_dirty(struct drm_framebuffer *fb,
 			       bytes);
 	}
 
-	ret = bf7_post_frame(bf7);
+	ret = bf7_post_frame(bf7, bf7->scanout_mva, DISP_FORMAT_BGRA8888,
+			     bf7->pitch_px, bf7->mode.hdisplay,
+			     bf7->mode.vdisplay);
 out:
 	mutex_unlock(&tdev->dirty_lock);
 	return ret;
 }
 
-static int bf7_fb_dirty(struct drm_framebuffer *fb,
-			struct drm_file *file_priv, unsigned int flags,
-			unsigned int color, struct drm_clip_rect *clips,
-			unsigned int num_clips);
+/*
+ * Приём чужого dma-buf.
+ *
+ * Своей версии эта функция требует потому, что помощник CMA принимает только
+ * непрерывную память, а буферы ION из общей кучи почти всегда рассыпаны по
+ * страницам. Нам непрерывность и не нужна: её обеспечивает M4U, ради которого
+ * весь вендорский тракт и работает с MVA вместо физических адресов.
+ */
+static struct drm_gem_object *
+bf7_gem_prime_import_sg_table(struct drm_device *drm,
+			      struct dma_buf_attachment *attach,
+			      struct sg_table *sgt)
+{
+	struct tinydrm_device *tdev = drm->dev_private;
+	struct bf7_drm_device *bf7 = bf7_from_tinydrm(tdev);
+	struct bf7_gem_object *bgo;
+	struct scatterlist *sg;
+	unsigned int total = 0;
+	unsigned int mva = 0;
+	size_t size = attach->dmabuf->size;
+	int i, ret;
+
+	bgo = kzalloc(sizeof(*bgo), GFP_KERNEL);
+	if (!bgo)
+		return ERR_PTR(-ENOMEM);
+
+	drm_gem_private_object_init(drm, &bgo->base.base, size);
+	bgo->base.sgt = sgt;
+	bgo->base.vaddr = NULL;	/* по нему drm_gem_cma_free_object() и различает */
+	bgo->bf7 = bf7;
+
+	if (!bf7->m4u_client) {
+		/* M4U выключен: годится только уже непрерывный буфер. */
+		if (sgt->nents != 1) {
+			ret = -EINVAL;
+			goto err;
+		}
+		bgo->mva = sg_dma_address(sgt->sgl) ?
+			   (unsigned int)sg_dma_address(sgt->sgl) :
+			   (unsigned int)sg_phys(sgt->sgl);
+		return &bgo->base.base;
+	}
+
+	/*
+	 * Длину считаем ровно так же, как m4u_map_sgtable(): иначе он дойдёт
+	 * до конца списка раньше заказанного размера и откажет. Просить
+	 * PAGE_ALIGN(size) нельзя по той же причине.
+	 */
+	for_each_sg(sgt->sgl, sg, sgt->nents, i) {
+		unsigned int len = sg_dma_len(sg);
+
+		if (!sg_dma_address(sg))
+			len = sg->length;
+		total += len;
+	}
+
+	if (total < size) {
+		DRM_ERROR("bf7: в dma-buf на %zu байт отображено только %u\n",
+			  size, total);
+		ret = -EINVAL;
+		goto err;
+	}
+
+	ret = m4u_alloc_mva(bf7->m4u_client, M4U_PORT_DISP_OVL0, 0, sgt,
+			    total, M4U_PROT_READ, 0, &mva);
+	if (ret) {
+		DRM_ERROR("bf7: m4u_alloc_mva для dma-buf отказал: %d\n", ret);
+		ret = ret > 0 ? -EIO : ret;
+		goto err;
+	}
+
+	bgo->mva = mva;
+	bgo->mva_size = total;
+	DRM_DEBUG_PRIME("bf7: dma-buf %zu байт -> MVA 0x%x (%u кусков)\n",
+			size, mva, sgt->nents);
+	return &bgo->base.base;
+
+err:
+	drm_gem_object_release(&bgo->base.base);
+	kfree(bgo);
+	return ERR_PTR(ret);
+}
+
+static void bf7_gem_free_object(struct drm_gem_object *obj)
+{
+	if (obj->import_attach) {
+		struct bf7_gem_object *bgo = to_bf7_gem(obj);
+
+		if (bgo->mva && bgo->bf7->m4u_client)
+			m4u_dealloc_mva(bgo->bf7->m4u_client,
+					M4U_PORT_DISP_OVL0, bgo->mva);
+		/*
+		 * Именно помощник CMA, а не обёртка tinydrm: та первым делом
+		 * снимает отображение в ядре, которого мы не делали.
+		 */
+		drm_gem_cma_free_object(obj);
+		return;
+	}
+
+	tinydrm_gem_cma_free_object(obj);
+}
