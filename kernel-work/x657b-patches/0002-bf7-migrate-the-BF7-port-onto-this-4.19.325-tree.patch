+	retval = snprintf(buf, PAGE_SIZE - count,
+			"num force electrodes:  %d\n",
+			le2_to_uint(tcm_hcd->app_info.num_of_force_elecs));
+	if (retval < 0)
+		goto exit;
+
+	count += retval;
+
+	retval = count;
+
+exit:
+	mutex_unlock(&tcm_hcd->extif_mutex);
+
+	return retval;
+}
