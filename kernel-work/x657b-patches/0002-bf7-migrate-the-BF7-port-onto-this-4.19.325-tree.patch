index 000000000..73b4fba3e
--- /dev/null
+++ b/drivers/input/touchscreen/TD4160/Makefile
@@ -0,0 +1,25 @@
+# BF7: тач сидит на spi2 (оверлей, fragment@26), поэтому собираем SPI-часть
+# вместо донорской I2C, и включаем zeroflash - у TDDI-контроллера нет своей
+# флеш-памяти, прошивка заливается при каждом старте (у OEM _ZEROFLASH=y).
+#
+# Makefile for the Synaptics TCM touchscreen driver.
+#
+
+# Each configuration option enables a list of files.
+
+ccflags-y += -I$(srctree)/drivers/misc/mediatek/include/mt-plat/
+
+obj-y += synaptics_tcm_spi.o
+obj-n += synaptics_tcm_i2c.o
+obj-y += synaptics_tcm_core.o
+obj-y += synaptics_tcm_touch.o
+obj-y += synaptics_tcm_device.o
+obj-y += synaptics_tcm_testing.o
+obj-y += synaptics_tcm_reflash.o
+obj-y += synaptics_tcm_recovery.o
+obj-y += synaptics_tcm_zeroflash.o
+obj-y += synaptics_tcm_diagnostics.o
+# BF7: контроллер сообщает firmware mode = 0x04 = MODE_ROMBOOTLOADER, а за этот
+# режим отвечает именно romboot; в доноре он был отключён.  Нужный ему образ
+# synaptics/hdl_firmware.img на устройстве есть (/vendor/firmware/synaptics/).
+obj-y += synaptics_tcm_romboot.o
