diff --git a/drivers/usb/gadget/function/u_ether.c b/drivers/usb/gadget/function/u_ether.c
index b9b4673b8..110446397 100644
--- a/drivers/usb/gadget/function/u_ether.c
+++ b/drivers/usb/gadget/function/u_ether.c
@@ -741,6 +741,27 @@ static netdev_tx_t eth_start_xmit(struct sk_buff *skb,
 			dev->net->stats.tx_dropped++;
 		return NETDEV_TX_OK;
 	}
+
+	/* gether_setup_name_default() advertises NETIF_F_SG | NETIF_F_GSO, so
+	 * the stack hands us fragmented skbs: only skb_headlen() bytes live at
+	 * skb->data, the rest sits in page frags.  Only the aggregating branch
+	 * below walks those frags, and only when NETIF_F_GSO is on; every other
+	 * path passes skb->data with skb->len to the controller and therefore
+	 * transmits whatever memory happens to follow the linear area instead
+	 * of the frags.  RNDIS aggregation is off whenever the host negotiates
+	 * MaxTransferSize <= 2048, which is exactly what Linux hosts ask for,
+	 * so on those hosts the tail of every full-size frame was corrupt (the
+	 * bytes came from skb_shared_info and from stale heap) and the peer
+	 * dropped the segment on the TCP checksum.  Flatten the skb unless the
+	 * frag-aware path is the one that will run.
+	 */
+	if (!(multi_pkt_xfer && (net->features & NETIF_F_GSO)) &&
+	    skb_linearize(skb)) {
+		dev_kfree_skb_any(skb);
+		dev->net->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
 	spin_lock_irqsave(&dev->req_lock, flags);
 	if (multi_pkt_xfer && !dev->tx_req_bufsize) {
 		retval = alloc_tx_buffer(dev);
