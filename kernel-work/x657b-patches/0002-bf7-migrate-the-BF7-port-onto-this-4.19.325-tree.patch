+	retval = snprintf(buf, PAGE_SIZE - count,
+			"has profile:  %d\n",
+			le2_to_uint(tcm_hcd->app_info.has_hybrid_data));
+	if (retval < 0)
+		goto exit;
+
+	buf += retval;
