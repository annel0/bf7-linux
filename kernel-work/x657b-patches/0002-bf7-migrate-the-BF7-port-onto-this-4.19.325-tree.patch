+			le2_to_uint(tcm_hcd->app_info.app_config_size));
+	if (retval < 0)
+		goto exit;
+
+	buf += retval;
+	count += retval;
+
+	retval = snprintf(buf, PAGE_SIZE - count,
+			"touch report config max size:  %d\n",
+		le2_to_uint(tcm_hcd->app_info.max_touch_report_config_size));
