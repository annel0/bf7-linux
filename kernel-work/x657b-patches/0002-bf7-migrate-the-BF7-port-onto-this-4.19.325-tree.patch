+	retval = snprintf(buf, PAGE_SIZE - count,
+				"config id:  ");
+	if (retval < 0)
+		goto exit;
+
+	buf += retval;
+	count += retval;
+
+	for (i = 0; i < sizeof(tcm_hcd->app_info.customer_config_id); i++) {
+		retval = snprintf(buf, PAGE_SIZE - count,
+			"0x%2x ", tcm_hcd->app_info.customer_config_id[i]);
+		buf += retval;
+		count += retval;
