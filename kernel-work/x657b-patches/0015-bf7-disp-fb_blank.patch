Первая версия звала primary_display_suspend() напрямую. Тракт засыпал,
но о погашенном экране не узнавал никто: сторож тачскрина TD4160 раз в
секунду читал спящую микросхему (13 ошибок за 10 с), вендорские правила
«экран погашен» (dvfsrc, cm_mgr, mtk_menu, ged, ION, звук) не
включались. Теперь fb_blank() на буфере mtkfb — тот же mtkfb_blank, но
с FB_EARLY_EVENT_BLANK/FB_EVENT_BLANK; замки как у FBIOBLANK.
Проверено: сон и пробуждение, pri_disp_wakelock отпущен, «SCREEN OFF»
дошёл, сторож касаний молчит, тач снова в рабочей прошивке.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mediatek/video/mt6765/videox/bf7_drm.c    | 62 ++++++++++++++-----
 1 file changed, 47 insertions(+), 15 deletions(-)

diff --git a/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c b/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
index 12da3f2ed..b78a4e9da 100644
--- a/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
+++ b/drivers/misc/mediatek/video/mt6765/videox/bf7_drm.c
@@ -32,6 +32,8 @@
 #include <linux/dma-buf.h>
 #include <linux/dma-mapping.h>
 #include <linux/of_device.h>
+#include <linux/fb.h>
+#include <linux/console.h>
 
 #include <drm/drmP.h>
 #include <drm/drm_atomic_helper.h>
@@ -688,42 +690,72 @@ static const struct drm_framebuffer_funcs bf7_fb_funcs = {
  * primary_display_suspend(): пока её никто не зовёт, ядро отменяет любую
  * попытку сна (первая проба сна 2026-09-23 застала его активным).
  *
- * Делаем ровно как старый путь гашения mtkfb (mtkfb_blank →
- * mtkfb_early_suspend / mtkfb_late_resume): режим питания FB_SUSPEND и
- * primary_display_suspend(), при включении — FB_RESUME и
- * primary_display_resume(), только на обычной стадии помощника дисплея.
+ * Гасим тем же путём, что и старый вендорский: fb_blank() на буфере mtkfb.
+ * Это mtkfb_blank → mtkfb_early_suspend / mtkfb_late_resume (режим питания
+ * FB_SUSPEND и primary_display_suspend(), при включении — наоборот), но
+ * ВМЕСТЕ с оповещениями FB_EARLY_EVENT_BLANK / FB_EVENT_BLANK. Первая
+ * версия звала primary_display_suspend() напрямую, без оповещений, и
+ * этого хватило, чтобы тракт уснул, — но о погашенном экране не узнал
+ * никто из тех, кто на этом строит своё поведение:
+ *   - тачскрин TD4160 (касание и дисплей — одна микросхема, сон панели
+ *     сбрасывает и контроллер касаний): его сторож раз в секунду читал
+ *     спящую микросхему и сыпал «Failed to read from device»;
+ *   - вендорские правила «экран погашен»: частота памяти и напряжение ядра
+ *     (dvfsrc, cm_mgr), глубина простоя (mtk_menu), GPU (ged), кэш ION,
+ *     звук, ток зарядки.
+ * Замки — ровно как у ioctl FBIOBLANK: console_lock, lock_fb_info и флаг
+ * FBINFO_MISC_USEREVENT, чтобы fbcon не вызвал fb_blank повторно.
+ * Порядок замков тут безопасен: своего fbdev у bf7_drm нет (эмуляцию
+ * DRM не заводим), так что никто не берёт console_lock раньше замков
+ * режима DRM.
  *
- * На нашей связке этот путь никто не испытывал, поэтому он выключен по
- * умолчанию и включается на лету:
- *   echo 1 > /sys/module/bf7_drm/parameters/usyplyat_panel
  * Кадры в усыплённый тракт не идут: при выключенном конвейере
  * bf7_fb_dirty ничего не показывает.
+ *
+ * Выключено по умолчанию и включается на лету:
+ *   echo 1 > /sys/module/bf7_drm/parameters/usyplyat_panel
  */
 static bool bf7_usyplyat_panel;
 module_param_named(usyplyat_panel, bf7_usyplyat_panel, bool, 0644);
 MODULE_PARM_DESC(usyplyat_panel, "Усыплять тракт экрана при выключении конвейера");
 
+extern struct fb_info *mtkfb_fbi;
+
+static void bf7_fb_blank(int blank)
+{
+	console_lock();
+	if (!lock_fb_info(mtkfb_fbi)) {
+		console_unlock();
+		return;
+	}
+	mtkfb_fbi->flags |= FBINFO_MISC_USEREVENT;
+	fb_blank(mtkfb_fbi, blank);
+	mtkfb_fbi->flags &= ~FBINFO_MISC_USEREVENT;
+	unlock_fb_info(mtkfb_fbi);
+	console_unlock();
+}
+
 static void bf7_trakt_usypit(void)
 {
-	if (!bf7_usyplyat_panel || primary_display_is_sleepd())
+	if (!bf7_usyplyat_panel || !mtkfb_fbi || primary_display_is_sleepd())
 		return;
 	if (disp_helper_get_stage() != DISP_HELPER_STAGE_NORMAL)
 		return;
-	primary_display_set_power_mode(FB_SUSPEND);
-	if (primary_display_suspend() < 0)
-		DRM_ERROR("bf7: тракт экрана не усыпился\n");
-	else
+	bf7_fb_blank(FB_BLANK_POWERDOWN);
+	if (primary_display_is_sleepd())
 		DRM_INFO("bf7: тракт экрана усыплён\n");
+	else
+		DRM_ERROR("bf7: тракт экрана не усыпился\n");
 }
 
 static void bf7_trakt_razbudit(void)
 {
-	if (!primary_display_is_sleepd())
+	if (!mtkfb_fbi || !primary_display_is_sleepd())
 		return;
 	if (disp_helper_get_stage() != DISP_HELPER_STAGE_NORMAL)
 		return;
-	primary_display_set_power_mode(FB_RESUME);
-	if (primary_display_resume())
+	bf7_fb_blank(FB_BLANK_UNBLANK);
+	if (primary_display_is_sleepd())
 		DRM_ERROR("bf7: тракт экрана не проснулся\n");
 	else
 		DRM_INFO("bf7: тракт экрана разбужен\n");
