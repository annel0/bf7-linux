Content-Transfer-Encoding: 8bit

- mtk_idle_profile.c (spm/common — собираемая копия, не spm_v4) и
  mcdi_v1/mtk_mcdi_main.c: «Power/swap DP: No enter…», причины блокировки и
  «mcdi cpu: …» печатались раз в 5 с прямо из пути простоя — ~18 строк в
  минуту круглосуточно. Теперь раз в 10 минут; параметры модуля
  mtk_idle_profile.cnt_dump_ms / block_log_ms и
  mtk_mcdi_main.heart_beat_log_ms возвращают частоту на лету. Счётчики и
  так читаются из /proc/mtk_lpm/cpuidle/.
- Trustonic admin.c: «daemon not connected after …» печатался раз в 10 с
  на каждый ждущий поток (демона не будет никогда); теперь на 10, 20, 40,
  80… секунде.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../base/power/mcdi/mcdi_v1/mtk_mcdi_main.c        |  4 +++-
 .../base/power/spm/common/mtk_idle_profile.c       | 14 ++++++++++++--
 drivers/tee/gud/500/MobiCoreDriver/admin.c         | 10 ++++++++--
 3 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/mediatek/base/power/mcdi/mcdi_v1/mtk_mcdi_main.c b/drivers/misc/mediatek/base/power/mcdi/mcdi_v1/mtk_mcdi_main.c
index d159ea25b..37eee5e86 100644
--- a/drivers/misc/mediatek/base/power/mcdi/mcdi_v1/mtk_mcdi_main.c
+++ b/drivers/misc/mediatek/base/power/mcdi/mcdi_v1/mtk_mcdi_main.c
@@ -64,7 +64,9 @@ static const char *ac_cpu_cond_name[NF_ANY_CORE_CPU_COND_INFO] = {
 static unsigned long long mcdi_heart_beat_log_prev;
 static DEFINE_SPINLOCK(mcdi_heart_beat_spin_lock);
 
-static unsigned int mcdi_heart_beat_log_dump_thd = 5000;          /* 5 sec */
+/* BF7: «mcdi cpu: …» раз в 10 минут, а не 5 с (см. mtk_idle_profile.c). */
+static unsigned int mcdi_heart_beat_log_dump_thd = 600000;        /* 10 min */
+module_param_named(heart_beat_log_ms, mcdi_heart_beat_log_dump_thd, uint, 0644);
 
 static bool mcdi_stress_en;
 static unsigned int mcdi_stress_us = 10 * 1000;
diff --git a/drivers/misc/mediatek/base/power/spm/common/mtk_idle_profile.c b/drivers/misc/mediatek/base/power/spm/common/mtk_idle_profile.c
index ac7961a1d..e624a1fb8 100644
--- a/drivers/misc/mediatek/base/power/spm/common/mtk_idle_profile.c
+++ b/drivers/misc/mediatek/base/power/spm/common/mtk_idle_profile.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2017 MediaTek Inc.
  */
 
+#include <linux/moduleparam.h>
 #include <linux/kernel.h>
 #include <linux/math64.h>
 
@@ -39,9 +40,18 @@ static unsigned long long idle_ratio_profile_duration;
 
 /* idle block information */
 static unsigned long long idle_block_log_prev_time;
-static unsigned int idle_block_log_time_criteria = 5000;    /* 5 sec */
+/*
+ * BF7: сводки простоя («Power/swap DP: No enter --- SODI3: …», причины
+ * блокировки) печатались раз в 5 с прямо из пути простоя процессора — около
+ * 18 строк в минуту в журнал круглосуточно. Счётчики и так читаются по
+ * запросу из /proc/mtk_lpm/cpuidle/ (dpidle_state и соседние). Раз в 10 минут; для отладки
+ * частоту можно вернуть на лету через параметры модуля.
+ */
+static unsigned int idle_block_log_time_criteria = 600000;  /* 10 min */
+module_param_named(block_log_ms, idle_block_log_time_criteria, uint, 0644);
 static unsigned long long idle_cnt_dump_prev_time;
-static unsigned int idle_cnt_dump_criteria = 5000;          /* 5 sec */
+static unsigned int idle_cnt_dump_criteria = 600000;        /* 10 min, BF7 */
+module_param_named(cnt_dump_ms, idle_cnt_dump_criteria, uint, 0644);
 
 /*External weak functions: implemented in mtk_cpufreq_api.c*/
 unsigned int __attribute__((weak))
diff --git a/drivers/tee/gud/500/MobiCoreDriver/admin.c b/drivers/tee/gud/500/MobiCoreDriver/admin.c
index c7cbf9995..b0587a924 100644
--- a/drivers/tee/gud/500/MobiCoreDriver/admin.c
+++ b/drivers/tee/gud/500/MobiCoreDriver/admin.c
@@ -227,8 +227,14 @@ static int request_send(u32 command, const struct mc_uuid_t *uuid, bool is_gp)
 
 		if (counter_ms == 10000) { /* print every 10s */
 			wait_tens++;
-			mc_dev_info("daemon not connected after %d0s, waiting",
-				    wait_tens);
+			/*
+			 * BF7: демона не будет никогда (см. ниже), и строка раз в
+			 * 10 с на каждый ждущий поток — ~9 строк в минуту в журнал.
+			 * Печатаем по нарастающей: на 10, 20, 40, 80… секунде.
+			 */
+			if (!(wait_tens & (wait_tens - 1)))
+				mc_dev_info("daemon not connected after %d0s, waiting",
+					    wait_tens);
 			counter_ms = 0;
 		}
 
