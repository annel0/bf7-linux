 =?UTF-8?q?=D0=B8=20=D0=BF=D1=80=D0=BE=D1=81=D1=82=D0=BE=D1=8F=20=D1=80?=
 =?UTF-8?q?=D0=B0=D0=B7=20=D0=B2=2010=20=D0=BC=D0=B8=D0=BD=D1=83=D1=82,=20?=
 =?UTF-8?q?Trustonic=20=D0=BF=D0=BE=20=D0=BD=D0=B0=D1=80=D0=B0=D1=81=D1=82?=
