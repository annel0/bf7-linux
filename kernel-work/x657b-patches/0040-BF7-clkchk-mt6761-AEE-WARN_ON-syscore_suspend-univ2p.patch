diff --git a/drivers/clk/mediatek/clkchk-mt6761.c b/drivers/clk/mediatek/clkchk-mt6761.c
index fd50b1869..1438d6b7b 100644
--- a/drivers/clk/mediatek/clkchk-mt6761.c
+++ b/drivers/clk/mediatek/clkchk-mt6761.c
@@ -434,19 +434,13 @@ static void check_pll_off(void)
 		print_enabled_clks();
 
 
-#ifdef CONFIG_MTK_ENG_BUILD
-#if BUG_ON_CHK_ENABLE
-		BUG_ON(1);
-#else
-		aee_kernel_warning("CCF MT6761",
-			"@%s():%d, PLLs are not off\n", __func__, __LINE__);
-		WARN_ON(1);
-#endif
-#else
-		aee_kernel_warning("CCF MT6761",
-			"@%s():%d, PLLs are not off\n", __func__, __LINE__);
-		WARN_ON(1);
-#endif
+		/*
+		 * BF7: без aee_kernel_warning и WARN_ON. Это syscore_suspend —
+		 * часы ядра уже остановлены, и сам AEE падал в WARN из
+		 * ktime_get_real_ts64 со стеком и пометкой «Tainted: W». На
+		 * кабеле univ2pll (такт USB) включён всегда, и так было при каждом
+		 * засыпании. Строки «suspend warning» и список тактов выше остаются.
+		 */
 	}
 }
 
@@ -512,19 +506,8 @@ static void check_mtcmos_off(void)
 	}
 
 	if (invalid) {
-#ifdef CONFIG_MTK_ENG_BUILD
-#if BUG_ON_CHK_ENABLE
-		BUG_ON(1);
-#else
-		aee_kernel_warning("CCF MT6761",
-			"@%s():%d, MTCMOSs are not off\n", __func__, __LINE__);
-		WARN_ON(1);
-#endif
-#else
-		aee_kernel_warning("CCF MT6761",
-			"@%s():%d, MTCMOSs are not off\n", __func__, __LINE__);
-		WARN_ON(1);
-#endif
+		/* BF7: без AEE и WARN_ON — см. проверку PLL выше. */
+		pr_notice("suspend warning: MTCMOSs are not off\n");
 	}
 }
 
