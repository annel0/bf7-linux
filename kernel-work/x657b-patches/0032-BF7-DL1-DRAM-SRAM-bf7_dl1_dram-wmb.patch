Запись в SRAM звукового блока (Device-nGnRE) через memcpy_toio занимала
треть времени PulseAudio при воспроизведении (~3% ядра).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mediatek/common_int/mtk-soc-afe-control.c  |  2 ++
 .../soc/mediatek/common_int/mtk-soc-pcm-dl1.c  | 18 +++++++++++++++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/sound/soc/mediatek/common_int/mtk-soc-afe-control.c b/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
index dd17c097d..46e018b4c 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-afe-control.c
@@ -122,6 +122,8 @@ int bf7_copy_from_user_io(void *dst, const void __user *src, unsigned long bytes
 		bytes -= chunk;
 	}
 
+	/* буфер может быть и в DRAM (Normal-NC): данные — до сдвига указателя */
+	wmb();
 	kfree(bounce);
 	return ret;
 }
diff --git a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
index d3d8ab72a..c14bf2532 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-pcm-dl1.c
@@ -158,6 +158,19 @@ static snd_pcm_uframes_t mtk_pcm_pointer(struct snd_pcm_substream *substream)
 				   Soc_Aud_Digital_Block_MEM_DL1);
 }
 
+/*
+ * BF7: буфер воспроизведения в DRAM, а не во внутренней SRAM звукового блока.
+ * SRAM отображена как память устройства: каждая 8-байтовая запись memcpy_toio
+ * идёт отдельной транзакцией, ~6 МБ/с. Замер perf 2026-09-25: треть времени
+ * PulseAudio при воспроизведении — в __memcpy_toio, ~3% ядра непрерывно.
+ * DRAM из dma_alloc_coherent — Normal-NC, записи склеиваются. SRAM нужна
+ * MediaTek, чтобы DRAM спала во время музыки при погашенном экране; у нас
+ * звук во сне не играет. Выключить на лету (со следующего открытия
+ * устройства): echo 0 > /sys/module/mtk_soc_pcm_dl1/parameters/bf7_dl1_dram
+ */
+static bool bf7_dl1_dram = true;
+module_param(bf7_dl1_dram, bool, 0644);
+
 static int mtk_pcm_dl1_params(struct snd_pcm_substream *substream,
 			      struct snd_pcm_hw_params *hw_params)
 {
@@ -167,7 +180,10 @@ static int mtk_pcm_dl1_params(struct snd_pcm_substream *substream,
 	/* runtime->dma_bytes has to be set manually to allow mmap */
 	substream->runtime->dma_bytes = params_buffer_bytes(hw_params);
 
-	if (AllocateAudioSram(&substream->runtime->dma_addr,
+	if ((!bf7_dl1_dram || !Dl1_Playback_dma_buf ||
+	     !Dl1_Playback_dma_buf->area ||
+	     substream->runtime->dma_bytes > Dl1_Playback_dma_buf->bytes) &&
+	    AllocateAudioSram(&substream->runtime->dma_addr,
 			      &substream->runtime->dma_area,
 			      substream->runtime->dma_bytes, substream,
 			      params_format(hw_params), false) == 0) {
