diff --git a/drivers/misc/mediatek/lcm/bf7_lcm_recovered/bf7_lcm_recovered.c b/drivers/misc/mediatek/lcm/bf7_lcm_recovered/bf7_lcm_recovered.c
new file mode 100644
index 000000000..fb74dbee5
--- /dev/null
+++ b/drivers/misc/mediatek/lcm/bf7_lcm_recovered/bf7_lcm_recovered.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Compile-only reconstruction of the active BF7 TD4160-HX panel path.
+ *
+ * The DSI stream and LCM_PARAMS payload below are recovered from the OEM BF7
+ * 4.19.191 Image, not copied from a different handset.  This driver has not
+ * been boot-tested and must not be treated as a flashing candidate yet.
+ */
+
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "../inc/lcm_drv.h"
+/* MT6761 selects the MT6765 display stack in this source tree. */
+#include "../../video/mt6765/videox/disp_dts_gpio.h"
+
+#define REGFLAG_DELAY 0xFFFC
+
+static struct LCM_UTIL_FUNCS lcm_util;
+
+#define MDELAY(ms) lcm_util.mdelay(ms)
+#define DSI_V2(cmd, count, data) \
+	lcm_util.dsi_set_cmdq_V2((cmd), (count), (unsigned char *)(data), 1)
+
+#include "generated/bf7_lcm_tables.h"
+
+/*
+ * The BF7 DTBO supplies a single panel-bias device on I2C5 at 0x3e:
+ *
+ *   compatible = "mediatek,i2c_lcd_bias";
+ *   reg = <0x3e>;
+ *
+ * The generic lcm_i2c driver is compiled without DT support in the audited
+ * BF7 configuration, so it cannot bind this node.  The OEM TD4160 driver
+ * owns a small, separate OCP2130 client for it.  Keep this client local and
+ * do not borrow the touchscreen's I2C or pinctrl state.
+ */
+#ifdef MTK_LCM_DEVICE_TREE_SUPPORT
+#error "BF7 recovered panel uses its own OCP2130 DT I2C client"
+#endif
+
+#define BF7_BIAS_I2C_NAME "ocp2130"
+
+static struct i2c_client *bf7_bias_client;
+static bool bf7_panel_power_suspended;
+
+static int bf7_bias_probe(struct i2c_client *client,
+			  const struct i2c_device_id *id)
+{
+	bf7_bias_client = client;
+	pr_info("BF7 LCM: bound panel bias at I2C 0x%02x\n", client->addr);
+	return 0;
+}
+
+static int bf7_bias_remove(struct i2c_client *client)
+{
+	if (bf7_bias_client == client)
+		bf7_bias_client = NULL;
+	return 0;
+}
+
+static const struct of_device_id bf7_bias_of_match[] = {
+	{ .compatible = "mediatek,i2c_lcd_bias" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bf7_bias_of_match);
+
+static const struct i2c_device_id bf7_bias_id[] = {
+	{ BF7_BIAS_I2C_NAME, 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, bf7_bias_id);
+
+static struct i2c_driver bf7_bias_driver = {
+	.id_table = bf7_bias_id,
+	.probe = bf7_bias_probe,
+	.remove = bf7_bias_remove,
+	.driver = {
+		.name = BF7_BIAS_I2C_NAME,
+		.of_match_table = bf7_bias_of_match,
+	},
+};
+
+static int __init bf7_bias_i2c_init(void)
+{
+	return i2c_add_driver(&bf7_bias_driver);
+}
+module_init(bf7_bias_i2c_init);
+
+static void __exit bf7_bias_i2c_exit(void)
+{
+	i2c_del_driver(&bf7_bias_driver);
+}
+module_exit(bf7_bias_i2c_exit);
+
+static void bf7_bias_write(unsigned char reg, unsigned char value)
+{
+	char data[2] = { reg, value };
+	int ret;
+
+	if (!bf7_bias_client) {
+		pr_err("BF7 LCM: OCP2130 I2C client is unavailable\n");
+		return;
+	}
+
+	ret = i2c_transfer_buffer_flags(bf7_bias_client, data, 2, 0);
+	if (ret != 2)
+		pr_err("BF7 LCM: OCP2130 write %02x=%02x failed: %d\n",
+		       reg, value, ret);
+}
+
+/* OEM order: ENP1, 5 ms, ENN1, then 00/01/03/ff with 1/1/1/10 ms. */
+static void bf7_program_bias(void)
+{
+	disp_dts_gpio_select_state(DTS_GPIO_STATE_LCD_BIAS_ENP1);
+	MDELAY(5);
+	disp_dts_gpio_select_state(DTS_GPIO_STATE_LCD_BIAS_ENN1);
+
+	bf7_bias_write(0x00, 0x14);
+	MDELAY(1);
+	bf7_bias_write(0x01, 0x14);
+	MDELAY(1);
+	bf7_bias_write(0x03, 0x33);
+	MDELAY(1);
+	bf7_bias_write(0xff, 0x80);
+	MDELAY(10);
+}
+
+static void bf7_push_256(const struct bf7_lcm_cmd_256 *table,
+			 unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		if (table[i].cmd == 0xFFFD)
+			continue;
+		else if (table[i].cmd == REGFLAG_DELAY)
+			MDELAY(table[i].count);
+		else
+			DSI_V2(table[i].cmd, table[i].count, table[i].data);
+	}
+}
+
+static void bf7_set_util_funcs(const struct LCM_UTIL_FUNCS *util)
+{
+	memcpy(&lcm_util, util, sizeof(lcm_util));
+}
+
+static void bf7_get_params(struct LCM_PARAMS *params)
+{
+#if defined(CONFIG_MTK_MT6382_BDG) || defined(CONFIG_MTK_HIGH_FRAME_RATE)
+#error "BF7 TD4160-HX params require the audited MT6761 LCM_PARAMS layout"
+#endif
+	/*
+	 * OEM clears precisely 0x518 bytes. Keep the size assertion, but use named
+	 * fields: the former raw word map placed RGB888 in trans_seq instead of
+	 * data_format.format.
+	 */
+	BUILD_BUG_ON(sizeof(struct LCM_PARAMS) != 0x518);
+	BUILD_BUG_ON(offsetof(struct LCM_PARAMS, dsi.data_format.format) !=
+		     127 * sizeof(unsigned int));
+	memset(params, 0, sizeof(*params));
+
+	params->type = LCM_TYPE_DSI;
+	params->lcm_if = LCM_INTERFACE_DSI0;
+	params->lcm_cmd_if = LCM_INTERFACE_DSI0;
+	params->width = 720;
+	params->height = 1612;
+
+	params->dsi.mode = BURST_VDO_MODE;
+	params->dsi.LANE_NUM = LCM_FOUR_LANE;
+	params->dsi.data_format.color_order = LCM_COLOR_ORDER_RGB;
+	params->dsi.data_format.trans_seq = LCM_DSI_TRANS_SEQ_MSB_FIRST;
+	params->dsi.data_format.padding = LCM_DSI_PADDING_ON_LSB;
+	params->dsi.data_format.format = LCM_DSI_FORMAT_RGB888;
+	params->dsi.PS = LCM_PACKED_PS_24BIT_RGB888;
+	params->dsi.vertical_sync_active = 4;
+	params->dsi.vertical_backporch = 30;
+	params->dsi.vertical_frontporch = 200;
+	params->dsi.vertical_active_line = 1612;
+	params->dsi.horizontal_sync_active = 2;
+	params->dsi.horizontal_backporch = 252;
+	params->dsi.horizontal_frontporch = 252;
+	params->dsi.horizontal_active_pixel = 720;
+	params->dsi.HS_TRAIL = 15;
+	params->dsi.PLL_CLOCK = 432;
+	params->dsi.ssc_disable = 1;
+	params->dsi.ssc_range = 4;
+	params->dsi.customization_esd_check_enable = 1;
+	params->dsi.esd_check_enable = 1;
+	params->dsi.lcm_esd_check_table[0].cmd = 0x0a;
+	params->dsi.lcm_esd_check_table[0].count = 1;
+	params->dsi.lcm_esd_check_table[0].para_list[0] = 0x9c;
+
+	params->physical_width = 67;
+	params->physical_height = 152;
+	params->physical_width_um = 67932;
+	params->physical_height_um = 152092;
+}
+
+static void bf7_init_power(void)
+{
+	bf7_program_bias();
+}
+
+/*
+ * Match the OEM panel-owned power-off sequence.  The first suspend after LK
+ * handed over an already initialised panel must still turn the rails off, so
+ * the state is deliberately initially false.  Touch reset is excluded: that
+ * pinctrl is not owned nor initialised by the display stack.
+ */
+static void bf7_suspend_power(void)
+{
+	if (bf7_panel_power_suspended)
+		return;
+
+	disp_dts_gpio_select_state(DTS_GPIO_STATE_LCM_RST_OUT0);
+	MDELAY(5);
+	disp_dts_gpio_select_state(DTS_GPIO_STATE_LCD_BIAS_ENN0);
+	MDELAY(5);
+	disp_dts_gpio_select_state(DTS_GPIO_STATE_LCD_BIAS_ENP0);
+	bf7_panel_power_suspended = true;
+}
+
+static void bf7_resume_power(void)
+{
+	if (!bf7_panel_power_suspended)
