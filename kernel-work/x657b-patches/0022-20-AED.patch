Content-Transfer-Encoding: 8bit

- mtk_battery.c: CHARGE_FULL_DESIGN = q_max/10 мА·ч, а q_max у нас уже в
  мА·ч (CHARGE_FULL берёт q_max*1000). Проектная ёмкость выходила 294 мА·ч
  при полной 2946: upower дважды в минуту ругался «energy_full больше
  energy_full_design», «здоровье» было 1000%. Теперь 12,8 Вт·ч = 12,8,
  100%, предупреждений 0.
- aed-main.c: hrtimer будил процессор раз в 20 с ради строки «UTC-время» —
  выключен; включить при загрузке: aee_aed.utc_sync_ms=20000.
- monitor_hang.c: отсчёт hang_detect на каждом витке — pr_debug.
- mtk_charger.c: charger_init удаться не может (нет primary_chg), после
  громких попыток — раз в полчаса вместо раза в минуту (было пробуждение и
  ~9 строк от pe4/pd/pd_hal каждую минуту).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/misc/mediatek/aee/aed/aed-main.c          | 13 ++++++++++---
 drivers/misc/mediatek/monitor_hang/monitor_hang.c |  3 ++-
 drivers/power/supply/mtk_battery.c                |  9 ++++++++-
 drivers/power/supply/mtk_charger.c                | 11 +++++++++--
 4 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/drivers/misc/mediatek/aee/aed/aed-main.c b/drivers/misc/mediatek/aee/aed/aed-main.c
index e025fdb54..0f04c4906 100644
--- a/drivers/misc/mediatek/aee/aed/aed-main.c
+++ b/drivers/misc/mediatek/aee/aed/aed-main.c
@@ -2782,7 +2782,13 @@ static struct miscdevice aed_ke_dev = {
 /* UTC time sync */
 static struct hrtimer aed_hrtimer;
 
-static u64 period_ms = 20 * 1000; /* 20 sec */
+/*
+ * BF7: таймер будил процессор раз в 20 с только ради строки «UTC-время
+ * такое-то» — вендору сверять время в журналах. У journald свои точные
+ * метки. По умолчанию выключен; включить при загрузке: aee_aed.utc_sync_ms=20000.
+ */
+static u64 period_ms;
+module_param_named(utc_sync_ms, period_ms, ullong, 0444);
 
 static enum hrtimer_restart aed_timer_fn(struct hrtimer *hrtimer)
 {
@@ -2814,8 +2820,9 @@ static void aed_hrtimer_init(void)
 {
 	hrtimer_init(&aed_hrtimer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
 	aed_hrtimer.function = aed_timer_fn;
-	hrtimer_start(&aed_hrtimer, ms_to_ktime(period_ms),
-		      HRTIMER_MODE_REL_PINNED);
+	if (period_ms)
+		hrtimer_start(&aed_hrtimer, ms_to_ktime(period_ms),
+			      HRTIMER_MODE_REL_PINNED);
 }
 
 static void aed_hrtimer_exit(void)
diff --git a/drivers/misc/mediatek/monitor_hang/monitor_hang.c b/drivers/misc/mediatek/monitor_hang/monitor_hang.c
index 8f4e14f6c..c4230c7cf 100644
--- a/drivers/misc/mediatek/monitor_hang/monitor_hang.c
+++ b/drivers/misc/mediatek/monitor_hang/monitor_hang.c
@@ -1950,7 +1950,8 @@ static int hang_detect_thread(void *arg)
 #endif
 
 	while (1) {
-		pr_info("[Hang_Detect] hang_detect thread counts down %d:%d, status %d.\n",
+		/* BF7: было pr_info — строка на каждый виток (раз в ~30 с). */
+		pr_debug("[Hang_Detect] hang_detect thread counts down %d:%d, status %d.\n",
 			hang_detect_counter, hd_timeout, hd_detect_enabled);
 #ifdef BOOT_UP_HANG
 		if (hd_detect_enabled)
diff --git a/drivers/power/supply/mtk_battery.c b/drivers/power/supply/mtk_battery.c
index 8e7076984..8dfd87846 100644
--- a/drivers/power/supply/mtk_battery.c
+++ b/drivers/power/supply/mtk_battery.c
@@ -354,9 +354,16 @@ static int battery_psy_get_property(struct power_supply *psy,
 			int q_max_mah = 0;
 			int q_max_uah = 0;
 
+			/*
+			 * BF7: было q_max / 10 — единица не та. q_max у нас в мА·ч
+			 * (2946), так его и берёт CHARGE_FULL выше (q_max * 1000).
+			 * Проектная ёмкость выходила 294 мА·ч, в десять раз меньше
+			 * полной: upower ругался «energy_full больше
+			 * energy_full_design», а «здоровье батареи» было 1000%.
+			 */
 			q_max_mah =
 				gm->fg_table_cust_data.fg_profile[
-				gm->battery_id].q_max / 10;
+				gm->battery_id].q_max;
 
 			q_max_uah = q_max_mah * 1000;
 			if (q_max_uah <= 100000) {
diff --git a/drivers/power/supply/mtk_charger.c b/drivers/power/supply/mtk_charger.c
index 49ff3bd0b..4579ce6bd 100644
--- a/drivers/power/supply/mtk_charger.c
+++ b/drivers/power/supply/mtk_charger.c
@@ -1614,9 +1614,16 @@ static int charger_routine_thread(void *arg)
 					bf7_popytok);
 				msleep(5000);
 			} else {
+				/*
+				 * BF7: удаться не может никогда — на плате нет
+				 * primary_chg, заряд ведёт вендорский демон. Раз в
+				 * минуту — это пробуждение и ~9 строк от алгоритмов
+				 * (pe4, pd, pd_hal) в журнал; раз в полчаса хватит на
+				 * случай, если чип всё же появится.
+				 */
 				if (bf7_popytok == BF7_POPYTOK_GROMKO + 1)
-					chr_err("charger_init не удаётся, дальше пробую молча раз в минуту\n");
-				msleep(60000);
+					chr_err("charger_init не удаётся, дальше пробую раз в полчаса\n");
+				msleep(30 * 60000);
 			}
 		}
 
