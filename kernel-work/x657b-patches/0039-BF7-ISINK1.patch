 drivers/misc/mediatek/leds/leds-mt6357.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/misc/mediatek/leds/leds-mt6357.c b/drivers/misc/mediatek/leds/leds-mt6357.c
index 6a081e738..180aaab16 100644
--- a/drivers/misc/mediatek/leds/leds-mt6357.c
+++ b/drivers/misc/mediatek/leds/leds-mt6357.c
@@ -1108,8 +1108,9 @@ static int mt6357_led_hw_on(struct led_classdev *cdev,
 /*
  * BF7: огонёк уведомлений на ISINK1 включён наоборот — горит при яркости 0 и
  * гаснет при любом включении ISINK1 (камера, 2026-09-23 и 2026-09-30). В покое
- * он светится постоянно, а мигание feedbackd не видно. С bf7_invert_isink1=1 в
- * железо уходит max − яркость: в покое тёмный, при уведомлении вспыхивает.
+ * он светится постоянно, а мигание feedbackd не видно. С bf7_invert_isink1=1
+ * огонёк горит, когда запрошено больше половины яркости: в покое тёмный, при
+ * уведомлении вспыхивает.
  * По умолчанию выключено, пока не подтверждено без кабеля. Включить:
  *   echo 1 > /sys/module/leds_mt6357/parameters/bf7_invert_isink1
  * (новое значение применяется со следующей записи яркости).
@@ -1125,8 +1126,15 @@ static void mt6357_led_set_brightness(struct led_classdev *cdev,
 	struct mt6357_leds *leds = led->parent;
 	int ret;
 
+	/*
+	 * Промежуточной яркости у огонька нет: он горит, только когда ISINK1
+	 * выключен совсем. Поэтому не max − b, а порог: запрошено больше
+	 * половины — ISINK1 выключен (огонёк горит), иначе включён. Плавная
+	 * «пульсация» feedbackd превращается в чёткие вспышки на пол-периода
+	 * (при max − b огонёк вспыхивал лишь на ~50 мс вершины).
+	 */
 	if (bf7_invert_isink1 && led->id == MT6357_ISINK1)
-		brightness = cdev->max_brightness - brightness;
+		brightness = brightness > cdev->max_brightness / 2 ? 0 : cdev->max_brightness;
 
 	mutex_lock(&leds->lock);
 
