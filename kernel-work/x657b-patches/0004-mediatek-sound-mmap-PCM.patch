diff --git a/sound/soc/mediatek/common_int/mtk-soc-pcm-bt-dai.c b/sound/soc/mediatek/common_int/mtk-soc-pcm-bt-dai.c
index 841a43794..a124ff349 100644
--- a/sound/soc/mediatek/common_int/mtk-soc-pcm-bt-dai.c
+++ b/sound/soc/mediatek/common_int/mtk-soc-pcm-bt-dai.c
@@ -463,6 +463,20 @@ static struct page *
 mtk_bt_dai_capture_pcm_page(struct snd_pcm_substream *substream,
 			    unsigned long offset)
 {
+	/*
+	 * BF7: dummy_page[] объявлен статически и нигде не инициализируется —
+	 * ни в этом файле, ни где-либо ещё в дереве. virt_to_page(NULL) даёт
+	 * мусорный указатель (0xffffffbf00000000 на этом ядре), и get_page()
+	 * по нему роняет ядро в snd_pcm_mmap_data_fault. Любое приложение,
+	 * отобразившее буфер PCM, перезагружало телефон.
+	 *
+	 * Возвращаем NULL: ядро ответит VM_FAULT_SIGBUS, и в худшем случае
+	 * умрёт приложение, а не система. Отображение всё равно отключено —
+	 * см. снятые флаги SNDRV_PCM_INFO_MMAP в этом файле.
+	 */
+	if (!dummy_page[substream->stream])
+		return NULL;
+
 	return virt_to_page(dummy_page[substream->stream]); /* the same page */
 }
 
