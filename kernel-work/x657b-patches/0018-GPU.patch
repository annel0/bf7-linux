Выбор встроенного DDK (MTK_GPU_RGX_BUILTIN) и правка ged sw-vsync —
давно в прошитых ядрах, но лежали в дереве незакоммиченными. Фиксирую,
чтобы дерево совпадало с тем, что на телефоне.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/mediatek/Kconfig                       | 11 +++++++++++
 drivers/gpu/mediatek/Makefile                      |  2 ++
 drivers/gpu/mediatek/ged/src/ged_notify_sw_vsync.c | 10 ++++++++++
 3 files changed, 23 insertions(+)

diff --git a/drivers/gpu/mediatek/Kconfig b/drivers/gpu/mediatek/Kconfig
index af5db7a38..5b903f82f 100644
--- a/drivers/gpu/mediatek/Kconfig
+++ b/drivers/gpu/mediatek/Kconfig
@@ -6,6 +6,17 @@ config MTK_GPU_SUPPORT
 	  The gpu driver would be built-in(y), as kernel module(m) or not supported(n)
 	  MTK_GPU_VERSION would define the target HW IP
 
+config MTK_GPU_RGX_BUILTIN
+	bool "Build the vendor PowerVR DDK into the kernel"
+	depends on MTK_GPU_SUPPORT
+	default y
+	help
+	  Builds the in-tree PowerVR kernel-mode driver (gpu_rgx). Turn this off
+	  to keep the MediaTek GPU support around it - hal, gpufreq and ged, whose
+	  exports the GPU power path needs - while supplying pvrsrvkm from an
+	  out-of-tree DDK instead. Two PowerVR drivers cannot coexist: they export
+	  the same symbols.
+
 config MTK_GPU_VERSION
 	string "Support MTK GPU Driver Version"
 	default ""
diff --git a/drivers/gpu/mediatek/Makefile b/drivers/gpu/mediatek/Makefile
index 8af7050fc..b050c1138 100644
--- a/drivers/gpu/mediatek/Makefile
+++ b/drivers/gpu/mediatek/Makefile
@@ -36,7 +36,9 @@ else ifeq ($(CONFIG_MACH_MT6781),y)
     $(info *direct build mali-r32p1 for CONFIG_MACH_MT6781)
     obj-y += gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/
 else ifneq ($(word 1,$(MTK_GPU_VERSION)),)
+ifeq ($(CONFIG_MTK_GPU_RGX_BUILTIN),y)
     obj-y += gpu_$(word 1,$(MTK_GPU_VERSION))/
+endif
 else
     obj-y += $(subst ",,$(CONFIG_MTK_PLATFORM))/
 endif
diff --git a/drivers/gpu/mediatek/ged/src/ged_notify_sw_vsync.c b/drivers/gpu/mediatek/ged/src/ged_notify_sw_vsync.c
index fab70db22..1a065daf3 100644
--- a/drivers/gpu/mediatek/ged/src/ged_notify_sw_vsync.c
+++ b/drivers/gpu/mediatek/ged/src/ged_notify_sw_vsync.c
@@ -493,6 +493,16 @@ void ged_sodi_stop(void)
 #if defined(CONFIG_MACH_MT8167) || defined(CONFIG_MACH_MT8173)\
 || defined(CONFIG_MACH_MT6739) || defined(CONFIG_MACH_MT6761)\
 || defined(CONFIG_MACH_MT6765)
+/*
+ * The PowerVR DDK provides MTKFWDump(); it is only a debug dump taken when the
+ * GPU looks stuck. A weak stub keeps GED linkable when the DDK is not built
+ * into the kernel (CONFIG_MTK_GPU_RGX_BUILTIN=n) - the DDK's own strong
+ * definition still wins whenever it is.
+ */
+void __weak MTKFWDump(void)
+{
+}
+
 static void ged_dump_fw_handle(struct work_struct *psWork)
 {
 	struct GED_DUMP_FW *psNotify
